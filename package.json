{
  "name": "polyweb",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-chrome-launcher.cjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint \"src/**/*.{js,ts,astro}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,astro}\" --fix",
    "check": "astro check",
    "readme:generate": "tsx readme-builder/readme-generate.ts",
    "db:check": "npx tsx src/database/commands/db.check.ts",
    "db:compare": "npx tsx src/database/commands/db.compare.ts",
    "db:generate": "npx tsx src/database/commands/db.generate.ts",
    "db:infra": "npx tsx src/database/commands/db.infra.ts",
    "db:migrate": "npx tsx src/database/commands/db.migrate.ts",
    "db:reset": "npx tsx src/database/commands/db.reset.ts",
    "db:seed": "npx tsx src/database/commands/db.seed.ts",
    "db:seed-media": "npx tsx src/database/commands/db.seed-media.ts",
    "db:sync": "npx tsx src/database/commands/db.sync.ts",
    "db:cleanup-audit": "npx tsx src/database/commands/db.cleanup-audit.ts",
    "smtp:check": "npx tsx src/smtp/commands/smtp.check.ts",
    "logs:rotate": "npx tsx src/smtp/commands/logs.rotate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "node tests/helpers/vitest-report.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "node tests/helpers/playwright-report.cjs",
    "qa:report": "node tests/helpers/qa-report.cjs",
    "a11y:setup": "tsx tests/a11y/setup.ts",
    "a11y:teardown": "tsx tests/a11y/setup.ts --teardown",
    "a11y:pa11y": "pa11y-ci --config .pa11yci.cjs",
    "a11y:lighthouse": "lhci autorun --config lighthouserc.cjs",
    "a11y:lighthouse:authed": "node tests/a11y/lhci-authed.cjs",
    "a11y:lighthouse:rename": "node tests/a11y/lhci-rename.cjs",
    "a11y:lighthouse:report": "node tests/a11y/lhci-report.cjs",
    "a11y:lighthouse:report:contrast": "node tests/a11y/lhci-report.cjs --contrast",
    "a11y:report": "node tests/helpers/lighthouse-report.cjs",
    "a11y": "node tests/a11y/run.cjs",
    "a11y:pa11y-only": "node tests/a11y/run.cjs --pa11y",
    "a11y:lighthouse-only": "node tests/a11y/run.cjs --lighthouse",
    "qa": "node scripts/qa.mjs full",
    "qa:offline": "node scripts/qa.mjs offline",
    "db:backfill-variants": "npx tsx src/database/commands/db.backfill-variants.ts",
    "module:new": "tsx scripts/new-module.ts",
    "api:generate": "tsx scripts/api-generator.ts",
    "db:wait": "npx tsx src/database/commands/db.wait.ts",
    "db:baseline": "npx tsx src/database/commands/db.baseline.ts",
    "admin:create": "npx tsx src/database/commands/db.create-admin.ts",
    "storage:push": "npx tsx src/database/commands/storage.push.ts",
    "build:vercel": "ASTRO_ADAPTER=vercel astro build",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts --project=chromium",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts --project=chromium",
    "search:reindex": "npx tsx src/database/commands/search.reindex.ts",
    "search:pagefind": "npx tsx src/database/commands/search.pagefind.ts",
    "db:backup": "npx tsx src/database/commands/db.backup.ts",
    "db:restore": "npx tsx src/database/commands/db.restore.ts",
    "cli:build": "tsc -p packages/create-polyweb/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/node": "11.1.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "^11.0.15",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@better-auth/passkey": "1.7.10",
    "@iconify-json/circle-flags": "^1.2.10",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/openmoji": "^1.2.29",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@sentry/node": "^11.8.0",
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "astro": "7.4.0",
    "astro-icon": "^1.2.0",
    "better-auth": "^1.7.10",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "easymde": "^2.21.0",
    "effect": "^4.0.5",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "isomorphic-dompurify": "^3.23.0",
    "motion": "^12.43.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "resend": "^6.33.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.12.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "pa11y-ci": "^4.1.1",
    "pagefind": "^1.5.2",
    "s3rver": "^3.7.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "pnpm": {
    "overrides": {
      "axe-core": "4.12.1",
      "@esbuild-kit/core-utils>esbuild": ">=0.25.0",
      "zod@^4": ">=4.6.6 <5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "description": "Polyweb — plateforme CMS Astro SSR modulaire (Drizzle/PostgreSQL, Better Auth, i18n fr/en/es/ar)"
}
