# ── Environnement DB ( LOCAL | PROD | TEST ) ─────────────────────────────────────────────────
DB_ENV=LOCAL

# ── URLs de connexion PostgreSQL ─────────────────────────────────────
DATABASE_URL_LOCAL=postgresql://user:password@localhost:5432/db_local
DATABASE_URL_PROD=postgresql://user:password@localhost:5432/db_prod
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/db_test

# ── Sécurité PROD ───────────────────────────────────────────────────
# Mettre "oui" pour autoriser les opérations sur PROD en CI/CD (sans prompt interactif)
# CONFIRM_PROD=oui

# ── Pool (optionnel) ────────────────────────────────────────────────
# Surcharge la taille max du pool (défaut : LOCAL=10, TEST=5, PROD=20)
# DB_POOL_MAX=10

# ── Authentification ( Better-Auth ) ───────────────────────────────
BETTER_AUTH_SECRET=replace-me-with-a-secure-random-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:4321

# ── Site URL (Astro) ────────────────────────────────────────────────
SITE_URL=http://localhost:4321
# Hôtes supplémentaires autorisés à alimenter Astro.url (security.allowedDomains), séparés par
# des virgules : domaines multi-site servis par cette instance. L'hôte de SITE_URL (et la boucle
# locale en dev/preview) est toujours inclus. Lu AU BUILD (astro.config.mjs).
# ALLOWED_HOSTS=site2.example.com,www.site2.example.com

# ── SMTP ( BREVO | RESEND | NODEMAILER ) ────────────────────────────
SMTP_PROVIDER=NODEMAILER
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Polyweb

# ── Nodemailer (SMTP générique) ──────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── Brevo (API v3) ──────────────────────────────────────────────────
# BREVO_API_KEY=xkeysib-...

# ── Resend ──────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...

# ── Test ────────────────────────────────────────────────────────────
# SMTP_TEST_TO=test@example.com

# ── LHCI ( Lighthouse CI ) ─────────────────────────────────────────────
# LHCI_GITHUB_APP_TOKEN=your-lhci-token-here

# ── Reverse Proxy ──────────────────────────────────────────────────
# Set to "true" ONLY when behind a trusted reverse proxy (nginx, Caddy, CloudFlare)
# that overwrites x-forwarded-for / x-real-ip headers. Required for IP-based
# rate limiting and audit trail on public endpoints (contact form, auth).
# TRUST_PROXY=true

# ── Health Check ───────────────────────────────────────────────────
# Shared secret to access GET /api/health. If unset, only non-proxied (loopback)
# requests are accepted (suitable for container probes). For external monitoring
# tools, set a strong random token and pass it as `Authorization: Bearer <token>`.
# HEALTH_TOKEN=replace-with-a-strong-random-token

# ── Contact Form ───────────────────────────────────────────────────
# Email address that receives contact form submissions (falls back to SMTP_FROM_EMAIL)
# CONTACT_EMAIL=contact@example.com
# ═════════════════════════ Polyweb — plateforme CMS ═════════════════════════
SITE_NAME=Polyweb
# Secret HMAC (aperçus signés, jetons de formulaires, chiffrement des secrets webhooks).
# Obligatoire en production (sinon BETTER_AUTH_SECRET est utilisé).
POLYWEB_SIGNING_SECRET=replace-me-with-another-secure-random-secret
# Secret des routes /api/cron/* (en-tête Authorization: Bearer …)
CRON_SECRET=replace-me
# POLYWEB_RELEASE=1.0.0

# ── Adaptateur Astro ( node | vercel ) ──────────────────────────────
ASTRO_ADAPTER=node

# ── Authentification avancée (brique h) ─────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PASSKEY_RP_ID=example.com
# AUTH_EMAIL_OTP_ENABLED=true

# ── Création du premier admin (pnpm admin:create) ───────────────────
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Admin
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password

# ── API REST v1 (brique c) ──────────────────────────────────────────
# API_CORS_ORIGINS=*
# API_RATE_LIMIT_TOKEN=600
# API_RATE_LIMIT_ANON=120

# ── Webhooks sortants (brique d) ────────────────────────────────────
# WEBHOOKS_ALLOW_PRIVATE_URLS=false
# WEBHOOKS_TIMEOUT_MS=10000
# WEBHOOKS_MAX_ATTEMPTS=8

# ── Stockage des médias (brique e) : local | s3 | r2 ────────────────
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=https://<compte>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.example.com
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=
# S3_TIMEOUT_MS=30000

# ── Formulaires (brique g) ──────────────────────────────────────────
# FORM_RATE_LIMIT=5

# ── Plugins (brique i) ──────────────────────────────────────────────
# PLUGINS_SYNC_INTERVAL_MS=30000
# PLUGINS_HANDLER_TIMEOUT_MS=15000

# ── Recherche (brique k) : postgres | meilisearch | pagefind ────────
SEARCH_DRIVER=postgres
# SEARCH_AUTO_INDEX=true
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_API_KEY=
# MEILISEARCH_INDEX=polyweb
# SEARCH_TIMEOUT_MS=5000

# ── Observabilité (brique l) ────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=polyweb
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_SAMPLE_RATE=1

# ── Sauvegardes (brique m) ──────────────────────────────────────────
# BACKUP_DIR=backups
# BACKUP_KEEP=7

# ── Paiements (module optionnel) ────────────────────────────────────
PAYMENTS_ENABLED=false
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYMENTS_ALLOW_MOCK=false
# PAYMENTS_MOCK_SECRET=

# ── Divers ──────────────────────────────────────────────────────────
# AUDIT_RETENTION_DAYS=365
# LOGS_RETENTION_DAYS=30
# DATABASE_CA_CERT=
