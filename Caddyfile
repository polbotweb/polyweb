# Reverse proxy HTTPS automatique (repris de les-rochers-blancs).
# APP_DOMAIN=example.com → certificat Let's Encrypt automatique ; défaut : localhost.
{$APP_DOMAIN:localhost} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Fichiers uploadés servis directement (driver de stockage local)
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy app:4321
}
