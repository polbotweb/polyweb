---
/**
 * Page de détail du domaine subscriptions.
 *
 * La DTO arrive par props : la page a fait appel au loader. Ce composant se
 * contente de composer les atomes de `molecules/`.
 */
import type { SubscriptionsDTO } from "@/modules/subscriptions/loaders/subscription.loader";
import SubscriptionsCard from "@/components/subscriptions/SubscriptionsCard.astro";

interface Props {
  item: SubscriptionsDTO;
}

const { item } = Astro.props as Props;
---

<section class="flex flex-col gap-6">
  <SubscriptionsCard id={item.id} title={item.id} href="#" />
</section>

<script>
  import { initSubscriptions } from "@/modules/subscriptions/client/init";

  initSubscriptions();
  document.addEventListener("astro:after-swap", initSubscriptions);
</script>
