---
import { Alert, AlertDescription } from "@atoms/alert";
import type { ClassifiedsTranslations } from "@/modules/classifieds/i18n";
interface Props { t: ClassifiedsTranslations; url: URL }
const { t, url } = Astro.props;
const notice = url.searchParams.get("notice");
const error = url.searchParams.get("error");
const noticeText = notice ? t.notices[notice] : undefined;
const errorText = error ? (t.errors[error] ?? t.errors.default) : undefined;
---
{noticeText && (
  <Alert variant="primary" data-testid="classifieds-notice">
    <AlertDescription>{noticeText}</AlertDescription>
  </Alert>
)}
{errorText && (
  <Alert variant="error" data-testid="classifieds-error">
    <AlertDescription>{errorText}</AlertDescription>
  </Alert>
)}
