---
import Button from "@atoms/button/Button.astro";
import type { ClassifiedsTranslations } from "@/modules/classifieds/i18n";
import type { Locale } from "@i18n/config";
interface Props { t: ClassifiedsTranslations; locale: Locale; active: "settings" | "categories" | "attributes" | "ads" }
const { t, locale, active } = Astro.props;
const items = [
  { id: "settings" as const, href: `/${locale}/admin/classifieds`, label: t.admin.settings },
  { id: "categories" as const, href: `/${locale}/admin/classifieds/categories`, label: t.admin.categories },
  { id: "attributes" as const, href: `/${locale}/admin/classifieds/attributes`, label: t.admin.attributesPage },
  { id: "ads" as const, href: `/${locale}/admin/classifieds/ads`, label: t.admin.ads },
];
---
<nav class="flex flex-wrap gap-2" aria-label={t.admin.title}>
  {items.map((item) => (
    <Button href={item.href} variant={active === item.id ? "default" : "outline"} size="sm" aria-current={active === item.id ? "page" : undefined}>{item.label}</Button>
  ))}
</nav>
