---
/**
 * MarkdownEditor — éditeur Markdown EasyMDE (repris de concordia).
 * Enveloppe un <textarea> et initialise EasyMDE côté client :
 *   - barre d'outils (gras, italique, titres, listes, liens, images, code, citation, tableau, aperçu, plein écran)
 *   - insertion d'image via le MediaPicker partagé (`pickerId`) ou upload direct /api/upload
 *   - icônes SVG inline (aucun CDN Font Awesome — compatible CSP)
 *
 * Usage :
 *   <MarkdownEditor id="body-fr" name="body" value={md} pickerId="media-picker" />
 */
export interface Props {
  id: string;
  name: string;
  value?: string;
  placeholder?: string;
  rows?: number;
  /** Mode minimal : moins de boutons (champs courts) */
  minimal?: boolean;
  /** Id d'un <MediaPicker> présent sur la page pour l'insertion d'images */
  pickerId?: string;
}

const { id, name, value = "", placeholder = "", rows = 16, minimal = false, pickerId } = Astro.props;
---

<div class="md-editor-wrapper" data-md-editor={id} data-md-minimal={minimal ? "true" : "false"} data-md-picker={pickerId}>
  <textarea id={id} name={name} rows={rows} placeholder={placeholder} class="md-editor-textarea">{value}</textarea>
</div>

<script>
  import { initMarkdownEditors } from "@/lib/admin/markdown-editor";
  initMarkdownEditors();
  document.addEventListener("astro:after-swap", () => initMarkdownEditors());
</script>

<style is:global>
  /* ============================================================
     EasyMDE — INTEGRAL design system overrides
     All toolbar icons replaced with inline SVG (no Font Awesome CDN)
     ============================================================ */

  .md-editor-wrapper { position: relative; }

  .md-editor-textarea {
    width: 100%; min-height: 200px; padding: 0.75rem;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: var(--radius, 0.375rem);
    font-family: var(--font-mono, "JetBrains Mono", monospace);
    font-size: 0.875rem; line-height: 1.7; resize: vertical;
    background: var(--background, #fff); color: var(--foreground, #1e293b);
  }

  /* Container */
  .EasyMDEContainer {
    border: 1px solid var(--border, #e2e8f0) !important;
    border-radius: var(--radius, 0.375rem) !important;
    overflow: hidden;
  }
  .EasyMDEContainer .CodeMirror {
    font-family: var(--font-mono, "JetBrains Mono", monospace) !important;
    font-size: 0.875rem !important; line-height: 1.7 !important;
    border: none !important; border-radius: 0 !important;
    background: var(--background, #fff) !important;
    color: var(--foreground, #1e293b) !important;
    min-height: 250px; padding: 0.5rem;
  }
  .EasyMDEContainer .CodeMirror-scroll { min-height: 250px; }

  /* Toolbar base */
  .EasyMDEContainer .editor-toolbar {
    border: none !important;
    border-bottom: 1px solid var(--border, #e2e8f0) !important;
    background: var(--muted, #f8fafc) !important;
    padding: 0.375rem 0.5rem !important;
    border-radius: 0 !important; opacity: 1 !important;
  }
  .EasyMDEContainer .editor-toolbar::before,
  .EasyMDEContainer .editor-toolbar::after { display: none !important; }

  .EasyMDEContainer .editor-toolbar button {
    border: none !important;
    border-radius: var(--radius, 0.25rem) !important;
    width: 2rem; height: 2rem; margin: 0 1px;
    display: inline-flex; align-items: center; justify-content: center;
    transition: all 0.15s; background: transparent;
    color: transparent !important; /* hide FA text fallback */
  }
  .EasyMDEContainer .editor-toolbar button:hover {
    background: var(--accent, #f1f5f9) !important;
  }
  .EasyMDEContainer .editor-toolbar button.active {
    background: var(--primary, #eab308) !important;
  }
  .EasyMDEContainer .editor-toolbar i.separator {
    border-left-color: var(--border, #e2e8f0) !important;
    margin: 0 6px !important;
  }

  /* ---- SVG icon injection via mask-image ---- */
  .EasyMDEContainer .editor-toolbar button::before {
    content: "";
    display: block; width: 1.125rem; height: 1.125rem;
    background-color: var(--muted-foreground, #64748b);
    -webkit-mask-size: contain; mask-size: contain;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: center; mask-position: center;
  }
  .EasyMDEContainer .editor-toolbar button:hover::before {
    background-color: var(--foreground, #0f172a);
  }
  .EasyMDEContainer .editor-toolbar button.active::before {
    background-color: var(--primary-foreground, #0f172a);
  }

  /* Hide FA <i> icons completely */
  .EasyMDEContainer .editor-toolbar button i.fa,
  .EasyMDEContainer .editor-toolbar button i.fas,
  .EasyMDEContainer .editor-toolbar button i.far {
    display: none !important;
  }

