---
/**
 * JsonLd — émet un ou plusieurs blocs application/ld+json (repris de les-rochers-blancs).
 * Contrairement à l'original, la sortie passe par safeJsonLd() (neutralise </script>).
 */
import { safeJsonLd } from "@/lib/sanitize";

interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}
const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---
{/* eslint-disable-next-line astro/no-set-html-directive -- pre-escaped via safeJsonLd() */}
{items.map((item) => <script type="application/ld+json" set:html={safeJsonLd(JSON.stringify(item))} />)}
