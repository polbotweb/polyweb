---
/** Saisie d'un mouvement manuel (entrée / sortie / ajustement) et d'un transfert entre entrepôts. Soumission : `modules/logistics/client/forms.ts`. */
import { Button } from "@atoms/button";
import { Input } from "@atoms/input";
import { Label } from "@atoms/label";
import { NativeSelect, NativeSelectOption } from "@atoms/native-select";
import type { Locale } from "@i18n/config";
import { MANUAL_MOVEMENT_KINDS } from "@/modules/logistics/domain/stock";
import { getLogisticsTranslations } from "@/modules/logistics/i18n";

interface Props {
  locale: Locale;
  organizationId?: string | null;
  warehouses: readonly { id: string; code: string; name: string }[];
  items: readonly { sku: string; name: string }[];
}
const { locale, organizationId = null, warehouses, items } = Astro.props as Props;
const t = getLogisticsTranslations(locale);
const warehouseOptions = warehouses.map((w) => ({ value: w.id, label: `${w.code} — ${w.name}` }));
---
<div class="grid gap-6 lg:grid-cols-2">
  <form class="flex flex-col gap-3 rounded-md border p-4" data-logistics-form="movement" data-organization-id={organizationId ?? ""} data-done={t.admin.saved} aria-labelledby="lg-mv-heading" novalidate>
    <h2 id="lg-mv-heading" class="text-lg font-semibold">{t.admin.record}</h2>
    <div class="grid gap-2"><Label for="lg-mv-warehouse">{t.fields.warehouse}</Label><NativeSelect id="lg-mv-warehouse" name="warehouseId">{warehouseOptions.map((o) => <NativeSelectOption value={o.value}>{o.label}</NativeSelectOption>)}</NativeSelect></div>
    <div class="grid gap-2"><Label for="lg-mv-sku">{t.fields.sku}</Label><NativeSelect id="lg-mv-sku" name="sku">{items.map((i) => <NativeSelectOption value={i.sku}>{i.sku} — {i.name}</NativeSelectOption>)}</NativeSelect></div>
    <div class="grid gap-2"><Label for="lg-mv-kind">{t.fields.kind}</Label><NativeSelect id="lg-mv-kind" name="kind">{MANUAL_MOVEMENT_KINDS.map((k) => <NativeSelectOption value={k}>{t.movementKinds[k]}</NativeSelectOption>)}</NativeSelect></div>
    <div class="grid gap-2"><Label for="lg-mv-qty">{t.fields.quantity}</Label><Input id="lg-mv-qty" name="quantity" type="number" required /></div>
    <div class="grid gap-2"><Label for="lg-mv-ref">{t.fields.reference}</Label><Input id="lg-mv-ref" name="reference" maxlength={200} /></div>
    <p class="text-sm text-destructive" role="alert" tabindex="-1" data-form-error hidden></p>
    <div><Button type="submit" data-testid="logistics-record">{t.admin.record}</Button></div>
  </form>

  <form class="flex flex-col gap-3 rounded-md border p-4" data-logistics-form="transfer" data-organization-id={organizationId ?? ""} data-done={t.admin.saved} aria-labelledby="lg-tr-heading" novalidate>
    <h2 id="lg-tr-heading" class="text-lg font-semibold">{t.admin.transfer}</h2>
    <div class="grid gap-2"><Label for="lg-tr-from">{t.fields.fromWarehouse}</Label><NativeSelect id="lg-tr-from" name="fromWarehouseId">{warehouseOptions.map((o) => <NativeSelectOption value={o.value}>{o.label}</NativeSelectOption>)}</NativeSelect></div>
    <div class="grid gap-2"><Label for="lg-tr-to">{t.fields.toWarehouse}</Label><NativeSelect id="lg-tr-to" name="toWarehouseId">{warehouseOptions.map((o, index) => <NativeSelectOption value={o.value} selected={index === 1}>{o.label}</NativeSelectOption>)}</NativeSelect></div>
    <div class="grid gap-2"><Label for="lg-tr-sku">{t.fields.sku}</Label><NativeSelect id="lg-tr-sku" name="sku">{items.map((i) => <NativeSelectOption value={i.sku}>{i.sku} — {i.name}</NativeSelectOption>)}</NativeSelect></div>
    <div class="grid gap-2"><Label for="lg-tr-qty">{t.fields.quantity}</Label><Input id="lg-tr-qty" name="quantity" type="number" min={1} required /></div>
    <div class="grid gap-2"><Label for="lg-tr-ref">{t.fields.reference}</Label><Input id="lg-tr-ref" name="reference" maxlength={200} /></div>
    <p class="text-sm text-destructive" role="alert" tabindex="-1" data-form-error hidden></p>
    <div><Button type="submit" data-testid="logistics-transfer">{t.admin.transfer}</Button></div>
  </form>
</div>

<script>
  import { initLogistics } from "@/modules/logistics/client/init";

  initLogistics();
  document.addEventListener("astro:after-swap", initLogistics);
</script>
