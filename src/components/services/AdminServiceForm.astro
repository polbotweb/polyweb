---
import AdminFormShell from "@organisms/AdminFormShell.astro";
import { Input } from "@atoms/input";
import { Textarea } from "@atoms/textarea";
import { Label } from "@atoms/label";
import { Checkbox } from "@atoms/checkbox";
import Button from "@atoms/button/Button.astro";
import MediaPicker from "@atoms/media-picker/MediaPicker.astro";
import ContentEditor from "@components/content/ContentEditor.astro";
import type { Locale } from "@i18n/config";
import type { ServiceDetail } from "@/modules/services/domain";
import { getServiceTranslations, getServiceErrorMessage } from "@/modules/services/i18n";
import { getServiceFormTranslations } from "@/modules/services/i18n/form";
import { getServiceCategories, getServiceTags } from "@/modules/services/loaders";

const props = Astro.props as { locale: Locale; service?: ServiceDetail | null; organizationId?: string | null; baseAdminUrl?: string; canCreate?: boolean; canUpdate?: boolean; canPublish?: boolean; canDelete?: boolean };
const { locale, service = null, organizationId = null, baseAdminUrl = `/${locale}/admin/services`, canCreate = true, canUpdate = true, canPublish = true, canDelete = false } = props;
const t = getServiceTranslations(locale);
const ft = getServiceFormTranslations(locale);
const translation = service?.translation;
const [categoryRows, tagRows] = await Promise.all([getServiceCategories(locale, organizationId), getServiceTags(locale, organizationId)]);
const selectedCategoryIds = new Set(service?.categories.map((x) => x.id) ?? []);
const selectedTagIds = new Set(service?.tags.map((x) => x.id) ?? []);
const actionLabels = JSON.stringify({ confirmDelete: t.admin.confirmDelete, confirmArchive: t.admin.confirmArchive, saved: t.admin.saved });
---
<AdminFormShell formSelector="form[data-service-form]" title={service ? t.admin.editService : t.admin.newService}>
  <div data-service-root data-service-id={service?.service.id ?? ""} data-organization-id={organizationId ?? ""} data-base-admin-url={baseAdminUrl} data-locale={locale} data-action-labels={actionLabels} data-lock-locked={ft.states.locked} data-lock-unlocked={ft.states.unlocked} data-restore-label={ft.actions.restore}>
    {service && <section class="mb-6 space-y-3 rounded-xl border p-4"><div><p class="text-sm text-muted-foreground">{t.admin.fields.publication}</p><p class="font-semibold">{t.admin.status[service.service.status]}</p></div><div class="flex flex-wrap gap-2">
      {canPublish && service.service.status === "DRAFT" && <Button type="button" data-lifecycle="publish">{ft.actions.publish}</Button>}
      {canPublish && service.service.status === "PUBLISHED" && <Button type="button" variant="outline" data-lifecycle="unpublish">{ft.actions.unpublish}</Button>}
      {canUpdate && service.service.status !== "ARCHIVED" && service.service.status !== "DELETED" && <Button type="button" variant="outline" data-lifecycle="archive">{ft.actions.archive}</Button>}
      {canUpdate && (service.service.status === "ARCHIVED" || service.service.status === "DELETED") && <Button type="button" data-lifecycle="restore">{ft.actions.restore}</Button>}
      {canCreate && service.service.status !== "DELETED" && <Button type="button" variant="outline" data-lifecycle="duplicate">{ft.actions.duplicate}</Button>}
      {canDelete && service.service.status !== "DELETED" && <Button type="button" variant="outline" data-lifecycle="delete">{ft.actions.delete}</Button>}
    </div></section>}

    <form data-service-form data-mode={service ? "edit" : "create"} class="space-y-8" autocomplete="off">
      <input type="hidden" name="organizationId" value={organizationId ?? ""} />
      <input type="hidden" name="locale" value={locale} />
      {service && <input type="hidden" name="id" value={service.service.id} />}
      <input type="hidden" name="coverImageId" value={service?.service.coverImageId ?? ""} />
      <input type="hidden" name="ogImageId" value={translation?.ogImageId ?? ""} />

      <section class="space-y-4 rounded-xl border p-5"><h2 class="text-xl font-semibold">{ft.sections.content}</h2>
        <div class="grid gap-4 md:grid-cols-2"><div><Label for="service-title">{t.admin.fields.title}</Label><Input id="service-title" name="title" required value={translation?.title ?? ""} /></div><div><Label for="service-slug">{t.admin.fields.slug}</Label><div class="flex gap-2"><Input id="service-slug" name="slug" required value={translation?.slug ?? ""} /><Button type="button" variant="outline" data-regenerate-slug aria-label={ft.actions.regenerateSlug}>{ft.actions.regenerateSlug}</Button></div></div></div>
        <div><Label for="service-excerpt">{t.admin.fields.excerpt}</Label><Textarea id="service-excerpt" name="excerpt" rows={3} defaultValue={translation?.excerpt ?? ""} /></div>
        <ContentEditor name="content" value={translation?.content ?? ""} locale={locale} organizationId={organizationId} resolverName="services" label={t.admin.fields.content} required rows={18} />
      </section>

      <section class="space-y-4 rounded-xl border p-5"><h2 class="text-xl font-semibold">{ft.sections.pricing}</h2><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><div><Label for="service-price">{t.admin.fields.price}</Label><Input id="service-price" name="priceMinor" type="number" min="0" step="1" value={service?.service.priceMinor ?? ""} /></div><div><Label for="service-currency">{t.admin.fields.currency}</Label><Input id="service-currency" name="currency" maxlength="3" value={service?.service.currency ?? "EUR"} /></div><div><Label for="service-duration">{t.admin.fields.duration}</Label><Input id="service-duration" name="durationMinutes" type="number" min="1" value={service?.service.durationMinutes ?? ""} /></div><div><Label for="service-capacity">{t.admin.fields.maxParticipants}</Label><Input id="service-capacity" name="maxParticipants" type="number" min="1" value={service?.service.maxParticipants ?? ""} /></div></div></section>

      <section class="space-y-4 rounded-xl border p-5"><h2 class="text-xl font-semibold">{ft.sections.taxonomy}</h2><div class="flex flex-wrap gap-6"><Checkbox name="isMobile" label={t.admin.fields.mobile} checked={service?.service.isMobile ?? false} /><Checkbox name="isFeatured" label={t.admin.fields.featured} checked={service?.service.isFeatured ?? false} /></div>
        <div class="space-y-2"><div class="flex flex-wrap items-center justify-between gap-2"><Label for="service-category-search">{t.admin.fields.categories}</Label><Input id="service-category-search" data-taxonomy-search="category" class="max-w-xs" placeholder={t.labels.search} aria-label={t.labels.search} /></div><div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3" data-taxonomy-list="category">{categoryRows.map(({ category, translation: tr }) => <label class="flex items-center gap-2" data-taxonomy-option={tr?.name ?? category.slug}><Checkbox name="categoryIds" value={category.id} checked={selectedCategoryIds.has(category.id)} /><span>{tr?.name ?? category.slug}</span></label>)}</div></div>
        <div class="space-y-2"><div class="flex flex-wrap items-center justify-between gap-2"><Label for="service-tag-search">{t.admin.fields.tags}</Label><Input id="service-tag-search" data-taxonomy-search="tag" class="max-w-xs" placeholder={t.labels.search} aria-label={t.labels.search} /></div><div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3" data-taxonomy-list="tag">{tagRows.map(({ tag, translation: tr }) => <label class="flex items-center gap-2" data-taxonomy-option={tr?.name ?? tag.slug}><Checkbox name="tagIds" value={tag.id} checked={selectedTagIds.has(tag.id)} /><span>{tr?.name ?? tag.slug}</span></label>)}</div></div>
      </section>

      <section class="space-y-4 rounded-xl border p-5"><h2 class="text-xl font-semibold">{ft.sections.media}</h2><div class="grid gap-4 md:grid-cols-2"><div><div class="mb-2 flex items-center justify-between"><Label>{t.admin.fields.coverImage}</Label><Button type="button" variant="outline" data-media-picker-trigger="cover">{ft.actions.choose}</Button></div><Input id="service-cover-preview" value={service?.service.coverImageId ?? ""} readonly aria-label={t.admin.fields.coverImage} /><MediaPicker id="service-cover-picker" locale={locale} organizationId={organizationId} /></div><div><div class="mb-2 flex items-center justify-between"><Label>{ft.fields.ogImage}</Label><Button type="button" variant="outline" data-media-picker-trigger="og">{ft.actions.choose}</Button></div><Input id="service-og-preview" value={translation?.ogImageId ?? ""} readonly aria-label={ft.fields.ogImage} /><MediaPicker id="service-og-picker" locale={locale} organizationId={organizationId} /></div></div>{service ? <><div class="flex items-center justify-between"><h3 class="font-medium">{t.admin.fields.media}</h3><Button type="button" variant="outline" data-media-picker-trigger="gallery">{ft.actions.add}</Button></div><MediaPicker id="service-gallery-picker" locale={locale} organizationId={organizationId} /><div class="space-y-2">{service.media.length ? service.media.map((item) => <div class="grid gap-3 rounded-lg border p-3 sm:grid-cols-[1fr_1fr_auto]" data-media-item={item.mediaId}><Input data-alt value={item.altText} aria-label={ft.fields.alt} /><Input data-caption value={item.caption ?? ""} aria-label={ft.fields.caption} /><div class="flex gap-2"><Button type="button" variant="outline" data-update-media>{ft.actions.update}</Button><Button type="button" variant="outline" data-delete-media>{ft.actions.delete}</Button></div></div>) : <p class="text-sm text-muted-foreground">{ft.states.noMedia}</p>}</div></> : <p class="text-sm text-muted-foreground">{ft.states.notSaved}</p>}</section>

      <section class="space-y-4 rounded-xl border p-5"><h2 class="text-xl font-semibold">{ft.sections.availability}</h2>{service ? <><div class="space-y-2">{service.availability.length ? service.availability.map((slot) => <div class="grid gap-2 rounded-lg border p-3 sm:grid-cols-[1fr_1fr_1fr_1fr_auto_auto]" data-availability-item={slot.id}><Input data-day type="number" min="0" max="6" value={String(slot.dayOfWeek)} aria-label={ft.fields.day} /><Input data-start type="time" value={slot.startTime} aria-label={ft.fields.start} /><Input data-end type="time" value={slot.endTime} aria-label={ft.fields.end} /><Input data-timezone value={slot.timezone} aria-label={ft.fields.timeZone} /><Button type="button" variant="outline" data-update-availability>{ft.actions.update}</Button><Button type="button" variant="outline" data-delete-availability>{ft.actions.delete}</Button></div>) : <p class="text-sm text-muted-foreground">{ft.states.noAvailability}</p>}</div><div class="grid gap-2 sm:grid-cols-5"><Input data-new-day type="number" min="0" max="6" placeholder={ft.fields.day} aria-label={ft.fields.day} /><Input data-new-start type="time" aria-label={ft.fields.start} /><Input data-new-end type="time" aria-label={ft.fields.end} /><Input data-new-timezone value="UTC" aria-label={ft.fields.timeZone} /><Button type="button" data-add-availability>{ft.actions.add}</Button></div></> : <p class="text-sm text-muted-foreground">{ft.states.notSaved}</p>}</section>

      <section class="space-y-4 rounded-xl border p-5"><h2 class="text-xl font-semibold">{ft.sections.seo}</h2><div class="grid gap-4 md:grid-cols-2"><div><Label for="service-meta-title">{ft.fields.metaTitle}</Label><Input id="service-meta-title" name="metaTitle" value={translation?.metaTitle ?? ""} /></div><div><Label for="service-meta-keywords">{ft.fields.metaKeywords}</Label><Input id="service-meta-keywords" name="metaKeywords" value={translation?.metaKeywords ?? ""} /></div><div class="md:col-span-2"><Label for="service-meta-description">{ft.fields.metaDescription}</Label><Textarea id="service-meta-description" name="metaDescription" rows={3} defaultValue={translation?.metaDescription ?? ""} /></div><div><Label for="service-canonical">{ft.fields.canonicalUrl}</Label><Input id="service-canonical" name="canonicalUrl" type="url" value={translation?.canonicalUrl ?? ""} /></div><div><Label for="service-og-title">{ft.fields.ogTitle}</Label><Input id="service-og-title" name="ogTitle" value={translation?.ogTitle ?? ""} /></div><div class="md:col-span-2"><Label for="service-og-description">{ft.fields.ogDescription}</Label><Textarea id="service-og-description" name="ogDescription" rows={2} defaultValue={translation?.ogDescription ?? ""} /></div><div><Label for="service-focus-keyword">{t.admin.fields.focusKeyword}</Label><Input id="service-focus-keyword" name="focusKeyword" value={service?.seo?.focusKeyword ?? ""} /></div><div><Label for="service-location">{ft.fields.location}</Label><Input id="service-location" name="locationLabel" value={translation?.locationLabel ?? ""} /></div><div class="md:col-span-2"><Label for="service-address">{ft.fields.address}</Label><Input id="service-address" name="locationAddress" value={translation?.locationAddress ?? ""} /></div></div></section>

      {service && <section class="space-y-4 rounded-xl border p-5"><div class="flex items-center justify-between"><h2 class="text-xl font-semibold">{ft.sections.revisions}</h2><Button type="button" variant="outline" data-load-revisions>{ft.actions.refresh}</Button></div><div data-revisions class="space-y-2" aria-live="polite"><p class="text-sm text-muted-foreground">{ft.states.noRevisions}</p></div></section>}
      {service && <section class="space-y-4 rounded-xl border p-5"><h2 class="text-xl font-semibold">{ft.sections.lock}</h2><p data-lock-status class="text-sm text-muted-foreground">{ft.states.unlocked}</p>{canUpdate && <div class="flex gap-2"><Button type="button" variant="outline" data-lock="lock">{ft.actions.lock}</Button><Button type="button" variant="outline" data-lock="unlock">{ft.actions.unlock}</Button></div>}</section>}
      <div class="flex flex-wrap justify-end gap-3 border-t pt-5"><Button type="button" variant="outline" href={baseAdminUrl}>{t.admin.cancel}</Button>{canUpdate && <Button type="submit">{t.admin.save}</Button>}</div><p data-status class="text-sm" aria-live="polite" aria-atomic="true"></p>
    </form>
  </div>
</AdminFormShell>
<script>
  import { actions } from "astro:actions";
  import { slugify } from "@/core/content/text";
  import { getServiceErrorMessage } from "@/modules/services/i18n";
  for (const root of document.querySelectorAll<HTMLElement>("[data-service-root]")) {
    const form = root.querySelector<HTMLFormElement>("form[data-service-form]"); if (!form) continue;
    const serviceId = root.dataset.serviceId || null; const organizationId = root.dataset.organizationId || null; const locale = root.dataset.locale || "fr"; const labels = JSON.parse(root.dataset.actionLabels || "{}") as { confirmDelete: string; confirmArchive: string; saved: string }; const status = root.querySelector<HTMLElement>("[data-status]");
    const errorText = (result: { error?: { code?: string } }) => result.error ? getServiceErrorMessage(locale, result.error.code) : "";
    const selectedValues = (name: string) => Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((x) => x.value);
    const slugInput = form.querySelector<HTMLInputElement>('input[name="slug"]'); const titleInput = form.querySelector<HTMLInputElement>('input[name="title"]'); let slugManuallyEdited = Boolean(serviceId && slugInput?.value);
    titleInput?.addEventListener("input", () => { if (slugManuallyEdited || !slugInput) return; slugInput.value = slugify(titleInput.value); });
    slugInput?.addEventListener("input", () => { slugManuallyEdited = true; });
    root.querySelector<HTMLButtonElement>("[data-regenerate-slug]")?.addEventListener("click", () => { if (!slugInput || !titleInput) return; slugInput.value = slugify(titleInput.value); slugManuallyEdited = false; });
    root.querySelectorAll<HTMLInputElement>("[data-taxonomy-search]").forEach((input) => { input.addEventListener("input", () => { const target = input.dataset.taxonomySearch || ""; const query = input.value.trim().toLocaleLowerCase(locale); root.querySelectorAll<HTMLElement>(`[data-taxonomy-list="${target}"] [data-taxonomy-option]`).forEach((option) => { option.hidden = !option.dataset.taxonomyOption?.toLocaleLowerCase(locale).includes(query); }); }); });
    const readPayload = () => { const data = new FormData(form); return { organizationId, locale, title: String(data.get("title") || ""), slug: String(data.get("slug") || ""), excerpt: String(data.get("excerpt") || "") || null, content: String(data.get("content") || ""), coverImageId: String(data.get("coverImageId") || "") || null, ogImageId: String(data.get("ogImageId") || "") || null, priceMinor: data.get("priceMinor") ? Number(data.get("priceMinor")) : null, currency: String(data.get("currency") || "") || null, durationMinutes: data.get("durationMinutes") ? Number(data.get("durationMinutes")) : null, maxParticipants: data.get("maxParticipants") ? Number(data.get("maxParticipants")) : null, isMobile: form.querySelector<HTMLInputElement>('input[name="isMobile"]')?.checked ?? false, isFeatured: form.querySelector<HTMLInputElement>('input[name="isFeatured"]')?.checked ?? false, categoryIds: selectedValues("categoryIds"), tagIds: selectedValues("tagIds"), metaTitle: String(data.get("metaTitle") || "") || null, metaDescription: String(data.get("metaDescription") || "") || null, metaKeywords: String(data.get("metaKeywords") || "") || null, canonicalUrl: String(data.get("canonicalUrl") || "") || null, ogTitle: String(data.get("ogTitle") || "") || null, ogDescription: String(data.get("ogDescription") || "") || null, locationLabel: String(data.get("locationLabel") || "") || null, locationAddress: String(data.get("locationAddress") || "") || null, focusKeyword: String(data.get("focusKeyword") || "") || null }; };
    let saving = false;
    form.addEventListener("submit", async (event) => { event.preventDefault(); if (saving) return; saving = true; const payload = readPayload(); let result: { error?: { code?: string }; data?: { id?: string } }; try { result = serviceId ? await actions.updateService({ ...payload, id: serviceId }) : await actions.createService({ ...payload, status: "DRAFT", publishedAt: null }); } catch { result = { error: { code: "INTERNAL_SERVER_ERROR" } }; } saving = false; if (status) status.textContent = result.error ? errorText(result) : labels.saved; if (!result.error && result.data && "id" in result.data && !serviceId) window.location.href = `${root.dataset.baseAdminUrl}/${result.data.id}/edit`; });
    const lifecycle = async (action: string) => { if (!serviceId) return; if ((action === "delete" && !window.confirm(labels.confirmDelete)) || (action === "archive" && !window.confirm(labels.confirmArchive))) return; const result = action === "publish" ? await actions.publishService({ id: serviceId, organizationId }) : action === "unpublish" ? await actions.unpublishService({ id: serviceId, organizationId }) : action === "archive" ? await actions.archiveService({ id: serviceId, organizationId }) : action === "restore" ? await actions.restoreService({ id: serviceId, organizationId }) : action === "duplicate" ? await actions.duplicateService({ id: serviceId, organizationId }) : await actions.deleteService({ id: serviceId, organizationId }); if (status) status.textContent = result.error ? errorText(result) : labels.saved; if (!result.error && action === "duplicate" && result.data && "id" in result.data) window.location.href = `${root.dataset.baseAdminUrl}/${result.data.id}/edit`; else if (!result.error) window.location.reload(); };
    root.querySelectorAll<HTMLButtonElement>("[data-lifecycle]").forEach((button) => button.addEventListener("click", () => lifecycle(button.dataset.lifecycle || "")));
    const bindPicker = (pickerId: string, field: string, previewId: string) => document.getElementById(pickerId)?.addEventListener("media-select", (event) => { const detail = (event as CustomEvent).detail as { fileId?: string }; const hidden = form.querySelector<HTMLInputElement>(`input[name="${field}"]`); const preview = document.getElementById(previewId) as HTMLInputElement | null; if (hidden) hidden.value = detail.fileId || ""; if (preview) preview.value = detail.fileId || ""; });
    bindPicker("service-cover-picker", "coverImageId", "service-cover-preview"); bindPicker("service-og-picker", "ogImageId", "service-og-preview");
    root.querySelectorAll<HTMLButtonElement>("[data-media-picker-trigger]").forEach((button) => button.addEventListener("click", () => document.getElementById(button.dataset.mediaPickerTrigger === "cover" ? "service-cover-picker" : button.dataset.mediaPickerTrigger === "og" ? "service-og-picker" : "service-gallery-picker")?.dispatchEvent(new Event("open"))));
    document.getElementById("service-gallery-picker")?.addEventListener("media-select", async (event) => { if (!serviceId) return; const detail = (event as CustomEvent).detail as { fileId?: string; alt?: string }; if (!detail.fileId) return; const result = await actions.addServiceMedia({ serviceId, organizationId, mediaId: detail.fileId, kind: "GALLERY", altText: detail.alt || detail.fileId, caption: null, sortOrder: root.querySelectorAll("[data-media-item]").length }); if (status) status.textContent = result.error ? errorText(result) : labels.saved; if (!result.error) window.location.reload(); });
    root.querySelectorAll<HTMLElement>("[data-availability-item]").forEach((item) => { item.querySelector<HTMLButtonElement>("[data-update-availability]")?.addEventListener("click", async () => { const result = await actions.updateServiceAvailability({ id: item.dataset.availabilityItem || "", serviceId: serviceId || "", organizationId, dayOfWeek: Number((item.querySelector("[data-day]") as HTMLInputElement)?.value), startTime: (item.querySelector("[data-start]") as HTMLInputElement)?.value || "", endTime: (item.querySelector("[data-end]") as HTMLInputElement)?.value || "", timezone: (item.querySelector("[data-timezone]") as HTMLInputElement)?.value || "UTC" }); if (status) status.textContent = result.error ? errorText(result) : labels.saved; }); item.querySelector<HTMLButtonElement>("[data-delete-availability]")?.addEventListener("click", async () => { const result = await actions.deleteServiceAvailability({ id: item.dataset.availabilityItem || "", serviceId: serviceId || "", organizationId }); if (status) status.textContent = result.error ? errorText(result) : labels.saved; if (!result.error) window.location.reload(); }); });
    root.querySelector<HTMLButtonElement>("[data-add-availability]")?.addEventListener("click", async () => { if (!serviceId) return; const result = await actions.createServiceAvailability({ serviceId, organizationId, dayOfWeek: Number((root.querySelector("[data-new-day]") as HTMLInputElement)?.value), startTime: (root.querySelector("[data-new-start]") as HTMLInputElement)?.value || "", endTime: (root.querySelector("[data-new-end]") as HTMLInputElement)?.value || "", timezone: (root.querySelector("[data-new-timezone]") as HTMLInputElement)?.value || "UTC" }); if (status) status.textContent = result.error ? errorText(result) : labels.saved; if (!result.error) window.location.reload(); });
    root.querySelectorAll<HTMLElement>("[data-media-item]").forEach((item) => { const mediaId = item.dataset.mediaItem || ""; item.querySelector<HTMLButtonElement>("[data-delete-media]")?.addEventListener("click", async () => { if (!serviceId || !window.confirm(labels.confirmDelete)) return; const result = await actions.removeServiceMedia({ serviceId, organizationId, mediaId }); if (status) status.textContent = result.error ? errorText(result) : labels.saved; if (!result.error) window.location.reload(); }); item.querySelector<HTMLButtonElement>("[data-update-media]")?.addEventListener("click", async () => { if (!serviceId) return; const result = await actions.updateServiceMedia({ serviceId, organizationId, mediaId, kind: "GALLERY", altText: (item.querySelector("[data-alt]") as HTMLInputElement)?.value || "", caption: (item.querySelector("[data-caption]") as HTMLInputElement)?.value || null, sortOrder: Array.from(root.querySelectorAll<HTMLElement>("[data-media-item]")).indexOf(item) }); if (status) status.textContent = result.error ? errorText(result) : labels.saved; }); });
    root.querySelectorAll<HTMLButtonElement>("[data-lock]").forEach((button) => button.addEventListener("click", async () => { if (!serviceId) return; const result = button.dataset.lock === "lock" ? await actions.lockService({ id: serviceId, organizationId }) : await actions.unlockService({ id: serviceId, organizationId }); const lockStatus = root.querySelector<HTMLElement>("[data-lock-status]"); if (lockStatus) lockStatus.textContent = result.error ? errorText(result) : button.dataset.lock === "lock" ? root.dataset.lockLocked || "" : root.dataset.lockUnlocked || ""; }));
    if (serviceId) { const refreshLock = async () => { const result = await actions.lockService({ id: serviceId, organizationId }); const lockStatus = root.querySelector<HTMLElement>("[data-lock-status]"); if (lockStatus) lockStatus.textContent = result.error ? errorText(result) : root.dataset.lockLocked || ""; }; void refreshLock(); const handle = window.setInterval(refreshLock, 60_000); window.addEventListener("pagehide", () => { window.clearInterval(handle); void actions.unlockService({ id: serviceId, organizationId }); }, { once: true }); }
    root.querySelector<HTMLButtonElement>("[data-load-revisions]")?.addEventListener("click", async () => { if (!serviceId) return; const result = await actions.listServiceRevisions({ id: serviceId, organizationId }); const container = root.querySelector<HTMLElement>("[data-revisions]"); if (!container) return; if (result.error) { container.textContent = errorText(result); return; } container.innerHTML = (result.data || []).map((revision) => `<div class="flex items-center justify-between gap-3 rounded-lg border p-3"><div><p class="text-sm font-medium">${escapeHtml(revision.title)}</p><p class="text-xs text-muted-foreground">${escapeHtml(revision.locale)} · ${escapeHtml(revision.status)}</p></div><button type="button" class="rounded-md border px-3 py-1.5 text-sm" data-restore-revision="${escapeHtml(revision.id)}">${escapeHtml(root.dataset.restoreLabel || "")}</button></div>`).join(""); container.querySelectorAll<HTMLButtonElement>("[data-restore-revision]").forEach((button) => button.addEventListener("click", async () => { const restore = await actions.restoreServiceRevision({ revisionId: button.dataset.restoreRevision || "", serviceId, organizationId }); if (status) status.textContent = restore.error ? errorText(restore) : labels.saved; if (!restore.error) window.location.reload(); })); });
  }
  function escapeHtml(value: string) { return value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;"); }
</script>