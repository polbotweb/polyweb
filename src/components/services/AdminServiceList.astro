---
import AdminResourceList from "@organisms/AdminResourceList.astro";
import AdminResourceStats from "@molecules/AdminResourceStats.astro";
import Button from "@atoms/button/Button.astro";
import ServiceCard from "@/modules/services/components/cards/ServiceCard.astro";
import { toast } from "@atoms/toast";
import { getServiceTranslations, getServiceErrorMessage } from "@/modules/services/i18n";
import { getServiceEngagementTranslations } from "@/modules/services/i18n/engagement";
import { getServiceSortTranslations } from "@/modules/services/i18n/sort";
import { formatServicePrice } from "@/modules/services/utils";
import type { Locale } from "@i18n/config";
import type { ServiceListItem } from "@/modules/services/domain";

const { locale, items, total, published, draft, archived, deleted, featured, views, reviews, comments, page, totalPages, baseUrl, organizationId, canCreate, canUpdate, canPublish, canDelete, categoryOptions, tagOptions, providerOptions, localeOptions } = Astro.props as {
  locale: Locale; items: ServiceListItem[]; total: number; published: number; draft: number; archived: number; deleted: number; featured: number; views: number; reviews: number; comments: number; page: number; totalPages: number; baseUrl: string; organizationId: string | null;
  canCreate: boolean; canUpdate: boolean; canPublish: boolean; canDelete: boolean;
  categoryOptions: { category: { id: string; slug: string }; translation: { name: string } | null }[];
  tagOptions: { tag: { id: string; slug: string }; translation: { name: string } | null }[];
  providerOptions: { id: string; name: string | null }[];
  localeOptions: readonly string[];
};
const t = getServiceTranslations(locale);
const engagementT = getServiceEngagementTranslations(locale);
const sortT = getServiceSortTranslations(locale);
const p = Astro.url.searchParams;
function selected(name: string, value: string) { return p.get(name) === value; }
function pageHref(targetPage: number): string { const params = new URLSearchParams(Astro.url.searchParams); params.set("page", String(targetPage)); return `${baseUrl}?${params.toString()}`; }
function formatPublishedAt(value: Date | null): string { return value ? new Intl.DateTimeFormat(locale, { dateStyle: "medium" }).format(value) : "—"; }
const stats = [
  { label: t.labels.services, value: total }, { label: t.admin.status.PUBLISHED, value: published }, { label: t.admin.status.DRAFT, value: draft }, { label: t.admin.status.ARCHIVED, value: archived }, { label: t.admin.status.DELETED, value: deleted }, { label: t.labels.featured, value: featured }, { label: t.labels.views, value: views }, { label: t.labels.reviews, value: reviews }, { label: engagementT.commentTitle, value: comments },
] as const;
---
<div data-service-admin-root data-organization-id={organizationId ?? ""} data-confirm-delete={t.admin.confirmDelete} data-confirm-archive={t.admin.confirmArchive} data-action-error={t.admin.actionError} data-locale={locale}>
  <AdminResourceList resourceId="service">
    <div slot="header" class="flex w-full flex-wrap items-center justify-between gap-3"><div><h1 class="text-2xl font-semibold">{t.admin.title}</h1><p class="text-sm text-muted-foreground">{total} {t.labels.services.toLowerCase()}</p></div>{canCreate && <Button href={`${baseUrl}/new`}>{t.admin.newService}</Button>}</div>
    <div slot="filters" class="space-y-3">
      <form method="get" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7">
        <input class="h-10 rounded-md border bg-background px-3 text-sm xl:col-span-2" name="search" placeholder={t.labels.search} value={p.get("search") ?? ""} />
        <select class="h-10 rounded-md border bg-background px-3 text-sm" name="status"><option value="">{t.labels.allStatuses}</option>{["PUBLISHED","DRAFT","ARCHIVED","DELETED"].map((status) => <option value={status} selected={selected("status", status)}>{t.admin.status[status]}</option>)}</select>
        <select class="h-10 rounded-md border bg-background px-3 text-sm" name="categoryId"><option value="">{t.labels.allCategories}</option>{categoryOptions.map((option) => <option value={option.category.id} selected={selected("categoryId", option.category.id)}>{option.translation?.name ?? option.category.slug}</option>)}</select>
        <select class="h-10 rounded-md border bg-background px-3 text-sm" name="tagId"><option value="">{t.labels.allTags}</option>{tagOptions.map((option) => <option value={option.tag.id} selected={selected("tagId", option.tag.id)}>{option.translation?.name ?? option.tag.slug}</option>)}</select>
        <select class="h-10 rounded-md border bg-background px-3 text-sm" name="providerId"><option value="">{t.labels.allProviders}</option>{providerOptions.map((option) => <option value={option.id} selected={selected("providerId", option.id)}>{option.name ?? option.id}</option>)}</select>
        <select class="h-10 rounded-md border bg-background px-3 text-sm" name="locale"><option value="">{t.admin.fields.locale}</option>{localeOptions.map((itemLocale) => <option value={itemLocale} selected={selected("locale", itemLocale)}>{itemLocale.toUpperCase()}</option>)}</select>
        <label class="flex h-10 items-center gap-2 rounded-md border px-3 text-sm"><input type="checkbox" name="featured" value="true" checked={p.get("featured") === "true"} />{t.labels.featured}</label>
        <label class="flex h-10 items-center gap-2 rounded-md border px-3 text-sm"><input type="checkbox" name="mobile" value="true" checked={p.get("mobile") === "true"} />{t.labels.mobile}</label>
        <select class="h-10 rounded-md border bg-background px-3 text-sm" name="sortBy"><option value="updatedAt" selected={p.get("sortBy") === "updatedAt" || !p.get("sortBy")}>{`${sortT.label}: ${sortT.updatedAt}`}</option><option value="createdAt" selected={selected("sortBy", "createdAt")}>{sortT.createdAt}</option><option value="publishedAt" selected={selected("sortBy", "publishedAt")}>{sortT.publishedAt}</option><option value="title" selected={selected("sortBy", "title")}>{sortT.title}</option><option value="priceMinor" selected={selected("sortBy", "priceMinor")}>{sortT.priceMinor}</option><option value="ratingAverage100" selected={selected("sortBy", "ratingAverage100")}>{sortT.ratingAverage100}</option><option value="viewCount" selected={selected("sortBy", "viewCount")}>{sortT.viewCount}</option></select>
        <select class="h-10 rounded-md border bg-background px-3 text-sm" name="sortOrder"><option value="desc" selected={p.get("sortOrder") !== "asc"}>{t.labels.descending}</option><option value="asc" selected={p.get("sortOrder") === "asc"}>{t.labels.ascending}</option></select>
        <input type="hidden" name="page" value="1" />
        <Button type="submit" variant="outline">{t.labels.search}</Button>
      </form>
    </div>
    <div slot="content" class="space-y-6">
      <AdminResourceStats stats={stats} />
      <div class="hidden overflow-x-auto rounded-xl border lg:block"><table class="w-full min-w-[1380px] text-sm"><thead class="bg-muted/40"><tr><th class="p-3 text-left">{t.admin.fields.title}</th><th class="p-3 text-left">{t.labels.categories}</th><th class="p-3 text-left">{t.labels.provider}</th><th class="p-3 text-left">{t.admin.fields.publication}</th><th class="p-3 text-left">{t.admin.fields.price}</th><th class="p-3 text-left">{t.admin.fields.duration}</th><th class="p-3 text-left">{t.admin.fields.seo}</th><th class="p-3 text-left">{t.labels.views}</th><th class="p-3 text-left">{t.labels.featured}/{t.labels.mobile}</th><th class="p-3 text-right">{t.labels.actions}</th></tr></thead><tbody>{items.map((item) => <tr class="border-t align-top"><td class="p-3 font-medium"><a class="hover:underline" href={`${baseUrl}/${item.service.id}/edit`}>{item.translation?.title ?? item.service.slug}</a><div class="mt-1 text-xs text-muted-foreground">{t.admin.status[item.service.status]}</div></td><td class="p-3">{item.categories.map((category) => <span class="mr-1 inline-block rounded-full bg-muted px-2 py-0.5 text-xs">{category.name ?? category.slug}</span>)}</td><td class="p-3">{item.provider?.name ?? "—"}</td><td class="p-3">{formatPublishedAt(item.service.publishedAt)}</td><td class="p-3">{formatServicePrice(item.service.priceMinor, item.service.currency, locale) ?? "—"}</td><td class="p-3">{item.service.durationMinutes ?? "—"}</td><td class="p-3">{item.service.seoScore === null ? "—" : `${item.service.seoScore}/100`}</td><td class="p-3">{item.service.viewCount}</td><td class="p-3"><div class="flex flex-wrap gap-1">{item.service.isFeatured && <span aria-label={t.labels.featured} class="rounded-full bg-muted px-2 py-0.5 text-xs">{t.labels.featured}</span>}{item.service.isMobile && <span aria-label={t.labels.mobile} class="rounded-full bg-muted px-2 py-0.5 text-xs">{t.labels.mobile}</span>}</div></td><td class="p-3"><div class="flex flex-wrap justify-end gap-2">{canUpdate && <a href={`${baseUrl}/${item.service.id}/edit`} class="rounded-md border px-2.5 py-1.5 text-xs hover:bg-muted">{t.admin.editService}</a>}{item.service.status === "DRAFT" && canPublish && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="publish" data-id={item.service.id}>{t.admin.publish}</button>}{item.service.status === "PUBLISHED" && canPublish && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="unpublish" data-id={item.service.id}>{t.admin.unpublish}</button>}{(item.service.status === "ARCHIVED" || item.service.status === "DELETED") && canUpdate && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="restore" data-id={item.service.id}>{t.admin.restore}</button>}{item.service.status !== "ARCHIVED" && item.service.status !== "DELETED" && canUpdate && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="archive" data-id={item.service.id}>{t.admin.archive}</button>}{canCreate && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="duplicate" data-id={item.service.id}>{t.admin.duplicate}</button>}{canDelete && item.service.status !== "DELETED" && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs text-destructive" data-action="delete" data-id={item.service.id}>{t.admin.delete}</button>}</div></td></tr>)}</tbody></table></div>
      <div class="grid gap-4 lg:hidden">{items.map((item) => <div class="space-y-2"><ServiceCard item={item} locale={locale} variant="compact" /><div class="flex flex-wrap gap-2">{canUpdate && <a href={`${baseUrl}/${item.service.id}/edit`} class="rounded-md border px-2.5 py-1.5 text-xs">{t.admin.editService}</a>}{item.service.status === "DRAFT" && canPublish && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="publish" data-id={item.service.id}>{t.admin.publish}</button>}{item.service.status === "PUBLISHED" && canPublish && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="unpublish" data-id={item.service.id}>{t.admin.unpublish}</button>}{(item.service.status === "ARCHIVED" || item.service.status === "DELETED") && canUpdate && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="restore" data-id={item.service.id}>{t.admin.restore}</button>}{item.service.status !== "ARCHIVED" && item.service.status !== "DELETED" && canUpdate && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="archive" data-id={item.service.id}>{t.admin.archive}</button>}{canCreate && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="duplicate" data-id={item.service.id}>{t.admin.duplicate}</button>}{canDelete && item.service.status !== "DELETED" && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs text-destructive" data-action="delete" data-id={item.service.id}>{t.admin.delete}</button>}</div></div>)}</div>
    </div>
    <div slot="pagination" class="flex items-center justify-between"><span class="text-sm text-muted-foreground">{t.labels.page} {page} / {totalPages}</span><div class="flex gap-2">{page > 1 && <Button variant="outline" href={pageHref(page - 1)} aria-label={t.labels.previous}>{t.labels.previous}</Button>}{page < totalPages && <Button variant="outline" href={pageHref(page + 1)} aria-label={t.labels.next}>{t.labels.next}</Button>}</div></div>
  </AdminResourceList>
</div>
<script>
  import { actions } from "astro:actions";
  import { toast } from "@atoms/toast";
  import { getServiceErrorMessage } from "@/modules/services/i18n";
  for (const root of document.querySelectorAll<HTMLElement>("[data-service-admin-root]")) {
    const organizationId = root.dataset.organizationId || null; const confirmDelete = root.dataset.confirmDelete ?? ""; const confirmArchive = root.dataset.confirmArchive ?? ""; const actionError = root.dataset.actionError ?? ""; const locale = root.dataset.locale ?? "fr";
    async function runServiceAction(id: string, action: string) { switch (action) { case "publish": return actions.publishService({ id, organizationId }); case "unpublish": return actions.unpublishService({ id, organizationId }); case "archive": return actions.archiveService({ id, organizationId }); case "restore": return actions.restoreService({ id, organizationId }); case "delete": return actions.deleteService({ id, organizationId }); case "duplicate": return actions.duplicateService({ id, organizationId }); default: return null; } }
    root.querySelectorAll<HTMLButtonElement>(".service-row-action").forEach((button) => button.addEventListener("click", async () => { const action = button.dataset.action ?? ""; const id = button.dataset.id; if (!id) return; const destructive = action === "delete" || action === "archive"; if (destructive && !window.confirm(action === "delete" ? confirmDelete : confirmArchive)) return; button.disabled = true; try { const result = await runServiceAction(id, action); if (result?.error) { toast.error(getServiceErrorMessage(locale, result.error.code)); button.disabled = false; return; } window.location.reload(); } catch { button.disabled = false; toast.error(actionError); } }));
  }
</script>