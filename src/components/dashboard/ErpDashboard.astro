---
/**
 * Tableau de bord ERP : filtres (GET, sans JS), indicateurs clés, tableau par période, stock.
 * Tableaux accessibles (caption, en-têtes de ligne et de colonne) plutôt que graphiques.
 */
import type { Locale } from "@i18n/config";
import type { DashboardView } from "@/modules/dashboard/admin/view";
import { GRANULARITIES, MAX_LOW_STOCK_THRESHOLD, type Granularity } from "@/modules/dashboard/domain/period";
import { marginRateBp } from "@/modules/dashboard/domain/metrics";
import { MAX_STOCK_ITEMS } from "@/modules/dashboard/services/dashboard.service";
import { getDashboardTranslations } from "@/modules/dashboard/i18n";
import { fill } from "@/modules/shop/i18n/checkout";
import { formatMinor } from "@/modules/shop/public/format";
import { Button } from "@atoms/button";
import { Input } from "@atoms/input";
import { Label } from "@atoms/label";
import { NativeSelect, NativeSelectOption } from "@atoms/native-select";
import { ScrollRegion } from "@molecules/ScrollRegion";

interface Props { locale: Locale; baseUrl: string; view: DashboardView }
const { locale, baseUrl, view } = Astro.props;
const { filters, errors, data } = view;
const t = getDashboardTranslations(locale);
const money = (minor: number) => formatMinor(minor, filters.currency, locale);
const percent = new Intl.NumberFormat(locale, { style: "percent", maximumFractionDigits: 1 });
const integer = new Intl.NumberFormat(locale);
const rate = (margin: number, net: number) => {
  const bp = marginRateBp(margin, net);
  return bp === null ? t.noRate : fill(t.rate, { rate: percent.format(bp / 10_000) });
};
const monthFormat = new Intl.DateTimeFormat(locale, { month: "long", year: "numeric", timeZone: "UTC" });
const periodLabel = (bucket: string, g: Granularity) => {
  const y = bucket.slice(0, 4);
  if (g === "year") return y;
  if (g === "quarter") return fill(t.quarter, { q: Math.floor((Number(bucket.slice(5, 7)) - 1) / 3) + 1, y });
  return monthFormat.format(new Date(`${bucket}T00:00:00Z`));
};
const errorId = (e: string) => `dash-error-${e}`;
const dateError = errors.includes("invalidDate") || errors.includes("invalidRange");
const num = "p-2 text-end tabular-nums";
---
<form method="get" class="grid gap-4 rounded-lg border-2 border-border p-4 sm:grid-cols-2 lg:grid-cols-[repeat(5,minmax(0,1fr))_auto]" aria-labelledby="dash-filters" data-testid="dashboard-filters">
  <h2 id="dash-filters" class="sr-only">{t.filters}</h2>
  <div class="grid gap-1">
    <Label for="df-from">{t.from}</Label>
    <Input id="df-from" name="from" type="date" required value={filters.from} aria-invalid={dateError ? "true" : undefined} aria-describedby={dateError ? "dash-errors" : undefined} />
  </div>
  <div class="grid gap-1">
    <Label for="df-to">{t.to}</Label>
    <Input id="df-to" name="to" type="date" required value={filters.to} aria-invalid={dateError ? "true" : undefined} aria-describedby={dateError ? "dash-errors" : undefined} />
  </div>
  <div class="grid gap-1">
    <Label for="df-granularity">{t.granularity}</Label>
    <NativeSelect id="df-granularity" name="granularity">
      {GRANULARITIES.map((g) => <NativeSelectOption value={g} selected={filters.granularity === g}>{t.granularities[g]}</NativeSelectOption>)}
    </NativeSelect>
  </div>
  <div class="grid gap-1">
    <Label for="df-currency">{t.currency}</Label>
    <Input id="df-currency" name="currency" type="text" required minlength={3} maxlength={3} pattern="[A-Za-z]{3}" autocomplete="off" value={filters.currency} aria-describedby="df-currency-hint" aria-invalid={errors.includes("invalidCurrency") ? "true" : undefined} />
    <p id="df-currency-hint" class="text-sm">{t.currencyHint}</p>
  </div>
  <div class="grid gap-1">
    <Label for="df-threshold">{t.threshold}</Label>
    <Input id="df-threshold" name="threshold" type="number" inputmode="numeric" min={0} max={MAX_LOW_STOCK_THRESHOLD} step={1} value={String(filters.lowStockThreshold)} aria-describedby="df-threshold-hint" aria-invalid={errors.includes("invalidThreshold") ? "true" : undefined} />
    <p id="df-threshold-hint" class="text-sm">{t.thresholdHint}</p>
  </div>
  <div class="flex items-end gap-2">
    <Button type="submit">{t.apply}</Button>
    <a href={baseUrl} class="inline-flex min-h-11 items-center rounded-md border-2 border-border px-4 underline-offset-4 hover:underline">{t.reset}</a>
  </div>
  {errors.length > 0 && (
    <ul id="dash-errors" class="grid gap-1 font-medium sm:col-span-2 lg:col-span-6" role="alert" data-testid="dashboard-errors">
      {errors.map((e) => <li id={errorId(e)}>⚠ {t.errors[e]}</li>)}
    </ul>
  )}
</form>

{data === null ? (
  <p role="alert" data-testid="dashboard-unavailable">{t.unavailable}</p>
) : (
  <>
    <section aria-labelledby="dash-summary" class="grid gap-4" data-testid="dashboard-summary">
      <h2 id="dash-summary" class="text-xl font-semibold">{t.summary}</h2>
      <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border-2 border-border p-4">
          <dt class="font-medium">{t.revenueNet}</dt>
          <dd class="text-2xl font-semibold tabular-nums" data-testid="kpi-revenue-net">{money(data.revenue.totals.revenueNet)}</dd>
          <dd class="text-sm">{t.revenueGross} : {money(data.revenue.totals.revenueGross)}</dd>
        </div>
        <div class="rounded-lg border-2 border-border p-4">
          <dt class="font-medium">{t.paid}</dt>
          <dd class="text-2xl font-semibold tabular-nums" data-testid="kpi-paid">{money(data.revenue.totals.paid)}</dd>
        </div>
        <div class="rounded-lg border-2 border-border p-4">
          <dt class="font-medium">{t.outstanding}</dt>
          <dd class="text-2xl font-semibold tabular-nums" data-testid="kpi-outstanding">{money(data.receivables.outstanding)}</dd>
          <dd class="text-sm">{t.overdue} : {money(data.receivables.overdue)}</dd>
          <dd class="text-sm">{fill(t.openInvoices, { n: data.receivables.openInvoices, m: data.receivables.overdueInvoices })}</dd>
          <dd class="text-sm">{fill(t.pendingOrders, { n: data.receivables.pendingOrders })}</dd>
        </div>
        <div class="rounded-lg border-2 border-border p-4">
          <dt class="font-medium">{t.grossMargin}</dt>
          <dd class="text-2xl font-semibold tabular-nums" data-testid="kpi-gross-margin">{money(data.revenue.totals.grossMargin)}</dd>
          <dd class="text-sm">{rate(data.revenue.totals.grossMargin, data.revenue.totals.revenueNet)}</dd>
          <dd class="text-sm">{t.shopMargin} : {money(data.revenue.totals.shopMargin)} — {rate(data.revenue.totals.shopMargin, data.revenue.totals.shopNet)}</dd>
        </div>
      </dl>
      <p class="text-sm">{fill(t.method, { currency: filters.currency })}</p>
      {data.revenue.totals.uncostedUnits > 0 && <p class="text-sm font-medium" data-testid="dashboard-uncosted">⚠ {fill(t.uncostedUnits, { n: data.revenue.totals.uncostedUnits })}</p>}
    </section>

    <section aria-labelledby="dash-periods" class="grid gap-2">
      <h2 id="dash-periods" class="text-xl font-semibold">{t.revenueTable}</h2>
      <ScrollRegion labelledby="dash-periods">
        <table class="w-full text-start text-base" data-testid="dashboard-periods">
          <caption class="sr-only">{t.revenueTable}</caption>
          <thead>
            <tr class="border-b-2 border-border">
              <th scope="col" class="p-2 text-start">{t.period}</th>
              <th scope="col" class={num}>{t.invoiced}</th>
              <th scope="col" class={num}>{t.credited}</th>
              <th scope="col" class={num}>{t.shop}</th>
              <th scope="col" class={num}>{t.revenueNet}</th>
              <th scope="col" class={num}>{t.paid}</th>
              <th scope="col" class={num}>{t.purchases}</th>
              <th scope="col" class={num}>{t.grossMargin}</th>
              <th scope="col" class={num}>{t.shopMargin}</th>
            </tr>
          </thead>
          <tbody>
            {data.revenue.rows.map((r) => (
              <tr class="border-b border-border">
                <th scope="row" class="p-2 text-start font-medium">{periodLabel(r.bucket, filters.granularity)}</th>
                <td class={num}>{money(r.invoicedNet)}</td>
                <td class={num}>{money(r.creditedNet)}</td>
                <td class={num}>{money(r.shopNet)}</td>
                <td class={num}>{money(r.revenueNet)}</td>
                <td class={num}>{money(r.paid)}</td>
                <td class={num}>{money(r.purchases)}</td>
                <td class={num}>{money(r.grossMargin)}</td>
                <td class={num}>{money(r.shopMargin)}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t-2 border-border font-semibold">
              <th scope="row" class="p-2 text-start">{t.total}</th>
              <td class={num}>{money(data.revenue.totals.invoicedNet)}</td>
              <td class={num}>{money(data.revenue.totals.creditedNet)}</td>
              <td class={num}>{money(data.revenue.totals.shopNet)}</td>
              <td class={num}>{money(data.revenue.totals.revenueNet)}</td>
              <td class={num}>{money(data.revenue.totals.paid)}</td>
              <td class={num}>{money(data.revenue.totals.purchases)}</td>
              <td class={num}>{money(data.revenue.totals.grossMargin)}</td>
              <td class={num}>{money(data.revenue.totals.shopMargin)}</td>
            </tr>
          </tfoot>
        </table>
      </ScrollRegion>
    </section>

    {data.stock && (
      <section aria-labelledby="dash-stock" class="grid gap-4" data-testid="dashboard-stock">
        <h2 id="dash-stock" class="text-xl font-semibold">{t.stock}</h2>
        <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-lg border-2 border-border p-4">
            <dt class="font-medium">{t.stockValuation}</dt>
            <dd class="text-2xl font-semibold tabular-nums" data-testid="kpi-stock-valuation">{money(data.stock.totals.valuation)}</dd>
          </div>
          <div class="rounded-lg border-2 border-border p-4"><dt class="font-medium">{t.units}</dt><dd class="text-2xl font-semibold tabular-nums">{integer.format(data.stock.totals.units)}</dd></div>
          <div class="rounded-lg border-2 border-border p-4"><dt class="font-medium">{t.reserved}</dt><dd class="text-2xl font-semibold tabular-nums">{integer.format(data.stock.totals.reserved)}</dd></div>
          <div class="rounded-lg border-2 border-border p-4"><dt class="font-medium">{t.items}</dt><dd class="text-2xl font-semibold tabular-nums">{integer.format(data.stock.totals.items)}</dd></div>
        </dl>
        {data.stock.totals.uncosted > 0 && <p class="text-sm font-medium">⚠ {fill(t.uncostedItems, { n: data.stock.totals.uncosted })}</p>}
        {data.stock.truncated && <p class="text-sm font-medium">⚠ {fill(t.truncated, { n: integer.format(MAX_STOCK_ITEMS) })}</p>}
        <h3 id="dash-low" class="text-lg font-semibold">{fill(t.lowTitle, { n: integer.format(filters.lowStockThreshold) })}</h3>
        {data.stock.low.length === 0 ? (
          <p data-testid="dashboard-no-low">{t.noLow}</p>
        ) : (
          <ScrollRegion labelledby="dash-low">
            <table class="w-full text-start text-base" data-testid="dashboard-low-stock">
              <caption class="sr-only">{fill(t.lowTitle, { n: integer.format(filters.lowStockThreshold) })}</caption>
              <thead>
                <tr class="border-b-2 border-border">
                  <th scope="col" class="p-2 text-start">{t.sku}</th>
                  <th scope="col" class="p-2 text-start">{t.name}</th>
                  <th scope="col" class={num}>{t.level}</th>
                  <th scope="col" class={num}>{t.reserved}</th>
                  <th scope="col" class={num}>{t.available}</th>
                  <th scope="col" class={num}>{t.unitCost}</th>
                  <th scope="col" class={num}>{t.valuation}</th>
                </tr>
              </thead>
              <tbody>
                {data.stock.low.map((i) => (
                  <tr class="border-b border-border">
                    <th scope="row" class="p-2 text-start font-mono font-medium">{i.sku}</th>
                    <td class="p-2">{i.name}</td>
                    <td class={num}>{integer.format(i.level)}</td>
                    <td class={num}>{integer.format(i.reserved)}</td>
                    <td class={num}>{integer.format(i.available)}</td>
                    <td class={num}>{i.unitCost === null ? "—" : money(Math.round(i.unitCost))}</td>
                    <td class={num}>{i.valuation === null ? "—" : money(i.valuation)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </ScrollRegion>
        )}
      </section>
    )}
  </>
)}
