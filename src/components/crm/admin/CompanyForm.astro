---
/** Formulaire de société (création / édition). Soumission par `modules/crm/client/forms.ts`. */
import { Button } from "@atoms/button";
import { Input } from "@atoms/input";
import { Label } from "@atoms/label";
import type { Locale } from "@i18n/config";
import { getCrmTranslations } from "@/modules/crm/i18n";

interface Props {
  locale: Locale;
  organizationId?: string | null;
  viewBaseUrl: string;
  listUrl: string;
  company?: { id: string; name: string; email: string | null; phone: string | null; website: string | null; country: string | null; vatNumber: string | null; address: string | null; notes: string | null };
}
const { locale, organizationId = null, viewBaseUrl, listUrl, company: c } = Astro.props as Props;
const t = getCrmTranslations(locale);
const fields = [
  { name: "email", type: "email", autocomplete: "email" },
  { name: "phone", type: "tel", autocomplete: "tel" },
  { name: "website", type: "url", autocomplete: "url" },
  { name: "country", type: "text", autocomplete: "country" },
  { name: "vatNumber", type: "text", autocomplete: "off" },
] as const;
---
<form class="flex max-w-3xl flex-col gap-6" data-crm-form="company" data-id={c?.id ?? ""} data-organization-id={organizationId ?? ""} data-view-base-url={viewBaseUrl} data-done={c ? t.admin.saved : t.admin.created} novalidate>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid gap-2 sm:col-span-2"><Label for="crm-company-name">{t.fields.name}</Label><Input id="crm-company-name" name="name" required maxlength={200} autocomplete="organization" value={c?.name ?? ""} /></div>
    {fields.map((f) => (
      <div class="grid gap-2"><Label for={`crm-company-${f.name}`}>{t.fields[f.name]}</Label><Input id={`crm-company-${f.name}`} name={f.name} type={f.type} autocomplete={f.autocomplete} maxlength={f.name === "country" ? 2 : 200} value={c?.[f.name] ?? ""} /></div>
    ))}
    <div class="grid gap-2 sm:col-span-2"><Label for="crm-company-address">{t.fields.address}</Label><textarea id="crm-company-address" name="address" rows="2" maxlength="1000" class="rounded-md border bg-transparent px-3 py-2 text-sm">{c?.address ?? ""}</textarea></div>
    <div class="grid gap-2 sm:col-span-2"><Label for="crm-company-notes">{t.fields.notes}</Label><textarea id="crm-company-notes" name="notes" rows="3" maxlength="5000" class="rounded-md border bg-transparent px-3 py-2 text-sm">{c?.notes ?? ""}</textarea></div>
  </div>
  <p class="text-sm text-destructive" role="alert" tabindex="-1" data-form-error hidden></p>
  <div class="flex gap-3"><Button type="submit">{c ? t.admin.save : t.admin.create}</Button><a class="inline-flex min-h-11 items-center px-3 underline" href={listUrl}>{t.admin.companies}</a></div>
</form>

<script>
  import { initCrm } from "@/modules/crm/client/init";

  initCrm();
  document.addEventListener("astro:after-swap", initCrm);
</script>
