---
/** Formulaire de contact (création / édition). Soumission par `modules/crm/client/forms.ts`. */
import { Button } from "@atoms/button";
import { Input } from "@atoms/input";
import { Label } from "@atoms/label";
import { NativeSelect, NativeSelectOption } from "@atoms/native-select";
import type { Locale } from "@i18n/config";
import { getCrmTranslations } from "@/modules/crm/i18n";

interface Props {
  locale: Locale;
  organizationId?: string | null;
  viewBaseUrl: string;
  listUrl: string;
  companies: readonly { id: string; name: string }[];
  contact?: { id: string; firstName: string | null; lastName: string; email: string | null; phone: string | null; jobTitle: string | null; companyId: string | null; notes: string | null };
}
const { locale, organizationId = null, viewBaseUrl, listUrl, companies, contact: c } = Astro.props as Props;
const t = getCrmTranslations(locale);
const fields = [
  { name: "firstName", type: "text", autocomplete: "given-name", required: false },
  { name: "lastName", type: "text", autocomplete: "family-name", required: true },
  { name: "email", type: "email", autocomplete: "email", required: false },
  { name: "phone", type: "tel", autocomplete: "tel", required: false },
  { name: "jobTitle", type: "text", autocomplete: "organization-title", required: false },
] as const;
---
<form class="flex max-w-3xl flex-col gap-6" data-crm-form="contact" data-id={c?.id ?? ""} data-organization-id={organizationId ?? ""} data-view-base-url={viewBaseUrl} data-done={c ? t.admin.saved : t.admin.created} novalidate>
  <div class="grid gap-4 sm:grid-cols-2">
    {fields.map((f) => (
      <div class="grid gap-2"><Label for={`crm-contact-${f.name}`}>{t.fields[f.name]}</Label><Input id={`crm-contact-${f.name}`} name={f.name} type={f.type} autocomplete={f.autocomplete} required={f.required} maxlength={200} value={c?.[f.name] ?? ""} /></div>
    ))}
    <div class="grid gap-2"><Label for="crm-contact-company">{t.fields.company}</Label>
      <NativeSelect id="crm-contact-company" name="companyId"><NativeSelectOption value="">{t.admin.none}</NativeSelectOption>{companies.map((co) => <NativeSelectOption value={co.id} selected={c?.companyId === co.id}>{co.name}</NativeSelectOption>)}</NativeSelect>
    </div>
    <div class="grid gap-2 sm:col-span-2"><Label for="crm-contact-notes">{t.fields.notes}</Label><textarea id="crm-contact-notes" name="notes" rows="3" maxlength="5000" class="rounded-md border bg-transparent px-3 py-2 text-sm">{c?.notes ?? ""}</textarea></div>
  </div>
  <p class="text-sm text-destructive" role="alert" tabindex="-1" data-form-error hidden></p>
  <div class="flex gap-3"><Button type="submit">{c ? t.admin.save : t.admin.create}</Button><a class="inline-flex min-h-11 items-center px-3 underline" href={listUrl}>{t.admin.contacts}</a></div>
</form>

<script>
  import { initCrm } from "@/modules/crm/client/init";

  initCrm();
  document.addEventListener("astro:after-swap", initCrm);
</script>
