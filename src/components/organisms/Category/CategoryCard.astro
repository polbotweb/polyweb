---
import IconArrowRight from "@tabler/icons/outline/arrow-right.svg";
import { Image } from "@atoms/image";

export interface CategoryCardProps {
  image: string;
  title: string;
  tagline: string;
  href?: string;
}

const { image, title, tagline, href = "#" } = Astro.props;
---

<a
  href={href}
  class="group relative aspect-3/4 w-72 shrink-0 overflow-hidden rounded-2xl @xl:w-80 @3xl:w-96"
>
  <Image
    src={image}
    alt={title}
    width={384}
    height={512}
    class="size-full object-cover transition-transform duration-700 group-hover:scale-110"
  />

  <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent" />

  <div class="absolute inset-x-0 bottom-0 p-6 @xl:p-8">
    <p class="text-sm font-medium text-white/70">{tagline}</p>

    <h3 class="mt-2 text-xl font-semibold text-white @xl:text-2xl">
      {title}
    </h3>

    <div class="mt-4 flex items-center gap-2 text-sm font-medium text-white opacity-0 transition group-hover:opacity-100">
      <span>Explore</span>
      <IconArrowRight class="size-4 transition-transform group-hover:translate-x-1" />
    </div>
  </div>
</a>