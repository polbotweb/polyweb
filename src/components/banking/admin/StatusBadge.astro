---
/** Pastille de statut (ligne de relevé, rapprochement, continuité, flux) — texte toujours visible. */
interface Props {
  label: string;
  tone?: "neutral" | "success" | "warning" | "danger" | "info";
}
const { label, tone = "neutral" } = Astro.props;
const tones = {
  neutral: "border-border bg-muted text-foreground",
  success: "border-green-700 bg-green-50 text-green-900 dark:bg-green-950 dark:text-green-100",
  warning: "border-amber-700 bg-amber-50 text-amber-900 dark:bg-amber-950 dark:text-amber-100",
  danger: "border-red-700 bg-red-50 text-red-900 dark:bg-red-950 dark:text-red-100",
  info: "border-blue-700 bg-blue-50 text-blue-900 dark:bg-blue-950 dark:text-blue-100",
} as const;
---
<span class:list={["inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-medium", tones[tone]]}>{label}</span>
