---
/**
 * Page de détail du domaine banking.
 *
 * La DTO arrive par props : la page a fait appel au loader. Ce composant se
 * contente de composer les atomes de `molecules/`.
 */
import type { BankingDTO } from "@/modules/banking/loaders/statement.loader";
import BankingCard from "@/components/banking/BankingCard.astro";

interface Props {
  item: BankingDTO;
}

const { item } = Astro.props as Props;
---

<section class="flex flex-col gap-6">
  <BankingCard id={item.id} title={item.id} href="#" />
</section>

<script>
  import { initBanking } from "@/modules/banking/client/init";

  initBanking();
  document.addEventListener("astro:after-swap", initBanking);
</script>
