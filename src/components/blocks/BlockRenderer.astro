---
/**
 * BlockRenderer — rendu public d'un document de blocs (brique a).
 * Le HTML provient exclusivement des renderers du registre (texte échappé,
 * liste blanche TipTap, URLs filtrées) — jamais de HTML utilisateur brut.
 */
import { renderBlocksToHtml, type BlocksDocument } from '@/core/blocks';

interface Props { doc: BlocksDocument | null | undefined; class?: string }
const { doc, class: className } = Astro.props;
const html = renderBlocksToHtml(doc);
---
{/* eslint-disable-next-line astro/no-set-html-directive -- sortie des renderers de blocs, échappée et filtrée (voir src/core/blocks) */}
<div class:list={['pw-blocks prose max-w-none', className]} set:html={html} />

<style is:global>
  .pw-blocks > * + * { margin-top: 1.25rem; }
  .pw-blocks .pw-embed { position: relative; aspect-ratio: 16 / 9; }
  .pw-blocks .pw-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: var(--radius, 0.5rem); }
  .pw-blocks .pw-callout { border-inline-start: 4px solid var(--primary); background: var(--muted); padding: 1rem; border-radius: var(--radius, 0.5rem); }
  .pw-blocks .pw-callout-warning { border-color: var(--warning, #d97706); }
  .pw-blocks .pw-callout-success { border-color: var(--success, #16a34a); }
  .pw-blocks .pw-cta-link { display: inline-block; background: var(--primary); color: var(--primary-foreground); padding: 0.6rem 1.2rem; border-radius: var(--radius, 0.5rem); font-weight: 600; text-decoration: none; }
  .pw-blocks figure img { border-radius: var(--radius, 0.5rem); }
  .pw-blocks figcaption { font-size: 0.875rem; color: var(--muted-foreground); margin-top: 0.5rem; }
</style>
