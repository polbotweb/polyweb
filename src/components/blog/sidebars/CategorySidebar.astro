---
import { Icon } from "astro-icon/components";
import type { Locale } from "@i18n/config";
import type { BlogTranslations } from "@i18n/config";
import { buildBlogCategoryUrl, extractOrgSlugFromBaseUrl } from "@lib/blog/utils";
import { Card, CardHeader, CardTitle, CardContent } from "@atoms/card";

interface CategoryItem {
  id: string;
  slug: string;
  name: string;
  postCount: number;
}

interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  categories: CategoryItem[];
  baseUrl: string;
  activeSlug?: string;
}

const { locale, blogT, categories, activeSlug, baseUrl } = Astro.props;
const organizationSlug = extractOrgSlugFromBaseUrl(baseUrl);
---

<Card>
  <CardHeader>
    <CardTitle class="sidebar-title">
      <Icon name="mdi:tag-multiple-outline" />
      {blogT.labels.categories}
    </CardTitle>
  </CardHeader>
  <CardContent>
    {categories.length === 0 ? (
      <p class="sidebar-empty">{blogT.labels.noCategories}</p>
    ) : (
      <ul class="sidebar-categories">
        {categories.map((cat) => {
          const isActive = cat.slug === activeSlug;
          return (
            <li>
              <a
                href={buildBlogCategoryUrl(locale, organizationSlug, cat.slug)}
                class={`sidebar-cat-link ${isActive ? 'active' : ''}`}
                aria-current={isActive ? "page" : undefined}
              >
                <span class="sidebar-cat-link__name">{cat.name}</span>
                <span class="sidebar-cat-link__count">{cat.postCount}</span>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </CardContent>
</Card>

<style>
  .sidebar-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 var(--space-3);
    color: var(--heading-color, var(--text-default));
  }

  .sidebar-title :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-primary);
  }

  .sidebar-empty {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .sidebar-categories {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sidebar-cat-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--text-default);
    transition: background 150ms;
  }

  .sidebar-cat-link:hover {
    background: var(--bg-subtle, color-mix(in srgb, var(--color-primary) 4%, transparent));
  }

  .sidebar-cat-link.active {
    font-weight: 700;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .sidebar-cat-link__name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .sidebar-cat-link__count {
    font-size: 0.75rem;
    opacity: 0.7;
    padding: 0.125rem 0.375rem;
    background: rgba(0, 0, 0, 0.08);
    border-radius: 9999px;
  }

  .sidebar-cat-link.active .sidebar-cat-link__count {
    color: currentColor;
    opacity: 0.9;
    background: rgba(255, 255, 255, 0.2);
  }
</style>
