---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import { LOCALES, LOCALE_LABELS, type Locale } from "@i18n/config";
import type { BlogTranslations } from "@i18n/config";
import { buildBlogPostHref } from "@/lib/blog/utils";
import { Card, CardContent, CardHeader, CardTitle } from "@atoms/card";
import { Input } from "@atoms/input";
import { Textarea } from "@atoms/textarea";
import { Label } from "@atoms/label";
import { Checkbox } from "@atoms/checkbox";
import { NativeSelect, NativeSelectOption } from "@atoms/native-select";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@atoms/tabs";
import { Badge } from "@atoms/badge";
import Button from "@atoms/button/Button.astro";
import MediaPicker from "@atoms/media-picker/MediaPicker.astro";
import ContentEditor from "@components/content/ContentEditor.astro";
import type { BlogEditorTaxonomyOption, BlogPostEditorData, BlogPostUpdateInput } from "@/lib/blog/editor-types";
import type { BlogPostFormInput } from "@/lib/blog/types";

interface Props { locale: Locale; blogT: BlogTranslations; mode: "create" | "edit"; editorData?: BlogPostEditorData | null; categories: BlogEditorTaxonomyOption[]; tags: BlogEditorTaxonomyOption[]; baseAdminUrl: string; basePublicUrl?: string; organizationId?: string | null; canCreate?: boolean; canUpdate?: boolean; canPublish?: boolean; canDelete?: boolean; }
const { locale, blogT, mode, editorData, categories, tags, baseAdminUrl, basePublicUrl, organizationId, canCreate = false, canUpdate = true, canPublish = false, canDelete = false } = Astro.props;
const post = editorData?.post ?? null;
const translation = editorData?.translation ?? null;
const selectedCategoryIds = new Set(editorData?.categoryIds ?? []);
const selectedTagIds = new Set(editorData?.tagIds ?? []);
const availableLocales = new Set(editorData?.translations?.map((item) => item.locale) ?? []);
const isEdit = mode === "edit";
const adminT = blogT.admin;
const previewUrl = translation && basePublicUrl ? buildBlogPostHref(basePublicUrl, translation.slug, categories.find((category) => selectedCategoryIds.has(category.id))?.slug ?? null) : null;
function buildLocaleHref(targetLocale: Locale): string { const currentPath = Astro.url.pathname.replace(new RegExp(`^/${locale}(?=/|$)`), "") || "/"; return `${getRelativeLocaleUrl(targetLocale, currentPath)}${Astro.url.search}`; }
---
<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
  <Card>
    <CardHeader>
      <div class="flex flex-wrap items-start justify-between gap-3"><div><CardTitle>{isEdit ? adminT.editPost : adminT.newPost}</CardTitle>{post?.seoScore !== null && post?.seoScore !== undefined && <p class="mt-2 text-sm text-muted-foreground">{adminT.seoScore}: <span class="font-medium text-foreground">{post.seoScore}/100</span></p>}</div>{previewUrl && <Button variant="outline" size="sm" href={previewUrl}><Icon name="mdi:open-in-new" class="size-4" />{adminT.preview}</Button>}</div>
      <div class="mt-4 flex flex-wrap items-center gap-2" aria-label={adminT.localeSwitcher.title}><span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{adminT.localeSwitcher.title}</span>{LOCALES.map((loc) => { const active = loc === locale; const available = isEdit ? availableLocales.has(loc) : active; return <a href={buildLocaleHref(loc)} data-locale-link class:list={["inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium transition-colors", {"border-primary bg-primary text-primary-foreground": active, "border-border bg-background text-muted-foreground hover:border-primary/40 hover:text-foreground": !active}]} aria-current={active ? "page" : undefined}><span>{LOCALE_LABELS[loc]}</span>{isEdit && <span class:list={["rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide", {"bg-success/10 text-success": available, "bg-warning/10 text-warning-foreground": !available}]}>{available ? adminT.localeSwitcher.available : adminT.localeSwitcher.missing}</span>}</a>; })}</div>
      {editorData?.lock && <output class="mt-4 rounded-lg border border-warning/40 bg-warning/10 px-4 py-3 text-sm text-warning-foreground">{adminT.lockWarning}</output>}
    </CardHeader>
    <CardContent>
      <form id="blog-post-form" class="space-y-6" data-mode={mode} data-locale={locale} data-base-admin-url={baseAdminUrl} data-t-error={adminT.feedback.genericError} data-t-created={adminT.feedback.created} data-t-updated={adminT.feedback.updated} data-t-confirm-delete={adminT.feedback.confirmDeletePost} data-t-link-no-result={adminT.editor.linkNoResult} data-t-link-checking={adminT.editor.preview}>
        <input type="hidden" name="organizationId" value={organizationId ?? ""} /><input type="hidden" name="locale" value={locale} />{post && <input type="hidden" name="id" value={post.id} />}
        <Tabs defaultValue="content"><TabsList><TabsTrigger value="content" defaultActive>{adminT.tabs.content}</TabsTrigger><TabsTrigger value="seo">{adminT.tabs.seo}</TabsTrigger><TabsTrigger value="galleries">{adminT.tabs.galleries}</TabsTrigger><TabsTrigger value="links">{adminT.tabs.links}</TabsTrigger><TabsTrigger value="settings">{adminT.tabs.settings}</TabsTrigger></TabsList>
          <TabsContent value="content" defaultActive class="space-y-4 pt-4"><div class="grid gap-4 md:grid-cols-2"><div class="space-y-1.5"><Label for="post-title">{adminT.fields.title}</Label><Input id="post-title" name="title" required value={translation?.title ?? ""} /></div><div class="space-y-1.5"><Label for="post-slug">{adminT.fields.slug}</Label><Input id="post-slug" name="slug" required value={translation?.slug ?? ""} /></div></div><div class="space-y-1.5"><Label for="post-excerpt">{adminT.fields.excerpt}</Label><Textarea id="post-excerpt" name="excerpt" rows={3} defaultValue={translation?.excerpt ?? ""} /></div><ContentEditor name="content" value={translation?.content ?? ""} locale={locale} organizationId={organizationId} resolverName="blog" mediaPickerId="blog-content-picker" label={adminT.fields.content} required={true} rows={14} i18n={{ toolbarLabel: adminT.editor.toolbarLabel, bold: adminT.editor.bold, italic: adminT.editor.italic, heading: adminT.editor.heading, list: adminT.editor.list, link: adminT.editor.link, image: adminT.editor.image, preview: adminT.editor.preview, hint: adminT.editor.hint, linkDialogTitle: adminT.editor.linkDialogTitle, linkInternal: adminT.editor.linkInternal, linkExternal: adminT.editor.linkExternal, linkSearchPlaceholder: adminT.editor.linkSearchPlaceholder, linkText: adminT.editor.linkText, linkUrl: adminT.editor.linkUrl, linkInsert: adminT.editor.linkInsert, linkNoResult: adminT.editor.linkNoResult, imageAlt: adminT.editor.imageAlt }} /><div class="grid gap-4 md:grid-cols-2"><div class="space-y-1.5"><Label for="featured-image-id">{adminT.fields.featuredImage}</Label><div class="flex gap-2"><Input id="featured-image-id" name="featuredImageId" readonly value={post?.featuredImageId ?? ""} /><Button type="button" variant="outline" size="sm" data-media-picker="blog-featured-picker">{adminT.actionLabels.chooseMedia}</Button></div></div><div class="space-y-1.5"><Label for="og-image-id">{adminT.fields.ogImage}</Label><div class="flex gap-2"><Input id="og-image-id" name="ogImageId" readonly value={translation?.ogImageId ?? ""} /><Button type="button" variant="outline" size="sm" data-media-picker="blog-og-picker">{adminT.actionLabels.chooseMedia}</Button></div></div></div></TabsContent>
          <TabsContent value="seo" class="space-y-4 pt-4"><div class="grid gap-4 md:grid-cols-2"><div class="space-y-1.5"><Label for="post-meta-title">{adminT.fields.metaTitle}</Label><Input id="post-meta-title" name="metaTitle" value={translation?.metaTitle ?? ""} /></div><div class="space-y-1.5"><Label for="post-meta-keywords">{adminT.fields.metaKeywords}</Label><Input id="post-meta-keywords" name="metaKeywords" value={translation?.metaKeywords ?? ""} /></div></div><div class="space-y-1.5"><Label for="post-meta-description">{adminT.fields.metaDescription}</Label><Textarea id="post-meta-description" name="metaDescription" rows={3} defaultValue={translation?.metaDescription ?? ""} /></div><div class="grid gap-4 md:grid-cols-2"><div class="space-y-1.5"><Label for="post-canonical">{adminT.fields.canonicalUrl}</Label><Input id="post-canonical" name="canonicalUrl" type="url" value={translation?.canonicalUrl ?? ""} /></div><div class="space-y-1.5"><Label for="post-focus-keyword">{adminT.fields.focusKeyword}</Label><Input id="post-focus-keyword" name="focusKeyword" value={editorData?.seo?.focusKeyword ?? ""} /></div></div><div class="grid gap-4 md:grid-cols-2"><div class="space-y-1.5"><Label for="post-og-title">{adminT.fields.ogTitle}</Label><Input id="post-og-title" name="ogTitle" value={translation?.ogTitle ?? ""} /></div><div class="space-y-1.5"><Label for="post-og-description">{adminT.fields.ogDescription}</Label><Input id="post-og-description" name="ogDescription" value={translation?.ogDescription ?? ""} /></div></div></TabsContent>
          <TabsContent value="galleries" class="space-y-4 pt-4"><div class="flex items-center justify-between gap-3"><h3 class="font-heading text-base font-semibold">{adminT.tabs.galleries}</h3><Button type="button" size="sm" id="gallery-add-btn"><Icon name="mdi:plus" class="size-4" />{adminT.actionLabels.addGallery}</Button></div><div id="galleries-list" class="space-y-4" data-post-id={post?.id ?? ""} data-org={organizationId ?? ""}>{editorData?.galleries.map((gallery) => <div class="rounded-lg border p-4" data-gallery-id={gallery.id}><div class="flex flex-wrap items-center justify-between gap-3"><Input type="text" value={gallery.title ?? ""} placeholder={adminT.fields.galleryTitle} class="max-w-md" data-gallery-title /><div class="flex gap-2"><Button type="button" size="sm" variant="outline" data-gallery-save data-gallery-id={gallery.id}>{adminT.actionLabels.save}</Button><Button type="button" size="sm" variant="error" class="gallery-delete-btn" data-gallery-id={gallery.id}><Icon name="mdi:delete" class="size-4" />{adminT.actionLabels.trash}</Button></div></div><p class="mt-2 text-xs text-muted-foreground">{gallery.media.length} {blogT.labels.media}</p><div class="mt-3 flex flex-wrap gap-2">{gallery.media.map((media) => <div class="rounded border px-3 py-2 text-xs" data-gallery-media={media.mediaId}><span class="font-medium">{media.altText}</span>{media.caption && <span class="text-muted-foreground"> · {media.caption}</span>}<Button type="button" size="icon-sm" variant="ghost" class="ml-1" data-gallery-remove data-gallery-id={gallery.id} data-media-id={media.mediaId} aria-label={adminT.actionLabels.trash}><Icon name="mdi:close" class="size-3" /></Button></div>)}</div><Button type="button" size="sm" variant="outline" class="mt-3" data-gallery-picker-trigger data-gallery-id={gallery.id}>{adminT.actionLabels.chooseMedia}</Button></div>)}{(!editorData?.galleries.length) && <p class="text-sm text-muted-foreground">{adminT.empty.galleries}</p>}</div></TabsContent>
          <TabsContent value="links" class="space-y-4 pt-4"><div class="flex flex-wrap items-center justify-between gap-3"><h3 class="font-heading text-base font-semibold">{adminT.tabs.links}</h3><div class="flex gap-2"><Button type="button" size="sm" variant="outline" id="link-check-btn"><Icon name="mdi:link-off" class="size-4" />{adminT.actionLabels.checkLinks}</Button><Button type="button" size="sm" id="link-add-btn"><Icon name="mdi:plus" class="size-4" />{adminT.actionLabels.addLink}</Button></div></div><div id="link-check-report" class="space-y-2" aria-live="polite"></div><div id="links-list" class="space-y-3" data-post-id={post?.id ?? ""}>{editorData?.links.map((link) => <div class="flex flex-wrap items-center gap-3 rounded-lg border p-3" data-link-id={link.id}><NativeSelect class="w-36" data-link-type={link.id}><NativeSelectOption value="RELATED" selected={link.linkType === "RELATED"}>RELATED</NativeSelectOption><NativeSelectOption value="PREVIOUS" selected={link.linkType === "PREVIOUS"}>PREVIOUS</NativeSelectOption><NativeSelectOption value="NEXT" selected={link.linkType === "NEXT"}>NEXT</NativeSelectOption><NativeSelectOption value="REFERENCE" selected={link.linkType === "REFERENCE"}>REFERENCE</NativeSelectOption></NativeSelect><span class="min-w-0 flex-1 truncate">{link.target.title ?? link.target.slug}</span><Button type="button" size="sm" variant="error" class="link-delete-btn" data-link-id={link.id}><Icon name="mdi:delete" class="size-4" />{adminT.actionLabels.trash}</Button></div>)}{(!editorData?.links.length) && <p class="text-sm text-muted-foreground">{adminT.empty.links}</p>}</div></TabsContent>
          <TabsContent value="settings" class="space-y-4 pt-4"><div class="grid gap-4 md:grid-cols-2"><div class="space-y-1.5"><Label>{adminT.sidebar.currentState}</Label><Badge variant={post?.status === "PUBLISHED" ? "success" : post?.status === "ARCHIVED" ? "secondary" : post?.status === "DELETED" ? "error" : "warning"}>{blogT.statuses[post?.status ?? "DRAFT"]}</Badge></div><div class="space-y-1.5"><Label for="post-comment-status">{adminT.fields.commentStatus}</Label><NativeSelect id="post-comment-status" name="commentStatus"><NativeSelectOption value="OPEN" selected={(post?.commentStatus ?? "OPEN") === "OPEN"}>{adminT.commentStatuses.OPEN}</NativeSelectOption><NativeSelectOption value="CLOSED" selected={(post?.commentStatus ?? "OPEN") === "CLOSED"}>{adminT.commentStatuses.CLOSED}</NativeSelectOption><NativeSelectOption value="DISABLED" selected={(post?.commentStatus ?? "OPEN") === "DISABLED"}>{adminT.commentStatuses.DISABLED}</NativeSelectOption></NativeSelect></div></div><div class="grid gap-4 sm:grid-cols-3"><Checkbox id="post-featured" name="isFeatured" label={blogT.labels.featured} checked={post?.isFeatured ?? false} /><Checkbox id="post-sticky" name="isSticky" label={blogT.labels.sticky} checked={post?.isSticky ?? false} /><Checkbox id="post-reviews" name="allowReviews" label={blogT.labels.reviews} checked={post?.allowReviews ?? true} /></div><div class="space-y-2"><Label>{blogT.labels.categories}</Label><div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">{categories.map((category) => <Checkbox id={`category-${category.id}`} name="categoryIds" value={category.id} label={category.label} checked={selectedCategoryIds.has(category.id)} />)}</div></div><div class="space-y-2"><Label>{blogT.labels.tags}</Label><div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">{tags.map((tag) => <Checkbox id={`tag-${tag.id}`} name="tagIds" value={tag.id} label={tag.label} checked={selectedTagIds.has(tag.id)} />)}</div></div></TabsContent>
        </Tabs>
        <div class="flex flex-wrap items-center justify-end gap-3 border-t pt-4"><Button type="button" variant="outline" href={baseAdminUrl}>{adminT.actionLabels.cancel}</Button><Button type="submit" size="sm"><Icon name="mdi:content-save" class="size-4" />{isEdit ? adminT.actionLabels.save : adminT.saveDraft}</Button></div>
      </form>
    </CardContent>
  </Card>
  <div class="space-y-6"><Card><CardHeader><CardTitle class="text-base">{adminT.sidebar.statusTitle}</CardTitle></CardHeader><CardContent class="space-y-3">{post ? <div class="grid gap-2">{canPublish && post.status === "DRAFT" && <Button type="button" size="sm" class="lifecycle-publish">{adminT.publish}</Button>}{canPublish && post.status === "PUBLISHED" && <Button type="button" size="sm" variant="outline" class="lifecycle-unpublish">{adminT.saveDraft}</Button>}{canUpdate && (post.status === "DRAFT" || post.status === "PUBLISHED") && <Button type="button" size="sm" variant="outline" class="lifecycle-archive">{adminT.archive}</Button>}{canUpdate && (post.status === "ARCHIVED" || post.status === "DELETED") && <Button type="button" size="sm" variant="outline" class="lifecycle-restore">{adminT.actionLabels.save}</Button>}{canDelete && post.status !== "DELETED" && <Button type="button" size="sm" variant="error" class="lifecycle-delete">{adminT.delete}</Button>}{canCreate && <Button type="button" size="sm" variant="outline" class="lifecycle-duplicate">{adminT.newPost}</Button>}</div> : <p class="text-sm text-muted-foreground">{adminT.saveDraft}</p>}{post?.publishedAt && <div class="flex items-center justify-between gap-3 text-sm"><span class="text-muted-foreground">{adminT.sidebar.published}</span><span>{post.publishedAt.toLocaleString(locale)}</span></div>}</CardContent></Card><Card><CardHeader><CardTitle class="text-base">{adminT.sidebar.recentRevisions}</CardTitle></CardHeader><CardContent>{(!editorData?.revisions.length) ? <p class="text-sm text-muted-foreground">{adminT.sidebar.noRevisions}</p> : <div class="space-y-3">{editorData.revisions.map(({ revision, author }) => <div class="rounded-lg border px-3 py-2"><div class="flex items-center justify-between gap-3 text-sm"><span class="font-medium truncate">{revision.title}</span><Button type="button" size="sm" variant="outline" class="revision-restore" data-revision-id={revision.id}>{adminT.actionLabels.save}</Button></div><p class="mt-1 text-xs text-muted-foreground">/{revision.slug} · {author?.name ?? adminT.sidebar.unknownAuthor} · {new Date(revision.createdAt).toLocaleString(locale)}</p></div>)}</div>}</CardContent></Card></div>
</div>

<dialog id="blog-link-dialog" class="m-auto w-[min(42rem,calc(100vw-2rem))] rounded-xl border bg-background p-0 shadow-xl" aria-labelledby="blog-link-dialog-title"><form method="dialog" class="p-5 space-y-4"><div class="flex items-center justify-between"><h2 id="blog-link-dialog-title" class="font-heading text-lg font-semibold">{adminT.editor.linkDialogTitle}</h2><button value="cancel" aria-label={adminT.actionLabels.cancel} class="rounded p-1 hover:bg-muted">×</button></div><div class="space-y-1.5"><Label for="blog-link-search">{adminT.editor.linkSearchPlaceholder}</Label><Input id="blog-link-search" type="search" placeholder={adminT.editor.linkSearchPlaceholder} /></div><div id="blog-link-results" class="max-h-56 space-y-2 overflow-y-auto" aria-live="polite"></div><div class="grid gap-4 md:grid-cols-2"><div class="space-y-1.5"><Label for="blog-link-type">{adminT.editor.linkInternal}</Label><NativeSelect id="blog-link-type"><NativeSelectOption value="RELATED">RELATED</NativeSelectOption><NativeSelectOption value="PREVIOUS">PREVIOUS</NativeSelectOption><NativeSelectOption value="NEXT">NEXT</NativeSelectOption><NativeSelectOption value="REFERENCE">REFERENCE</NativeSelectOption></NativeSelect></div><div class="space-y-1.5"><Label for="blog-link-order">{adminT.actionLabels.save}</Label><Input id="blog-link-order" type="number" min="0" value="0" /></div></div><div class="flex justify-end gap-2"><Button type="button" variant="outline" id="blog-link-cancel">{adminT.actionLabels.cancel}</Button><Button type="button" id="blog-link-save">{adminT.editor.linkInsert}</Button></div></form></dialog>

<MediaPicker id="blog-featured-picker" locale={locale} organizationId={organizationId ?? null} />
<MediaPicker id="blog-og-picker" locale={locale} organizationId={organizationId ?? null} />
<MediaPicker id="blog-content-picker" locale={locale} organizationId={organizationId ?? null} />
<MediaPicker id="blog-gallery-picker" locale={locale} organizationId={organizationId ?? null} />

<script>
  import { actions } from "astro:actions";
  import { toast } from "@atoms/toast";
  import type { BlogPostFormInput } from "@/lib/blog/types";
  import type { BlogPostUpdateInput } from "@/lib/blog/editor-types";
  const slugify = (value: string) => value.normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 200);
  function init() {
    const form = document.getElementById("blog-post-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound === "1") return;
    form.dataset.bound = "1";
    const mode = form.dataset.mode as "create" | "edit";
    const organizationId = String(form.querySelector<HTMLInputElement>('input[name="organizationId"]')?.value ?? "").trim() || undefined;
    const postId = form.querySelector<HTMLInputElement>('input[name="id"]')?.value;
    const errorText = form.dataset.tError ?? "";
    let isDirty = false;
    let manualSlug = mode === "edit";
    let lockTimer: number | undefined;
    const markDirty = () => { isDirty = true; };
    form.addEventListener("input", markDirty);
    form.addEventListener("change", markDirty);
    window.addEventListener('beforeunload', (event) => { if (!isDirty) return; event.preventDefault(); event.returnValue = ""; });
    document.querySelectorAll<HTMLAnchorElement>("[data-locale-link]").forEach((link) => link.addEventListener("click", (event) => { if (!isDirty) return; event.preventDefault(); const confirmLeave = window.confirm(form.dataset.tConfirmDelete ?? ""); if (confirmLeave) window.location.href = link.href; }));
    const titleInput = form.querySelector<HTMLInputElement>("#post-title"); const slugInput = form.querySelector<HTMLInputElement>("#post-slug"); slugInput?.addEventListener("input", () => { manualSlug = true; markDirty(); }); titleInput?.addEventListener("input", () => { if (!manualSlug && slugInput) slugInput.value = slugify(titleInput.value); });
    const wireMedia = (pickerId: string, inputId: string) => { const picker = document.getElementById(pickerId); const input = document.getElementById(inputId) as HTMLInputElement | null; picker?.addEventListener("media-select", (event) => { const detail = (event as CustomEvent).detail ?? {}; if (input) input.value = String(detail.fileId ?? ""); markDirty(); }); };
    wireMedia("blog-featured-picker", "featured-image-id"); wireMedia("blog-og-picker", "og-image-id");
    const refreshLock = async () => { if (mode !== "edit" || !postId) return; const { error } = await actions.lockBlogPost({ id: postId, organizationId }); if (error) toast.error(error.message ?? errorText); };
    const releaseLock = async () => { if (mode !== "edit" || !postId) return; window.clearInterval(lockTimer); await actions.unlockBlogPost({ id: postId, organizationId }); };
    if (mode === "edit" && postId) { void refreshLock(); lockTimer = window.setInterval(() => void refreshLock(), 60_000); window.addEventListener("pagehide", () => void releaseLock(), { once: true }); }
    form.addEventListener("submit", async (event) => { event.preventDefault(); const data = new FormData(form); const categoryIds = data.getAll("categoryIds").map(String); const tagIds = data.getAll("tagIds").map(String); const focusKeyword = String(data.get("focusKeyword") ?? "").trim(); const common: Omit<BlogPostFormInput, "status"> = { locale: String(data.get("locale") ?? localeFromForm(form)) as BlogPostFormInput["locale"], title: String(data.get("title") ?? ""), slug: String(data.get("slug") ?? ""), content: String(data.get("content") ?? ""), excerpt: String(data.get("excerpt") ?? "").trim() || undefined, metaTitle: String(data.get("metaTitle") ?? "").trim() || undefined, metaDescription: String(data.get("metaDescription") ?? "").trim() || undefined, metaKeywords: String(data.get("metaKeywords") ?? "").trim() || undefined, canonicalUrl: String(data.get("canonicalUrl") ?? "").trim() || undefined, ogTitle: String(data.get("ogTitle") ?? "").trim() || undefined, ogDescription: String(data.get("ogDescription") ?? "").trim() || undefined, categoryIds, tagIds, featuredImageId: String(data.get("featuredImageId") ?? "").trim() || undefined, ogImageId: String(data.get("ogImageId") ?? "").trim() || undefined, isFeatured: data.get("isFeatured") === "on", isSticky: data.get("isSticky") === "on", commentStatus: String(data.get("commentStatus") ?? "OPEN") as BlogPostFormInput["commentStatus"], allowReviews: data.get("allowReviews") === "on", seo: focusKeyword ? { focusKeyword } : undefined };
      let result: { error?: { message?: string }; data?: unknown }; try { result = mode === "edit" ? await actions.updateBlogPost({ ...common, id: String(data.get("id") ?? ""), organizationId }) : await actions.createBlogPost({ ...common, status: "DRAFT", organizationId }); } catch { result = { error: { message: errorText } }; }
      if (result.error) { toast.error(result.error.message ?? errorText); return; } isDirty = false; toast.success(mode === "edit" ? form.dataset.tUpdated ?? "" : form.dataset.tCreated ?? ""); const id = (result.data as { id?: string } | undefined)?.id; if (id && mode === "create") window.location.href = `${form.dataset.baseAdminUrl}/${id}/edit`; });
    const invokeLifecycle = async (operation: (id: string) => Promise<{ error?: { message?: string } }>) => { if (!postId) return; const { error } = await operation(postId); if (error) toast.error(error.message ?? errorText); else window.location.reload(); };
    document.querySelector<HTMLButtonElement>(".lifecycle-publish")?.addEventListener("click", () => void invokeLifecycle((id) => actions.publishBlogPost({ id, organizationId })));
    document.querySelector<HTMLButtonElement>(".lifecycle-unpublish")?.addEventListener("click", () => void invokeLifecycle((id) => actions.unpublishBlogPost({ id, organizationId })));
    document.querySelector<HTMLButtonElement>(".lifecycle-archive")?.addEventListener("click", () => void invokeLifecycle((id) => actions.archiveBlogPost({ id, organizationId })));
    document.querySelector<HTMLButtonElement>(".lifecycle-restore")?.addEventListener("click", () => void invokeLifecycle((id) => actions.restoreBlogPost({ id, organizationId })));
    document.querySelector<HTMLButtonElement>(".lifecycle-delete")?.addEventListener("click", () => { if (confirm(form.dataset.tConfirmDelete ?? errorText)) void invokeLifecycle((id) => actions.deleteBlogPost({ id, organizationId })); });
    document.querySelector<HTMLButtonElement>(".lifecycle-duplicate")?.addEventListener("click", () => void invokeLifecycle((id) => actions.duplicateBlogPost({ id, organizationId })));
    document.querySelectorAll<HTMLButtonElement>(".revision-restore").forEach((button) => button.addEventListener("click", () => { const revisionId = button.dataset.revisionId; if (!postId || !revisionId) return; void actions.restoreBlogPostRevision({ postId, revisionId, organizationId }).then(({ error }) => { if (error) toast.error(error.message ?? errorText); else window.location.reload(); }); }));
