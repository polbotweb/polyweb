---
import type { Locale, BlogTranslations } from "@/i18n/config";
import type { BlogPostListItem } from "@/modules/blog/domain";
import { PostCardGrid, PostCardHorizontal } from "@/modules/blog/components/cards";

interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  posts: BlogPostListItem[];
  baseUrl: string;
  organizationSlug?: string | null;
  variant?: "grid" | "horizontal";
  columns?: 2 | 3 | 4;
  showCategory?: boolean;
  showAuthor?: boolean;
  showDate?: boolean;
  showExcerpt?: boolean;
  showViews?: boolean;
  showComments?: boolean;
  showRating?: boolean;
}

const {
  locale,
  blogT,
  posts,
  baseUrl,
  organizationSlug = null,
  variant = "grid",
  columns = 3,
  showCategory = true,
  showAuthor = true,
  showDate = true,
  showExcerpt = true,
  showViews = true,
  showComments = true,
  showRating = true,
} = Astro.props;

const gridClasses = {
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 sm:grid-cols-2 xl:grid-cols-4",
};
---

<div class="post-grid">
  {variant === "horizontal" ? (
    <div class="flex flex-col gap-4">
      {posts.map((post, index) => (
        <PostCardHorizontal
          locale={locale}
          blogT={blogT}
          post={post}
          baseUrl={baseUrl}
          organizationSlug={organizationSlug}
          priority={index < 4 ? "eager" : "lazy"}
          showCategory={showCategory}
          showAuthor={showAuthor}
          showDate={showDate}
          showExcerpt={showExcerpt}
          showViews={showViews}
          showComments={showComments}
          showRating={showRating}
        />
      ))}
    </div>
  ) : (
    <div class={`grid gap-6 ${gridClasses[columns]}`}>
      {posts.map((post, index) => (
        <PostCardGrid
          locale={locale}
          blogT={blogT}
          post={post}
          baseUrl={baseUrl}
          organizationSlug={organizationSlug}
          priority={index < 4 ? "eager" : "lazy"}
          showCategory={showCategory}
          showAuthor={showAuthor}
          showDate={showDate}
          showExcerpt={showExcerpt}
          showViews={showViews}
          showComments={showComments}
          showRating={showRating}
        />
      ))}
    </div>
  )}
</div>
