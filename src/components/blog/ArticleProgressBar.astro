---
interface Props {
  /** id of the element whose scroll range should be tracked (the article content) */
  targetId: string;
}

const { targetId } = Astro.props;
---

<div
  class="fixed inset-x-0 top-16 z-40 h-0.75 bg-transparent"
  aria-hidden="true"
  data-progress-track
  data-target={targetId}
>
  <div class="h-full w-0 origin-left bg-primary" data-progress-bar></div>
</div>

<script>
  function initProgressBars() {
    document.querySelectorAll<HTMLElement>("[data-progress-track]").forEach((track) => {
      const targetId = track.dataset.target;
      const target = targetId ? document.getElementById(targetId) : null;
      const bar = track.querySelector<HTMLElement>("[data-progress-bar]");
      if (!target || !bar || track.dataset.progressInit === "true") return;
      track.dataset.progressInit = "true";

      let ticking = false;

      const update = () => {
        ticking = false;
        const rect = target.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const articleHeight = rect.height;
        const viewportHeight = window.innerHeight;
        const scrollable = articleHeight - viewportHeight;

        if (scrollable <= 0) {
          bar.style.width = "100%";
          return;
        }

        const scrolled = window.scrollY - articleTop + viewportHeight * 0.3;
        const progress = Math.min(1, Math.max(0, scrolled / scrollable));
        bar.style.width = `${progress * 100}%`;
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      update();
    });
  }

  initProgressBars();
  document.addEventListener("astro:after-swap", initProgressBars);
</script>
