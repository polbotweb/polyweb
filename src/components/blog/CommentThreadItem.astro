---
import type { Locale } from "@i18n/config";
import type { BlogTranslations } from "@i18n/config";
import type { BlogCommentWithAuthor } from "@/lib/blog/types";
import { Avatar, AvatarFallback, AvatarImage } from "@atoms/avatar";
import { Badge } from "@atoms/badge";

interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  comment: BlogCommentWithAuthor;
  commentStatus: "OPEN" | "CLOSED" | "DISABLED";
  isReply?: boolean;
}

const { locale, blogT, comment, commentStatus, isReply = false } = Astro.props;

function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString(locale, {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

const authorName = comment.author?.name ?? comment.guestName ?? "Anonymous";
const initials = authorName.split(" ").map((w) => w[0]).join("").toUpperCase().slice(0, 2);
---

<div class:list={["space-y-3", { "ml-8 border-l-2 pl-4": isReply }]} data-comment-id={comment.id}>
  <div class="flex items-start gap-3">
    <Avatar size="sm">
      {comment.author?.image && <AvatarImage src={comment.author.image} alt={authorName} />}
      <AvatarFallback>{initials}</AvatarFallback>
    </Avatar>
    <div class="flex-1 space-y-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-medium">{authorName}</span>
        {comment.status === "PENDING" && (
          <Badge variant="warning" size="sm">{blogT.labels.pending}</Badge>
        )}
        <span class="text-xs text-muted-foreground">{formatDate(comment.createdAt)}</span>
      </div>
      <p class="text-sm whitespace-pre-wrap">{comment.content}</p>
      {commentStatus === "OPEN" && (
        <button
          type="button"
          class="reply-toggle text-xs text-muted-foreground hover:text-foreground"
          data-parent-id={comment.id}
        >
          {blogT.labels.writeComment}
        </button>
      )}
    </div>
  </div>

  {comment.replies?.length > 0 && (
    <div class="space-y-4">
      {comment.replies.map((reply) => (
        <Astro.self
          locale={locale}
          blogT={blogT}
          comment={reply}
          commentStatus={commentStatus}
          isReply={true}
        />
      ))}
    </div>
  )}
</div>