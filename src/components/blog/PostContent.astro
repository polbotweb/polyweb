---
import { Icon } from "astro-icon/components";
import type { Locale } from "@i18n/config";
import type { BlogTranslations } from "@i18n/config";
import { buildBlogCategoryUrl, buildBlogTagHref, extractOrgSlugFromBaseUrl, formatReadingTime } from "@lib/blog/utils";
import { Prose } from "@atoms/prose";
import { Image } from "@atoms/image";
import { Badge } from "@atoms/badge";
import { Avatar, AvatarFallback, AvatarImage } from "@atoms/avatar";
import { Separator } from "@atoms/separator";
import { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from "@atoms/carousel";
import RichContent from "@components/content/RichContent.astro";

interface BlogPostContentData {
  post: { id: string; publishedAt: Date | null; updatedAt?: Date | null; viewCount: number };
  translation: { title: string; excerpt?: string | null; content: string } | null;
  author: { id: string; name: string; image: string | null } | null;
  featuredImage: { id: string; url: string; width: number | null; height: number | null } | null;
  categories: { id: string; slug: string; color: string | null; name: string | null }[];
  tags: { id: string; slug: string; color: string | null; name: string | null }[];
  galleries: {
    id: string;
    title: string | null;
    description: string | null;
    sortOrder: number;
    media: { id: string; altText: string; caption: string | null; sortOrder: number; file: { id: string; url: string } }[];
  }[];
}

interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  data: BlogPostContentData;
  baseUrl: string;
  /** Pre-processed HTML with heading ids injected (for TOC anchors). Falls back to data.translation.content. */
  contentHtml?: string;
  /** Slugs of existing blog posts for the current tenant+locale (dead-link detection). */
  validTargets?: string[];
}


const { locale, blogT, data, baseUrl, contentHtml, validTargets = [] } = Astro.props;
const organizationSlug = extractOrgSlugFromBaseUrl(baseUrl);
const { post, translation, author, featuredImage, categories, tags, galleries } = data;

if (!translation) return null;

const authorInitial = author ? author.name.charAt(0).toUpperCase() : "?";
const readingTime = formatReadingTime(translation.content);
const isUpdated =
  post.updatedAt && post.publishedAt && post.updatedAt.getTime() - post.publishedAt.getTime() > 60_000;
---

<article class="flex flex-col gap-8">
  {/* Categories breadcrumb */}
  {categories.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {categories.map((cat) => (
        <Badge variant="primary" size="sm" href={buildBlogCategoryUrl(locale, organizationSlug, cat.slug)}>
          {cat.name || cat.slug}
        </Badge>
      ))}
    </div>
  )}

  {/* Header */}
  <header class="flex flex-col gap-4">
    <h1 class="font-heading text-3xl font-bold leading-tight tracking-tight md:text-4xl lg:text-5xl">
      {translation.title}
    </h1>

    {translation.excerpt && (
      <p class="text-lg leading-relaxed text-muted-foreground text-pretty">
        {translation.excerpt}
      </p>
    )}

    {/* Meta bar */}
    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-3 rounded-xl border bg-card/60 px-5 py-4 shadow-sm backdrop-blur">
      {author && (
        <div class="flex items-center gap-2.5">
          <Avatar size="sm">
            {author.image && <AvatarImage src={author.image} alt={author.name} />}
            <AvatarFallback>{authorInitial}</AvatarFallback>
          </Avatar>
          <span class="text-sm font-medium">{author.name}</span>
        </div>
      )}

      {author && post.publishedAt && <Separator orientation="vertical" class="h-5!" />}

      {post.publishedAt && (
        <time class="text-sm text-muted-foreground" datetime={post.publishedAt.toISOString()}>
          {post.publishedAt.toLocaleDateString(locale, { day: "numeric", month: "long", year: "numeric" })}
        </time>
      )}

      {isUpdated && post.updatedAt && (
        <>
          <Separator orientation="vertical" class="h-5!" />
          <span class="text-sm text-muted-foreground">
            Mis à jour le{" "}
            <time datetime={post.updatedAt.toISOString()}>
              {post.updatedAt.toLocaleDateString(locale, { day: "numeric", month: "long", year: "numeric" })}
            </time>
          </span>
        </>
      )}

      <Separator orientation="vertical" class="h-5!" />

      <span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground">
        <Icon name="mdi:clock-outline" class="size-4" />
        {readingTime}
      </span>

      <span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground">
        <Icon name="mdi:eye-outline" class="size-4" />
        {post.viewCount.toLocaleString(locale)}
      </span>
    </div>
  </header>

  {/* Featured image */}
  {featuredImage && (
    <div class="overflow-hidden rounded-xl border">
      <Image
        src={featuredImage.url}
        alt={translation.title}
        inferSize={true}
        loading="eager"
        class="aspect-video w-full object-cover md:aspect-21/9"
      />
    </div>
  )}

  {/* Content */}
  <Prose size="full" class="max-w-none">
    <RichContent html={contentHtml ?? translation.content} validTargets={validTargets} />
  </Prose>

  {/* Galleries */}
  {galleries.length > 0 && (
    <section class="flex flex-col gap-4">
      {galleries.map((gallery) => (
        <div class="flex flex-col gap-2">
          {gallery.title && <h3 class="font-medium">{gallery.title}</h3>}
          {gallery.media.length > 0 && (
            <Carousel class="relative" opts={{ align: "start", loop: gallery.media.length > 1 }}>
              <CarouselContent>
                {gallery.media.map((m) => (
                  <CarouselItem class="basis-full sm:basis-1/2 md:basis-1/3">
                    <div class="overflow-hidden rounded-lg border">
                      <Image
                        src={m.file.url}
                        alt={m.altText}
                        inferSize={true}
                        class="aspect-square w-full object-cover"
                      />
                      {m.caption && (
                        <p class="bg-muted px-3 py-2 text-xs text-muted-foreground">{m.caption}</p>
                      )}
                    </div>
                  </CarouselItem>
                ))}
              </CarouselContent>
              {gallery.media.length > 1 && (
                <>
                  <CarouselPrevious class="left-2" />
                  <CarouselNext class="right-2" />
                </>
              )}
            </Carousel>
          )}
        </div>
      ))}
    </section>
  )}

  {/* Tags */}
  {tags.length > 0 && (
    <footer class="flex flex-wrap items-center gap-2 border-t pt-6">
      <span class="text-sm font-medium text-muted-foreground">Tags :</span>
      {tags.map((tag) => (
        <Badge variant="outline" size="sm" href={buildBlogTagHref(baseUrl, blogT.routes.tags, tag.slug)}>
          {tag.name || tag.slug}
        </Badge>
      ))}
    </footer>
  )}
</article>

<style>
  /* Offset anchored headings so the sticky header never covers them when
     jumping in from the table of contents or a direct #hash link. */
  :global(.sw-prose h2[id]),
  :global(.sw-prose h3[id]) {
    scroll-margin-top: 5.5rem;
  }
</style>
