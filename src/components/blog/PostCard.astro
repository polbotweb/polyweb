---
import { Icon } from "astro-icon/components";
import type { Locale } from "@i18n/config";
import type { BlogTranslations } from "@i18n/config";
import { buildBlogCategoryUrl, buildBlogPostUrl, formatReadingTime, generateExcerpt } from "@/lib/blog/utils";
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from "@atoms/card";
import { Badge } from "@atoms/badge";
import { Button } from "@atoms/button";
import { Image } from "@atoms/image";

interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  post: {
    post: { id: string; viewCount: number; isFeatured: boolean; isSticky: boolean; publishedAt: Date | null };
    translation: { title: string; slug: string; excerpt: string | null; content: string } | null;
    author: { id: string; name: string; image: string | null } | null;
    featuredImage: { id: string; url: string } | null;
    categories: { id: string; slug: string; name: string | null }[];
    commentCount: number;
  };
  baseUrl: string;
  variant?: "initial" | "retro" | "modern" | "compact";
  showCategory?: boolean;
  showAuthor?: boolean;
  showDate?: boolean;
  showExcerpt?: boolean;
}

const { 
  post, 
  blogT, 
  locale,
  variant = "initial",
  showCategory = true,
  showAuthor = true,
  showDate = true,
  showExcerpt = true
} = Astro.props;

const translation = post.translation;
if (!translation) return null;

const excerpt = translation.excerpt || generateExcerpt(translation.content, 160);
const primaryCategorySlug = post.categories[0]?.slug ?? null;
const postUrl = buildBlogPostUrl(locale, null, translation.slug, primaryCategorySlug);
const publishedAt = post.post.publishedAt;
const primaryCategory = post.categories[0];
const readingTime = formatReadingTime(translation.content);
---

<article class="post-card-wrapper">
<Card class:list={["post-card", `post-card--${variant}`]}>
  <a href={postUrl} class="post-card__link">
    <div class="post-card__image-wrap">
      {post.featuredImage ? (
        <Image
          src={post.featuredImage.url}
          alt={translation.title}
          class="post-card__image"
          inferSize={true}
        />
      ) : (
        <div class="post-card__image-placeholder">
          <Icon name="mdi:newspaper-variant-outline" />
        </div>
      )}
      
      {/* Overlay badges */}
      <div class="post-card__badges">
        {post.post.isFeatured && (
          <Badge variant="primary" size="sm">{blogT.labels.featured}</Badge>
        )}
        {post.post.isSticky && (
          <Badge variant="secondary" size="sm">{blogT.labels.sticky}</Badge>
        )}
      </div>
    </div>
  </a>

  <CardHeader class="post-card__header">
    {showCategory && primaryCategory && (
      <div class="post-card__category">
        <Badge variant="outline" size="sm" href={buildBlogCategoryUrl(locale, null, primaryCategory.slug)}>
          {primaryCategory.name ?? primaryCategory.slug}
        </Badge>
      </div>
    )}

    {showDate && publishedAt && (
      <time class="post-card__date" datetime={publishedAt.toISOString()}>
        {publishedAt.toLocaleDateString(locale, { day: 'numeric', month: 'short' })}
      </time>
    )}

    <a href={postUrl} class="post-card__title-link">
      <CardTitle class="post-card__title">
        {translation.title}
      </CardTitle>
    </a>
  </CardHeader>

  {showExcerpt && excerpt && (
    <CardContent class="post-card__content">
      <p class="post-card__excerpt">{excerpt}</p>
    </CardContent>
  )}

  <CardFooter class="post-card__footer">
    <div class="post-card__meta">
      {showAuthor && post.author && (
        <span class="post-card__meta-author">
          {post.author.image ? (
            <img 
              src={post.author.image} 
              alt={post.author.name} 
              class="post-card__author-avatar"
            />
          ) : (
            <Icon name="mdi:account" class="post-card__author-icon" />
          )}
          {post.author.name}
        </span>
      )}
      
      {post.post.viewCount > 0 && (
        <span class="post-card__meta-views">
          <Icon name="mdi:eye" />
          {post.post.viewCount.toLocaleString(locale)}
        </span>
      )}
      
      {post.commentCount > 0 && (
        <span class="post-card__meta-comments">
          <Icon name="mdi:comment-outline" />
          {post.commentCount}
        </span>
      )}
      
      <span class="post-card__meta-reading-time">
        <Icon name="mdi:clock-outline" />
        {readingTime}
      </span>
    </div>

    <Button variant="ghost" size="sm" href={postUrl} class="post-card__read-more">
      {blogT.labels.readMore}
      <Icon name="mdi:arrow-right" class="size-4" />
    </Button>
  </CardFooter>
</Card>
</article>

<style>
  .post-card-wrapper {
    display: contents;
  }

  .post-card { 
    max-width: 400px; 
    box-shadow: none;
    border: 1px solid var(--border-default);
  }
  
  .post-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-card__image-wrap {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .post-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 220ms ease;
  }

  .post-card__link:hover .post-card__image {
    transform: scale(1.03);
  }

  .post-card__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-inset);
  }

  .post-card__image-placeholder :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--text-muted);
  }

  .post-card__badges {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    right: var(--space-3);
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .post-card__header {
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .post-card__category {
    display: flex;
  }

  .post-card__date {
    font-size: 0.8125rem;
    color: var(--text-muted);
    align-self: flex-end;
  }

  .post-card__title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-foreground);
    line-height: 1.3;
  }

  .post-card__title-link {
    text-decoration: none;
    display: inline-block;
    width: 100%;
  }

  .post-card__title-link:hover .post-card__title {
    text-decoration: underline;
  }

  .post-card__content {
    padding-top: 0;
  }

  .post-card__excerpt {
    color: var(--text-muted-foreground);
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .post-card__meta span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .post-card__meta-author {
    font-weight: 500;
    color: var(--text-default);
  }

  .post-card__author-avatar {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    object-fit: cover;
  }

  .post-card__author-icon {
    width: 18px;
    height: 18px;
  }

  .post-card__meta-views :global(svg),
  .post-card__meta-comments :global(svg),
  .post-card__meta-reading-time :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .post-card__read-more {
    margin-left: auto;
  }

  .post-card__read-more :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  /* Variants */
  .post-card--retro .post-card__image-wrap {
    border-radius: var(--radius-lg);
    height: 240px;
  }

  .post-card--retro .post-card__badges {
    top: var(--space-2);
    left: var(--space-2);
    right: var(--space-2);
  }

  .post-card--retro .post-card__title {
    font-size: 1.25rem;
  }

  .post-card--retro .post-card__date {
    font-size: 0.875rem;
  }

  .post-card--compact .post-card__image-wrap {
    height: 180px;
  }

  .post-card--compact .post-card__excerpt {
    -webkit-line-clamp: 2;
  }

  .post-card--modern .post-card__image-wrap {
    border-radius: var(--radius-lg);
    height: 200px;
  }

  .post-card--modern .post-card__badges {
    top: var(--space-2);
    left: var(--space-2);
  }
</style>
