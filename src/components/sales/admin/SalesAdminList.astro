---
/**
 * Liste back-office du domaine sales.
 *
 * Les mutations passent par un module client : un `<form method="post">` enverrait
 * un GET vers l'URL courante, ce qui exposerait les valeurs saisies dans la
 * chaîne de requête, l'historique et les journaux.
 *
 * Actions groupées : barre générique `AdminBulkBar` (core/bulk) — cases par ligne,
 * case « page », compteur annoncé, confirmation modale. Les opérations affichées sont
 * celles de la ressource admin, filtrées par la page selon les permissions.
 *
 * Facettes et vues enregistrées (core/filters) : passer `baseUrl` (Astro.url), les
 * comptes de `loadSalesAdminFacets` et les vues de `loadSavedViews(userId, "sales-document", organizationId)`.
 */
import AdminFacets from "@organisms/AdminFacets.astro";
import AdminSavedViews from "@organisms/AdminSavedViews.astro";
import { canonicalListQuery, facetLinks, type FacetBucket } from "@/core/filters";
import { salesDocumentAdminResource } from "@/modules/sales/admin/resource";
import ForceReleaseLockButton from "@/components/admin/ForceReleaseLockButton.astro";
import AdminBulkBar from "@organisms/AdminBulkBar.astro";
import type { AdminBulkBarOperation } from "@/core/bulk/ui";
import { formatBulk, getBulkUiTranslations } from "@/core/bulk/i18n";
import type { Locale } from "@i18n/config";
import { formatMoney, isCurrencyCode } from "@/core/money";
import { getSalesTranslations } from "@/modules/sales/i18n";
import type { SalesDocumentKind, SalesStatus } from "@/modules/sales/domain/workflow";

interface Props {
  items: Array<{ id: string; kind: SalesDocumentKind; title: string; number: string | null; status: SalesStatus; customerName: string; currency: string; grossMinor: number; issueDate: string | null; dueDate: string | null; lockedByOther?: boolean }>;
  locale: Locale;
  /** Base des liens de fiche (`<base>/<id>`). */
  viewBaseUrl?: string;
  organizationId?: string | null;
  /** Opérations groupées autorisées (dérivées de `salesDocumentAdminResource.list.bulkActions`). */
  bulkOperations?: AdminBulkBarOperation[];
  /** Calculé par la page : `canAdministerTenant(Astro.locals.user, organizationId)` (core/permissions/tenant). */
  canForceReleaseLock?: boolean;
  /** URL courante (Astro.url) : active facettes et vues enregistrées. */
  baseUrl?: URL;
  /** Comptes de facettes (`loadSalesAdminFacets`), chacune sans son propre filtre. */
  facets?: Record<string, readonly FacetBucket[]>;
  /** Vues enregistrées de l'utilisateur pour la ressource « sales-document ». */
  savedViews?: readonly { id: string; name: string; query: string }[];
}

const { items, locale, viewBaseUrl = "", organizationId = null, bulkOperations = [], canForceReleaseLock = false, baseUrl, facets = {}, savedViews = [] } = Astro.props as Props;
const bulkT = getBulkUiTranslations(locale);
const bulkEnabled = bulkOperations.length > 0;
const listDefinition = salesDocumentAdminResource.list!;
const listBaseUrl = baseUrl?.pathname ?? "";
const currentQuery = baseUrl ? canonicalListQuery(listDefinition, baseUrl.searchParams) : "";
const t = getSalesTranslations(locale);
const facetGroups = baseUrl
  ? [
      { id: "kind", label: t.admin.facetKind, links: facetLinks(listDefinition, currentQuery, "kind", facets.kind ?? [], listBaseUrl, (value) => t.kinds[value as SalesDocumentKind] ?? value) },
      { id: "status", label: t.admin.facetStatus, links: facetLinks(listDefinition, currentQuery, "status", facets.status ?? [], listBaseUrl, (value) => t.statuses[value as SalesStatus] ?? value) },
    ]
  : [];
const amount = (minor: number, currency: string) => (isCurrencyCode(currency) ? formatMoney({ amountMinor: minor, currency }, locale) : `${minor} ${currency}`);
const hasFilters = [...new URLSearchParams(currentQuery).keys()].some((key) => key !== "sortBy" && key !== "sortOrder" && key !== "page");
---

{baseUrl && (
  <>
    <AdminFacets locale={locale} groups={facetGroups} clearHref={hasFilters ? listBaseUrl : null} />
    <AdminSavedViews locale={locale} resource="sales-document" organizationId={organizationId} views={savedViews} baseUrl={listBaseUrl} currentQuery={currentQuery} />
  </>
)}

<AdminBulkBar action="sales.bulk" locale={locale} organizationId={organizationId} operations={bulkOperations}>
  <div class="flex flex-col gap-4">
    {items.length === 0 ? (
      <p class="text-sm text-muted-foreground">{t.admin.empty}</p>
    ) : (
      <>
        {bulkEnabled && <label class="flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" class="size-6" data-bulk-page />{bulkT.selectPage}</label>}
        <ul class="flex flex-col gap-2" aria-label={t.admin.listLabel} data-testid="sales-document-list">
          {items.map((item) => (
            <li class="flex flex-wrap items-center justify-between gap-3 border px-4 py-3" data-sales-document={item.id}>
              {bulkEnabled ? (
                <label class="flex min-h-11 items-center gap-2"><input type="checkbox" class="size-6" data-bulk-item value={item.id} aria-label={formatBulk(bulkT.selectRow, { title: item.title })} /><span class="font-medium">{item.title}</span></label>
              ) : <span class="font-medium">{item.title}</span>}
              <dl class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
                <div class="flex gap-1"><dt class="text-muted-foreground">{t.fields.kind}</dt><dd>{t.kinds[item.kind]}</dd></div>
                <div class="flex gap-1"><dt class="text-muted-foreground">{t.fields.number}</dt><dd data-number>{item.number ?? t.admin.draftNumber}</dd></div>
                <div class="flex gap-1"><dt class="text-muted-foreground">{t.fields.customerName}</dt><dd>{item.customerName}</dd></div>
                <div class="flex gap-1"><dt class="text-muted-foreground">{t.fields.gross}</dt><dd>{amount(item.grossMinor, item.currency)}</dd></div>
                {item.dueDate && <div class="flex gap-1"><dt class="text-muted-foreground">{t.fields.dueDate}</dt><dd>{item.dueDate}</dd></div>}
                <div class="flex gap-1"><dt class="text-muted-foreground">{t.fields.status}</dt><dd>{t.statuses[item.status]}</dd></div>
              </dl>
              <div class="flex items-center gap-2">
                {viewBaseUrl && <a class="inline-flex min-h-11 items-center px-3 underline" href={`${viewBaseUrl}/${item.id}`} aria-label={`${t.admin.view} — ${item.number ?? item.title}`}>{t.admin.view}</a>}
                {canForceReleaseLock && item.lockedByOther && <ForceReleaseLockButton resourceType="sales" resourceId={item.id} locale={locale} />}
              </div>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</AdminBulkBar>
