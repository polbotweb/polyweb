---
import type { BlogTranslations, Locale } from "@i18n/config";
import type { AppUser } from "@lib/types";
import type { BlogCommentWithAuthor, BlogReviewWithAuthor } from "@lib/blog/types";
import type { BlogPostListItem } from "@lib/blog/types";
import type { BlogReactionType } from "@lib/blog/constants";
import { extractHeadings } from "@/lib/blog/utils";
import { getBlogValidLinkTargets } from "@database/loaders/blog.loader";
import ArticleProgressBar from "@/components/blog/ArticleProgressBar.astro";
import AuthorCard from "@/components/blog/AuthorCard.astro";
import PostContent from "@/components/blog/PostContent.astro";
import PostGrid from "@/components/blog/grids/PostGrid.astro";
import ReactionBar from "@/components/blog/ReactionBar.astro";
import ShareBar from "@/components/blog/ShareBar.astro";
import CommentSection from "@/components/blog/CommentSection.astro";
import ReviewSection from "@/components/blog/ReviewSection.astro";

interface PostContentData {
  post: {
    id: string;
    publishedAt: Date | null;
    updatedAt?: Date | null;
    viewCount: number;
    commentStatus: "OPEN" | "CLOSED" | "DISABLED";
    allowReviews: boolean;
  };
  translation: { title: string; excerpt?: string | null; content: string } | null;
  author: { id: string; name: string; image: string | null } | null;
  featuredImage: { id: string; url: string; width: number | null; height: number | null } | null;
  categories: { id: string; slug: string; color: string | null; name: string | null }[];
  tags: { id: string; slug: string; color: string | null; name: string | null }[];
  galleries: {
    id: string;
    title: string | null;
    description: string | null;
    sortOrder: number;
    media: { id: string; altText: string; caption: string | null; sortOrder: number; file: { id: string; url: string } }[];
  }[];
}

interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  data: PostContentData;
  comments: BlogCommentWithAuthor[];
  reviews: BlogReviewWithAuthor[];
  reviewStats: { total: number; average: number; distribution: { rating: number; count: number }[] };
  reactionCounts: Record<BlogReactionType, number>;
  relatedPosts: BlogPostListItem[];
  baseUrl: string;
  absoluteUrl: string;
  user: AppUser | null;
  organizationId?: string | null;
}

const {
  locale,
  blogT,
  data,
  comments,
  reviews,
  reviewStats,
  reactionCounts,
  relatedPosts,
  baseUrl,
  absoluteUrl,
  user,
  organizationId,
} = Astro.props;

if (!data.translation) return null;

const { html: articleHtml, headings } = extractHeadings(data.translation.content);
const validTargets = Array.from(await getBlogValidLinkTargets(organizationId ?? null, locale));
const tocHeadings = headings.filter((h) => h.depth <= 3);
const hasToc = tocHeadings.length >= 2;
---

<section class="mx-auto w-full max-w-7xl px-4 py-10 md:px-6 md:py-14" data-blog-post-id={data.post.id}>
  <ArticleProgressBar targetId="blog-article-content" />
  <div class:list={[
    "grid gap-10",
    {"xl:grid-cols-[minmax(0,1fr)_16rem]": hasToc, "mx-auto max-w-4xl": !hasToc},
  ]}>
    {/* Main Content */}
    <div class="flex min-w-0 flex-col gap-8" id="blog-article-content">
      {/* Post Content */}
      <PostContent locale={locale} blogT={blogT} data={data} baseUrl={baseUrl} contentHtml={articleHtml} validTargets={validTargets} />

      {/* Author Card */}
      <AuthorCard
        locale={locale}
        blogT={blogT}
        author={data.author}
        publishedAt={data.post.publishedAt}
        categories={data.categories}
        baseUrl={baseUrl}
      />

      {/* Reaction and Share Bar */}
      <div class="flex flex-col gap-4 rounded-2xl border bg-card/60 px-5 py-4 shadow-sm backdrop-blur lg:flex-row lg:items-center lg:justify-between">
        <ReactionBar blogT={blogT} postId={data.post.id} reactionCounts={reactionCounts} />
        <ShareBar blogT={blogT} url={absoluteUrl} title={data.translation.title} />
      </div>

      {/* Related Posts */}
      {relatedPosts.length > 0 && (
        <section class="flex flex-col gap-4">
          <h2 class="font-heading text-2xl font-semibold">
            {blogT.labels.relatedPosts}
          </h2>
          <PostGrid
            locale={locale}
            blogT={blogT}
            posts={relatedPosts}
            baseUrl={baseUrl}
            variant="grid"
            columns={3}
            showCategory={true}
            showAuthor={true}
            showDate={true}
            showExcerpt={false}
            showViews={true}
            showComments={true}
            showRating={true}
          />
        </section>
      )}

      {/* Comments Section */}
      <CommentSection
        locale={locale}
        blogT={blogT}
        postId={data.post.id}
        comments={comments}
        user={user}
        commentStatus={data.post.commentStatus}
      />

      {/* Reviews Section */}
      <ReviewSection
        locale={locale}
        blogT={blogT}
        postId={data.post.id}
        reviews={reviews}
        stats={reviewStats}
        user={user}
        allowReviews={data.post.allowReviews}
      />
    </div>

    {/* Table of contents */}
    {hasToc && (
      <aside class="hidden xl:block">
        <nav class="sticky top-20" aria-label="Sommaire" id="blog-article-toc">
          <p class="text-xs font-semibold tracking-wide text-muted-foreground uppercase">
            Sur cette page
          </p>
          <ul class="mt-3 space-y-2 border-l text-sm">
            {tocHeadings.map((heading) => (
              <li class:list={[heading.depth === 3 && "pl-4"]}>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link
                  class="-ml-px block border-l-2 border-transparent py-1 pl-4 text-muted-foreground transition-colors hover:text-foreground data-active:border-primary data-active:font-medium data-active:text-foreground"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</section>

<script>
  function initArticleToc() {
    const toc = document.getElementById("blog-article-toc");
    if (!toc) return;

    const links = toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    if (links.length === 0) return;

    const headingIds = Array.from(links).map((link) => link.getAttribute("href")?.slice(1) ?? "");

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((link) => link.removeAttribute("data-active"));
            const activeLink = toc.querySelector<HTMLAnchorElement>(`[href="#${entry.target.id}"]`);
            activeLink?.setAttribute("data-active", "");
          }
        }
      },
      { rootMargin: "0px 0px -70% 0px", threshold: 0 },
    );

    for (const id of headingIds) {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    }
  }

  initArticleToc();
  document.addEventListener("astro:after-swap", initArticleToc);
</script>

<script>
  import { actions } from "astro:actions";

  // Fire-and-forget view recording, once per navigation (client-side so
  // server-rendered prefetches/crawlers don't inflate the count as easily).
  // The action itself de-duplicates repeat visits from the same IP for 30min.
  function recordView() {
    const section = document.querySelector<HTMLElement>("[data-blog-post-id]");
    const postId = section?.dataset.blogPostId;
    if (!postId) return;

    void actions.recordBlogPostView({
      postId,
      referrer: document.referrer || undefined,
    });
  }

  recordView();
  document.addEventListener("astro:after-swap", recordView);
</script>

