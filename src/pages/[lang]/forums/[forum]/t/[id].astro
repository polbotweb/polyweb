---
/**
 * Un sujet : message d'ouverture, réponses paginées, votes / réactions / signalements, solution
 * acceptée, suivi, sondage, participants d'un fil privé, outils de modération (motif obligatoire).
 * Tout refus de lecture (fil privé, forum restreint, contenu masqué, autre site) → 404 indiscernable.
 * Écritures : formulaires POST (champ `intent`) → mêmes services que les actions → 303.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Badge from "@atoms/badge/Badge.astro";
import Button from "@atoms/button/Button.astro";
import { Alert, AlertDescription } from "@atoms/alert";
import { Input } from "@atoms/input";
import { Label } from "@atoms/label";
import { NativeSelect, NativeSelectOption } from "@atoms/native-select";
import { Textarea } from "@atoms/textarea";
import ForumAuthorMeta from "@/components/forums/ForumAuthorMeta.astro";
import ForumBreadcrumbs from "@/components/forums/ForumBreadcrumbs.astro";
import ForumNotice from "@/components/forums/ForumNotice.astro";
import ForumPagination from "@/components/forums/ForumPagination.astro";
import ForumEngagement from "@/components/forums/ForumEngagement.astro";
import ForumContent from "@/components/forums/ForumContent.astro";
import ForumPoll from "@/components/forums/ForumPoll.astro";
import { getAuthTranslations, getAuthUrl, toLocale } from "@i18n/utils";
import { runApp, runAppResult } from "@/lib/effect/http";
import { ensureDefaultSite } from "@/modules/sites/domain/sites";
import { topicAccess } from "@/modules/forums/services/access";
import { listForumCategories, listSiteForums } from "@/modules/forums/services/forum.service";
import { topicDetail } from "@/modules/forums/loaders";
import { categoryLabel } from "@/modules/forums/domain/defaults";
import { BODY_MAX, clampPage, NOTE_MAX, NOTE_MIN } from "@/modules/forums/domain/rules";
import { handleTopicForm } from "@/modules/forums/web/forms";
import { fillForums, getForumsTranslations } from "@/modules/forums/i18n";

export const prerender = false;
const locale = toLocale(Astro.params.lang);
const t = getForumsTranslations(locale);
const site = Astro.locals.site ?? (await ensureDefaultSite());
const viewer = Astro.locals.user ?? null;
const topicId = (Astro.params.id ?? "").slice(0, 64);
const access = await runAppResult(topicAccess(topicId, viewer));
if (!access.ok || access.value.forum.siteId !== site.id) { Astro.response.status = 404; return Astro.rewrite("/404"); }
const { forum, manager } = access.value;
const self = `/${locale}/forums/${forum.slug}/t/${topicId}`;
if (Astro.params.forum !== forum.slug) return Astro.redirect(self, 301);
Astro.response.headers.set("Cache-Control", "private, no-store");

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") ?? "");
  const result = await handleTopicForm(form, { topicId, viewer, context: Astro });
  const back = intent === "leave" && result.ok ? `/${locale}/forums/${forum.slug}` : self;
  const anchor = intent === "reply" && !result.ok ? "#reply" : "";
  return Astro.redirect(result.ok ? `${back}?notice=${result.notice}` : `${self}?error=${result.error}${anchor}`, 303);
}

const page = clampPage(Astro.url.searchParams.get("page"));
const detail = await runApp(topicDetail({ access: access.value, viewer, page, locale }));
const { topic, poll } = detail;
const signedIn = Boolean(viewer && !viewer.banned);
const isAuthor = Boolean(viewer && topic.authorId === viewer.id);
const canAccept = signedIn && (isAuthor || manager);
const canReply = signedIn && topic.status === "visible" && (!topic.locked || manager);
const fmt = new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeStyle: "short" });
const authorLine = (id: string | null, name: string | null) => {
  const a = id ? detail.authors[id] : undefined;
  return { name: name ?? "—", reputation: a?.reputation ?? 0, badges: (a?.badges ?? []).map((b) => (t.badges as Record<string, string>)[b] ?? b) };
};
const moveTargets = manager
  ? await (async () => {
      const forums = (await runApp(listSiteForums(site.id))).filter((f) => f.id === forum.id || f.organizationId === forum.organizationId);
      const categories = await runApp(listForumCategories(forums.map((f) => f.id)));
      return categories.map((c) => ({ id: c.id, label: `${forums.find((f) => f.id === c.forumId)?.title ?? ""} › ${categoryLabel(c.translations, locale, c.slug).name}` }));
    })()
  : [];
const signInUrl = getAuthUrl(locale, "sign-in", await getAuthTranslations(locale));
const opener = authorLine(topic.authorId, topic.authorName);
const crumbs = [
  { href: `/${locale}/forums`, label: t.backToForums },
  { href: `/${locale}/forums/${forum.slug}`, label: forum.title },
  ...(detail.category ? [{ href: `/${locale}/forums/${forum.slug}?category=${detail.category.slug}`, label: detail.category.name }] : []),
  { label: topic.title },
];
---
<BaseLayout title={`${topic.title} — ${forum.title}`} description={forum.description ?? t.intro}>
  <main class="mx-auto grid max-w-4xl gap-6 px-4 py-12 sm:px-6 lg:px-8" data-testid="topic-page">
    <ForumBreadcrumbs label={t.breadcrumb} items={crumbs} />
    <ForumNotice t={t} url={Astro.url} />

    <article aria-labelledby="topic-title" class="grid gap-4 rounded-xl border bg-card p-5" data-testid="topic">
      <header class="grid gap-2">
        <h1 id="topic-title" class="font-heading text-3xl font-bold">{topic.title}</h1>
        <div class="flex flex-wrap gap-1">
          {topic.pinned && <Badge variant="primary" size="sm">{t.pinned}</Badge>}
          {topic.locked && <Badge variant="outline" size="sm" data-testid="topic-locked">{t.locked}</Badge>}
          {topic.acceptedPostId && <Badge variant="success" size="sm">{t.solved}</Badge>}
          {topic.isPrivate && <Badge variant="secondary" size="sm">{t.private}</Badge>}
        </div>
        <ForumAuthorMeta t={t} name={opener.name} reputation={opener.reputation} badges={opener.badges} datetime={topic.createdAt} fmt={fmt} />
        {detail.tags.length > 0 && (
          <ul class="flex flex-wrap gap-1" aria-label={t.tagsLabel}>
            {detail.tags.map((tag) => (
              <li><Badge href={`/${locale}/forums/${forum.slug}?tag=${tag.slug}`} variant="outline" size="sm">#{tag.label}</Badge></li>
            ))}
          </ul>
        )}
      </header>
      {topic.status !== "visible" && (
        <Alert variant="warning" role="note">
          <AlertDescription>{t.hiddenNotice}</AlertDescription>
        </Alert>
      )}
      <ForumContent html={topic.bodyHtml} />
      <ForumEngagement t={t} targetType="topic" targetId={topic.id} score={topic.score} myVote={topic.myVote} reactions={topic.reactions} signedIn={signedIn && topic.status === "visible"} own={isAuthor} />
      {signedIn && (
        <form method="post">
          <input type="hidden" name="intent" value="follow" /><input type="hidden" name="follow" value={detail.following ? "0" : "1"} />
          <Button type="submit" variant={detail.following ? "secondary" : "outline"} size="sm" aria-pressed={detail.following ? "true" : "false"} data-testid="follow">{detail.following ? t.unfollow : t.follow}</Button>
        </form>
      )}
    </article>

    {poll && <ForumPoll t={t} poll={poll} fmt={fmt} canVote={signedIn && !poll.voted && !poll.closed && topic.status === "visible"} />}

    {topic.isPrivate && (
      <section aria-labelledby="participants-title" class="grid gap-3 rounded-xl border bg-card p-5" data-testid="participants">
        <h2 id="participants-title" class="font-heading text-xl font-semibold">{t.participants}</h2>
        <ul class="flex flex-wrap gap-2">
          {detail.participants.map((p) => (
            <li><Badge variant="outline" size="sm">{p.name}{p.username ? ` (@${p.username})` : ""}</Badge></li>
          ))}
        </ul>
        {access.value.participant && (
          <div class="flex flex-wrap items-end gap-3">
            <form method="post" class="flex flex-wrap items-end gap-2">
              <input type="hidden" name="intent" value="invite" />
              <div class="grid gap-1">
                <Label for="invite-username">{t.inviteLabel}</Label>
                <Input id="invite-username" name="username" required maxlength="64" autocomplete="off" />
              </div>
              <Button type="submit" variant="outline" size="sm">{t.invite}</Button>
            </form>
            <form method="post">
              <input type="hidden" name="intent" value="leave" />
              <Button type="submit" variant="outline" size="sm">{t.leave}</Button>
            </form>
          </div>
        )}
      </section>
    )}

    <section aria-labelledby="replies-title" class="grid gap-4">
      <h2 id="replies-title" class="font-heading text-xl font-semibold">{fillForums(t.replies, { count: detail.totalPosts })}</h2>
      <ol class="grid gap-4" data-testid="posts">
        {detail.posts.map((post) => {
          const author = authorLine(post.authorId, post.authorName);
          const own = Boolean(viewer && post.authorId === viewer.id);
          return (
            <li id={`post-${post.id}`} class:list={["grid gap-3 rounded-xl border bg-card p-4", post.accepted && "border-primary"]} data-post={post.id}>
              {post.accepted && <Badge variant="success" size="sm" data-testid="accepted">{t.acceptedAnswer}</Badge>}
              <ForumAuthorMeta t={t} name={author.name} reputation={author.reputation} badges={author.badges} datetime={post.createdAt} fmt={fmt} />
              <ForumContent html={post.bodyHtml} />
              <div class="flex flex-wrap items-center gap-3">
                <ForumEngagement t={t} targetType="post" targetId={post.id} score={post.score} myVote={post.myVote} reactions={post.reactions} signedIn={signedIn && topic.status === "visible"} own={own} />
                {canAccept && topic.status === "visible" && (
                  <form method="post">
                    <input type="hidden" name="intent" value="accept" /><input type="hidden" name="postId" value={post.accepted ? "" : post.id} />
                    <Button type="submit" variant="outline" size="sm" data-testid="accept">{post.accepted ? t.unaccept : t.accept}</Button>
                  </form>
                )}
              </div>
            </li>
          );
        })}
      </ol>
      <ForumPagination t={t} url={Astro.url} page={page} total={detail.totalPosts} pageSize={detail.pageSize} />
    </section>

    <section id="reply" aria-labelledby="reply-title" class="rounded-xl border bg-card p-5">
      <h2 id="reply-title" class="mb-3 font-heading text-xl font-semibold">{t.reply}</h2>
      {!signedIn ? <p><a class="underline underline-offset-4" href={signInUrl}>{t.signInToPost}</a></p>
        : topic.locked && !manager ? (
          <Alert variant="warning" data-testid="locked-notice" role="note">
            <AlertDescription>{t.lockedNotice}</AlertDescription>
          </Alert>
        )
        : canReply ? (
          <form method="post" class="grid gap-3" data-testid="reply-form">
            <input type="hidden" name="intent" value="reply" />
            <div class="grid gap-1">
              <Label for="reply-body">{t.replyLabel}</Label>
              <Textarea id="reply-body" name="body" required minlength="2" maxlength={BODY_MAX} rows={6} aria-describedby="reply-md-help" />
            </div>
            <p id="reply-md-help" class="text-sm text-muted-foreground">{t.markdownHelp}</p>
            <Button type="submit" variant="primary" class="w-fit" data-testid="reply-submit">{t.submitReply}</Button>
          </form>
        ) : null}
    </section>

    {manager && (
      <section aria-labelledby="mod-title" class="rounded-xl border border-dashed bg-card p-5" data-testid="moderator-tools">
        <h2 id="mod-title" class="mb-3 font-heading text-xl font-semibold">{t.moderatorTools}</h2>
        <form method="post" class="grid gap-3 sm:grid-cols-2">
          <input type="hidden" name="intent" value="moderate" />
          <div class="grid gap-1">
            <Label for="mod-tool">{t.toolLabel}</Label>
            <NativeSelect id="mod-tool" name="tool" class="w-full">
              <NativeSelectOption value={topic.locked ? "unlock" : "lock"}>{topic.locked ? t.unlock : t.lock}</NativeSelectOption>
              <NativeSelectOption value={topic.pinned ? "unpin" : "pin"}>{topic.pinned ? t.unpin : t.pin}</NativeSelectOption>
              <NativeSelectOption value="move">{t.move}</NativeSelectOption>
            </NativeSelect>
          </div>
          <div class="grid gap-1">
            <Label for="mod-move">{t.moveTo}</Label>
            <NativeSelect id="mod-move" name="categoryId" class="w-full">
              {moveTargets.map((c) => <NativeSelectOption value={c.id} selected={c.id === detail.category?.id}>{c.label}</NativeSelectOption>)}
            </NativeSelect>
          </div>
          <div class="grid gap-1 sm:col-span-2">
            <Label for="mod-note">{t.note}</Label>
            <Input id="mod-note" name="note" required minlength={NOTE_MIN} maxlength={NOTE_MAX} />
          </div>
          <Button type="submit" variant="outline" size="sm" class="w-fit" data-testid="moderate-submit">{t.apply}</Button>
        </form>
      </section>
    )}
  </main>
</BaseLayout>
