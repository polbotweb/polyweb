---
import { eq } from "drizzle-orm";
import { LOCALES } from "@i18n/config";
import { toLocale, getBlogTranslations } from "@i18n/utils";
import { getDrizzle } from "@database/drizzle";
import { organization } from "@database/schemas";
import {
  getBlogCategories,
  getBlogCategoryBySlug,
  getBlogComments,
  getBlogPostBySlug,
  getBlogPostForAdmin,
  getBlogPosts,
  getRelatedBlogPosts,
  getBlogReviews,
  getBlogReviewStats,
  getBlogTags,
  getBlogTagBySlug,
  getBlogAuthorByUsername,
} from "@database/loaders/blog.loader";
import type { BlogReactionType } from "@/lib/blog/constants";
import type { BlogPostTranslation } from "@/lib/blog/types";
import { buildBlogCategoryUrl, buildBlogPostUrl, buildBlogTagUrl, buildBreadcrumbSchema, generateSchemaMarkup } from "@/lib/blog/utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogListingPage from "@pages/blog/BlogListingPage.astro";
import BlogPostPage from "@pages/blog/BlogPostPage.astro";
import BlogAuthorPage from "@pages/blog/BlogAuthorPage.astro";

export const prerender = false;

const locale = toLocale(Astro.params.lang);
const orgSlug = Astro.params.organization;
const blogT = await getBlogTranslations(locale);
const slugParam = `${blogT.routes.author}/${Astro.params.username}`;

if (!orgSlug || !slugParam) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const db = getDrizzle();
const [org] = await db
  .select({ id: organization.id, name: organization.name, slug: organization.slug })
  .from(organization)
  .where(eq(organization.slug, orgSlug))
  .limit(1);

if (!org) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const baseUrl = `/${locale}/${org.slug}/${blogT.routes.blog}`;
const segments = slugParam.split("/").filter(Boolean);
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const searchQuery = Astro.url.searchParams.get("q")?.trim() || undefined;
const user = Astro.locals.user ?? null;
const isLegacyCategoryRoute = segments.length === 2
  && (segments[0] === blogT.routes.categories || segments[0] === "categories");
const isTagRoute = segments.length === 2
  && (segments[0] === blogT.routes.tags || segments[0] === "tags");
const isAuthorRoute = segments.length === 2
  && (segments[0] === blogT.routes.author || segments[0] === "author");
const isCategorizedPostRoute = segments.length === 2 && !isLegacyCategoryRoute && !isTagRoute && !isAuthorRoute;

interface ListingState {
  title: string;
  description: string;
  posts: Awaited<ReturnType<typeof getBlogPosts>>["items"];
  meta: Awaited<ReturnType<typeof getBlogPosts>>["meta"];
  activeCategorySlug?: string;
  activeTagSlug?: string;
}

interface PostState {
  data: NonNullable<Awaited<ReturnType<typeof getBlogPostBySlug>>>;
  comments: Awaited<ReturnType<typeof getBlogComments>>;
  reviews: Awaited<ReturnType<typeof getBlogReviews>>;
  reviewStats: Awaited<ReturnType<typeof getBlogReviewStats>>;
  reactionCounts: Record<BlogReactionType, number>;
  relatedPosts: Awaited<ReturnType<typeof getRelatedBlogPosts>>;
}

interface AuthorState {
  author: NonNullable<Awaited<ReturnType<typeof getBlogAuthorByUsername>>>;
  posts: Awaited<ReturnType<typeof getBlogPosts>>["items"];
  meta: Awaited<ReturnType<typeof getBlogPosts>>["meta"];
}

const [categoryRows, tagRows] = await Promise.all([
  getBlogCategories(org.id, locale),
  getBlogTags(org.id, locale),
]);

const categories = categoryRows.map((item) => ({
  id: item.id,
  slug: item.slug,
  name: item.translation?.name ?? item.slug,
  postCount: item.postCount,
  color: item.color,
  icon: item.icon,
}));

const tags = tagRows.map((item) => ({
  id: item.id,
  slug: item.slug,
  name: item.translation?.name ?? item.slug,
  postCount: item.postCount,
  color: item.color,
}));

let pageTitle = `${blogT.meta.title} — ${org.name}`;
let pageDescription = blogT.meta.description;
let pageAlternateUrls: Record<string, string> | undefined;
let pageOgImage: string | undefined;
let pageOgType = "blog";
let pageJsonLd: string | undefined;
let listingState: ListingState | null = null;
let postState: PostState | null = null;
let authorState: AuthorState | null = null;

async function getAlternateCategorySlugs(categoryId: string | null): Promise<Record<string, string | null>> {
  const entries = await Promise.all(
    LOCALES.map(async (loc) => {
      if (!categoryId) return [loc, null] as const;
      const rows = await getBlogCategories(org.id, loc);
      const match = rows.find((item) => item.id === categoryId);
      return [loc, match?.slug ?? null] as const;
    }),
  );

  return Object.fromEntries(entries);
}

async function getAlternateTagSlugs(tagId: string): Promise<Record<string, string | null>> {
  const entries = await Promise.all(
    LOCALES.map(async (loc) => {
      const rows = await getBlogTags(org.id, loc);
      const match = rows.find((item) => item.id === tagId);
      return [loc, match?.slug ?? null] as const;
    }),
  );

  return Object.fromEntries(entries);
}

if (isLegacyCategoryRoute) {
  return Astro.redirect(`${buildBlogCategoryUrl(locale, org.slug, segments[1])}${Astro.url.search}`, 301);
}

if (isCategorizedPostRoute) {
  const category = await getBlogCategoryBySlug(org.id, locale, segments[0]);

  if (!category) {
    Astro.response.status = 404;
    return Astro.rewrite('/404');
  }

  const data = await getBlogPostBySlug(org.id, locale, segments[1]);

  if (!data || !data.translation || !data.categories.some((item) => item.id === category.category.id)) {
    Astro.response.status = 404;
    return Astro.rewrite('/404');
  }

  const [comments, reviews, reviewStats, relatedPosts, postAdminData, alternateCategorySlugs] = await Promise.all([
    getBlogComments(data.post.id),
    getBlogReviews(data.post.id, { userId: user?.id }),
    getBlogReviewStats(data.post.id),
    getRelatedBlogPosts(
      org.id,
      locale,
      data.post.id,
      data.categories.map((item) => item.id),
      data.tags.map((item) => item.id),
      3,
    ),
    getBlogPostForAdmin(data.post.id),
    getAlternateCategorySlugs(category.category.id),
  ]);

  const alternateEntries = await Promise.all(
    LOCALES.map(async (loc) => {
      const translation = postAdminData?.translations.find((item: BlogPostTranslation) => item.locale === loc);
      const categorySlug = alternateCategorySlugs[loc];
      return translation
        ? [loc, buildBlogPostUrl(loc, org.slug, translation.slug, categorySlug)]
        : null;
    }),
  );

  const reactionCounts = data.reactionCounts.reduce((acc, entry) => {
    acc[entry.reactionType as BlogReactionType] = Number(entry.count);
    return acc;
  }, {
    LIKE: 0,
    LOVE: 0,
    FIRE: 0,
    CLAP: 0,
    LAUGH: 0,
    SAD: 0,
  } as Record<BlogReactionType, number>);

  pageTitle = `${blogT.meta.postTitle(data.translation.title)} — ${org.name}`;
  pageDescription = data.translation.metaDescription ?? data.translation.excerpt ?? blogT.meta.description;
  pageAlternateUrls = Object.fromEntries(
    alternateEntries.filter((entry): entry is [string, string] => entry !== null),
  );
  pageOgImage = data.ogImage?.url ?? data.featuredImage?.url ?? undefined;
  pageOgType = "article";

  const breadcrumb = buildBreadcrumbSchema(locale, [
    { name: org.name, item: baseUrl },
    {
      name: category.translation?.name ?? category.category.slug,
      item: buildBlogCategoryUrl(locale, org.slug, category.translation?.slug ?? category.category.slug),
    },
    { name: data.translation.title, item: Astro.url.href },
  ]);
  const postSchema = generateSchemaMarkup("BlogPosting", {
    headline: data.translation.title,
    description: pageDescription,
    url: Astro.url.href,
    inLanguage: locale,
    datePublished: data.post.publishedAt?.toISOString(),
    dateModified: data.post.updatedAt?.toISOString?.() ?? undefined,
    author: data.author ? { "@type": "Person", name: data.author.name } : undefined,
    publisher: { "@type": "Organization", name: org.name },
    image: pageOgImage,
    articleSection: data.categories.map((item) => item.name ?? item.slug),
    keywords: data.tags.map((item) => item.name ?? item.slug).join(", "),
  });

  pageJsonLd = JSON.stringify([postSchema, breadcrumb]);
  postState = {
    data,
    comments,
    reviews,
    reviewStats,
    reactionCounts,
    relatedPosts,
  };
} else if (segments.length === 1) {
  const category = await getBlogCategoryBySlug(org.id, locale, segments[0]);

  if (category) {
    const { items, meta } = await getBlogPosts(org.id, locale, {
      page,
      searchQuery,
      categorySlug: segments[0],
    });

    const alternateCategorySlugs = await getAlternateCategorySlugs(category.category.id);
    pageTitle = `${blogT.meta.categoryTitle(category.translation?.name ?? category.category.slug)} — ${org.name}`;
    pageDescription = category.translation?.description ?? blogT.meta.description;
    pageAlternateUrls = Object.fromEntries(
      LOCALES.flatMap((loc) => {
        const slug = alternateCategorySlugs[loc];
        return slug ? [[loc, buildBlogCategoryUrl(loc, org.slug, slug)]] : [];
      }),
    );
    pageJsonLd = JSON.stringify([
      buildBreadcrumbSchema(locale, [
        { name: org.name, item: baseUrl },
        { name: category.translation?.name ?? category.category.slug, item: Astro.url.href },
      ]),
    ]);

    listingState = {
      title: pageTitle,
      description: pageDescription,
      posts: items,
      meta,
      activeCategorySlug: segments[0],
    };
  } else {
    const data = await getBlogPostBySlug(org.id, locale, segments[0]);

    if (!data || !data.translation) {
      Astro.response.status = 404;
      return Astro.rewrite('/404');
    }

    if (data.categories[0]?.slug) {
      return Astro.redirect(
        `${buildBlogPostUrl(locale, org.slug, data.translation.slug, data.categories[0].slug)}${Astro.url.search}`,
        301,
      );
    }

    const [comments, reviews, reviewStats, relatedPosts, postAdminData] = await Promise.all([
      getBlogComments(data.post.id),
      getBlogReviews(data.post.id, { userId: user?.id }),
      getBlogReviewStats(data.post.id),
      getRelatedBlogPosts(
        org.id,
        locale,
        data.post.id,
        data.categories.map((item) => item.id),
        data.tags.map((item) => item.id),
        3,
      ),
      getBlogPostForAdmin(data.post.id),
    ]);

    const alternateEntries = await Promise.all(
      LOCALES.map(async (loc) => {
        const translation = postAdminData?.translations.find((item: BlogPostTranslation) => item.locale === loc);
        return translation ? [loc, buildBlogPostUrl(loc, org.slug, translation.slug)] : null;
      }),
    );

    const reactionCounts = data.reactionCounts.reduce((acc, entry) => {
      acc[entry.reactionType as BlogReactionType] = Number(entry.count);
      return acc;
    }, {
      LIKE: 0,
      LOVE: 0,
      FIRE: 0,
      CLAP: 0,
      LAUGH: 0,
      SAD: 0,
    } as Record<BlogReactionType, number>);

    pageTitle = `${blogT.meta.postTitle(data.translation.title)} — ${org.name}`;
    pageDescription = data.translation.metaDescription ?? data.translation.excerpt ?? blogT.meta.description;
    pageAlternateUrls = Object.fromEntries(
      alternateEntries.filter((entry): entry is [string, string] => entry !== null),
    );
    pageOgImage = data.ogImage?.url ?? data.featuredImage?.url ?? undefined;
    pageOgType = "article";

    const breadcrumb = buildBreadcrumbSchema(locale, [
      { name: org.name, item: baseUrl },
      { name: data.translation.title, item: Astro.url.href },
    ]);
    const postSchema = generateSchemaMarkup("BlogPosting", {
      headline: data.translation.title,
      description: pageDescription,
      url: Astro.url.href,
      inLanguage: locale,
      datePublished: data.post.publishedAt?.toISOString(),
      dateModified: data.post.updatedAt?.toISOString?.() ?? undefined,
      author: data.author ? { "@type": "Person", name: data.author.name } : undefined,
      publisher: { "@type": "Organization", name: org.name },
      image: pageOgImage,
      articleSection: data.categories.map((item) => item.name ?? item.slug),
      keywords: data.tags.map((item) => item.name ?? item.slug).join(", "),
    });

    pageJsonLd = JSON.stringify([postSchema, breadcrumb]);
    postState = {
      data,
      comments,
      reviews,
      reviewStats,
      reactionCounts,
      relatedPosts,
    };
  }
} else if (isTagRoute) {
  const tag = await getBlogTagBySlug(org.id, locale, segments[1]);

  if (!tag) {
    Astro.response.status = 404;
    return Astro.rewrite('/404');
  }

  const { items, meta } = await getBlogPosts(org.id, locale, {
    page,
    searchQuery,
    tagSlug: segments[1],
  });

  const alternateTagSlugs = await getAlternateTagSlugs(tag.tag.id);
  pageTitle = `${blogT.meta.tagTitle(tag.translation?.name ?? tag.tag.slug)} — ${org.name}`;
  pageDescription = blogT.meta.description;
  const alternateTagEntries = await Promise.all(
    LOCALES.map(async (loc) => {
      const slug = alternateTagSlugs[loc];
      if (!slug) return null;
      const locBlogT = await getBlogTranslations(loc);
      return [loc, buildBlogTagUrl(loc, org.slug, locBlogT.routes.tags, slug)] as const;
    }),
  );
  const compactAlternateTagEntries = alternateTagEntries.reduce<Array<readonly [string, string]>>((acc, entry) => {
    if (entry) acc.push(entry);
    return acc;
  }, []);
  pageAlternateUrls = Object.fromEntries(
    compactAlternateTagEntries,
  );
  pageJsonLd = JSON.stringify([
    buildBreadcrumbSchema(locale, [
      { name: org.name, item: baseUrl },
      { name: tag.translation?.name ?? tag.tag.slug, item: Astro.url.href },
    ]),
  ]);

  listingState = {
    title: pageTitle,
    description: pageDescription,
    posts: items,
    meta,
    activeTagSlug: segments[1],
  };
} else if (isAuthorRoute) {
  const author = await getBlogAuthorByUsername(org.id, segments[1]);

  if (!author) {
    Astro.response.status = 404;
    return Astro.rewrite('/404');
  }

  const { items, meta } = await getBlogPosts(org.id, locale, {
    page,
    searchQuery,
    authorId: author.id,
  });

  pageTitle = `${author.name} — ${org.name}`;
  pageDescription = blogT.meta.description;
  pageJsonLd = JSON.stringify([
    buildBreadcrumbSchema(locale, [
      { name: org.name, item: baseUrl },
      { name: author.name, item: Astro.url.href },
    ]),
  ]);

  authorState = { author, posts: items, meta };
} else {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  alternateUrls={pageAlternateUrls}
  ogImage={pageOgImage}
  ogType={pageOgType}
  jsonLd={pageJsonLd}
>
  {postState ? (
    <BlogPostPage
      locale={locale}
      blogT={blogT}
      data={postState.data as never}
      comments={postState.comments as never}
      reviews={postState.reviews as never}
      reviewStats={postState.reviewStats}
      reactionCounts={postState.reactionCounts}
      relatedPosts={postState.relatedPosts}
      baseUrl={baseUrl}
      absoluteUrl={Astro.url.href}
      user={user}
      organizationId={org.id}
    />
  ) : listingState ? (
    <BlogListingPage
      locale={locale}
      blogT={blogT}
      title={listingState.title}
      description={listingState.description}
      posts={listingState.posts as never}
      meta={listingState.meta}
      categories={categories}
      tags={tags}
      baseUrl={baseUrl}
      organizationSlug={org.slug}
      searchQuery={searchQuery}
      activeCategorySlug={listingState.activeCategorySlug}
      activeTagSlug={listingState.activeTagSlug}
      organizationName={org.name}
    />
  ) : authorState ? (
    <BlogAuthorPage
      locale={locale}
      blogT={blogT}
      author={{
        id: authorState.author.id,
        name: authorState.author.name,
        image: authorState.author.image,
        bio: null,
        website: null,
        twitter: null,
        linkedin: null,
      }}
      posts={authorState.posts as never}
      meta={authorState.meta}
      categories={categories}
      tags={tags}
      baseUrl={baseUrl}
      searchQuery={searchQuery}
      organizationName={org.name}
    />
  ) : null}
</BaseLayout>