---
import BaseLayout from "@layouts/BaseLayout.astro"; import { getDrizzle } from "@database/drizzle"; import { organization } from "@database/schemas"; import { eq } from "drizzle-orm"; import { getServices,getServiceCategories } from "@/modules/services/loaders"; import ServicesListingPage from "@/modules/services/components/lists/ServicesListingPage.astro"; import { getServiceTranslations } from "@/modules/services/i18n"; import type { Locale } from "@i18n/config";
export const prerender=false; const locale=(Astro.params.lang ?? "fr") as Locale; const slug=Astro.params.organization!; const [org]=await getDrizzle().select({id:organization.id,name:organization.name,slug:organization.slug}).from(organization).where(eq(organization.slug,slug)).limit(1); if(!org) return Astro.redirect(`/${locale}/services`); const t=getServiceTranslations(locale); const page=Math.max(1,Number(Astro.url.searchParams.get("page") ?? "1") || 1); const search=Astro.url.searchParams.get("search") ?? ""; const [data,rows]=await Promise.all([getServices({organizationId:org.id,page,search:search || undefined},locale,true),getServiceCategories(locale,org.id)]); const categories=rows.map((row)=>({slug:row.translation?.slug ?? row.category.slug,name:row.translation?.name ?? row.category.slug}));
---
<BaseLayout title={`${t.labels.services} - ${org.name}`} description={t.meta.description}><main><ServicesListingPage locale={locale} title={t.labels.services} items={data.items} meta={data} baseUrl={`/${locale}/${org.slug}/services`} categories={categories} organizationSlug={org.slug} organizationName={org.name} searchQuery={search} /></main></BaseLayout>
