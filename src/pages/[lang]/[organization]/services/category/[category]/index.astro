---
import BaseLayout from "@layouts/BaseLayout.astro"; import { getDrizzle } from "@database/drizzle"; import { organization } from "@database/schemas"; import { eq } from "drizzle-orm"; import { getServices,getServiceCategories } from "@/modules/services/loaders"; import ServicesListingPage from "@/modules/services/components/lists/ServicesListingPage.astro"; import { getServiceTranslations } from "@/modules/services/i18n"; import { buildServiceCategoryUrl } from "@/modules/services/utils"; import type { Locale } from "@i18n/config";
export const prerender=false; const locale=(Astro.params.lang ?? "fr") as Locale; const orgSlug=Astro.params.organization!; const categorySlug=Astro.params.category!; const [org]=await getDrizzle().select({id:organization.id,name:organization.name,slug:organization.slug}).from(organization).where(eq(organization.slug,orgSlug)).limit(1); if(!org) return Astro.redirect(`/${locale}/services`); const t=getServiceTranslations(locale); const rows=await getServiceCategories(locale,org.id); const category=rows.find((row)=>(row.translation?.slug ?? row.category.slug)===categorySlug); if(!category) return Astro.redirect(`/${locale}/${orgSlug}/services`); const page=Math.max(1,Number(Astro.url.searchParams.get("page") ?? "1") || 1); const data=await getServices({organizationId:org.id,categoryId:category.category.id,page},locale,true); const categories=rows.map((row)=>({slug:row.translation?.slug ?? row.category.slug,name:row.translation?.name ?? row.category.slug}));
---
<BaseLayout title={`${category.translation?.name ?? category.category.slug} - ${org.name}`} description={category.translation?.description ?? t.meta.description}><main><ServicesListingPage locale={locale} title={category.translation?.name ?? category.category.slug} items={data.items} meta={data} baseUrl={buildServiceCategoryUrl(locale,org.slug,categorySlug)} categories={categories} organizationSlug={org.slug} organizationName={org.name} activeCategorySlug={categorySlug} /></main></BaseLayout>
