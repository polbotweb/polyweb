---
export const prerender = false;
const locale = Astro.params.lang ?? "fr";
const organization = Astro.params.organization;
const id = Astro.params.id;
if (!organization || !id) return Astro.redirect(`/${locale}/admin/blog`);
return Astro.rewrite(`/${locale}/organizations/${organization}/admin/blog/${id}/edit${Astro.url.search}`);
---
