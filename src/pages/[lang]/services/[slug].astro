---
import JsonLd from "@/components/seo/JsonLd.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getServiceBySlug } from "@/modules/services/loaders";
import { ServiceDetail } from "@/modules/services/components/single";
import { buildServiceJsonLd } from "@/modules/services/seo";
import { buildServiceUrl } from "@/modules/services/utils";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";

export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const slug = Astro.params.slug;
if (!slug) return Astro.redirect(`/${locale}/services`);

const item = await getServiceBySlug(slug, locale, null);
if (!item) return Astro.redirect(`/${locale}/services`);

const t = getServiceTranslations(locale);
const title = item.translation?.title ?? t.labels.service;
const description = item.translation?.excerpt ?? item.translation?.metaDescription ?? t.meta.description;
const canonicalUrl = buildServiceUrl(locale, null, item.translation?.slug ?? item.service.slug);
const canonicalHref = new URL(canonicalUrl, Astro.url.origin).href;
const jsonLd = buildServiceJsonLd({
  name: title,
  description,
  slug: canonicalHref,
  priceMinor: item.service.priceMinor,
  currency: item.service.currency,
  ratingAverage100: item.service.ratingAverage100,
  ratingCount: item.service.ratingCount,
});
---
<BaseLayout title={`${title} — ${t.meta.title}`} description={description}>
  <link rel="canonical" href={canonicalHref} />
  <JsonLd data={jsonLd} />
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <ServiceDetail item={item} locale={locale} />
  </main>
</BaseLayout>
