---
import JsonLd from "@/components/seo/JsonLd.astro";
import BaseLayout from "@layouts/BaseLayout.astro"; import { getServiceBySlug } from "@/modules/services/loaders"; import { ServiceDetail } from "@/modules/services/components/single"; import { buildServiceJsonLd } from "@/modules/services/seo"; import { buildServiceUrl } from "@/modules/services/utils";  import { getServiceTranslations } from "@/modules/services/i18n"; import type { Locale } from "@i18n/config";
export const prerender=false; const locale=(Astro.params.lang ?? "fr") as Locale; const category=Astro.params.category!; const slug=Astro.params.slug!; const item=await getServiceBySlug(slug,locale,null,category); if(!item){ /* Mauvaise catégorie : redirection 301 vers l'URL canonique du service s'il existe. */ const found=await getServiceBySlug(slug,locale,null); if(found) return Astro.redirect(buildServiceUrl(locale,null,found.translation?.slug ?? found.service.slug,found.categories[0]?.slug ?? null),301); return Astro.redirect(`/${locale}/services`); } const t=getServiceTranslations(locale); const title=item.translation?.title ?? t.labels.service; const description=item.translation?.excerpt ?? t.meta.description; const canonical=buildServiceUrl(locale,null,item.translation?.slug ?? item.service.slug,category); const jsonLd=buildServiceJsonLd({name:title,description,slug:new URL(canonical,Astro.url.origin).href,priceMinor:item.service.priceMinor,currency:item.service.currency,ratingAverage100:item.service.ratingAverage100,ratingCount:item.service.ratingCount});
---
<BaseLayout title={title} description={description}><link rel="canonical" href={new URL(canonical,Astro.url.origin).href} /><JsonLd data={jsonLd} /><main><ServiceDetail item={item} locale={locale} /></main></BaseLayout>
