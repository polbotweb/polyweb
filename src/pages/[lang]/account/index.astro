---
/** Espace client (portail) : documents du compte connecté uniquement. */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AuthSidebar from "@organisms/AuthSidebar/AuthSidebar.astro";
import PortalView from "@/components/portal/PortalView.astro";
import { getPortalTranslations } from "@/modules/portal/i18n";
import { portalPage } from "@/modules/portal/public/pages";

export const prerender = false;
const result = await portalPage(Astro);
if ("redirect" in result) return result.redirect;
const view = result;
const t = getPortalTranslations(view.locale);
---
<BaseLayout title={t.title} description={t.intro}>
  <AuthLayout title={t.title}>
    <AuthSidebar slot="sidebar" t={view.authT} locale={view.locale} user={view.user} activeItem="account" />
    <PortalView locale={view.locale} {...view.overview} />
  </AuthLayout>
</BaseLayout>
