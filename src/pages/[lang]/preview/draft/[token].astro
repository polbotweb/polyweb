---
/**
 * Aperçu sécurisé générique d'un brouillon (core/preview) : lien HMAC à durée limitée,
 * lié à un type de ressource ; accessible sans compte ; jamais indexé ni mis en cache.
 * Rendu par type (registre `src/lib/preview/resolvers.ts`).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SEOHead from '@/components/seo/SEOHead.astro';
import CmsPage from '@pages/CmsPage.astro';
import LegalPage from '@pages/LegalPage.astro';
import { toLocale } from '@i18n/utils';
import { runAppResult } from '@/lib/effect/http';
import { loadDraftPreview } from '@/core/preview';
import { DRAFT_PREVIEW_RESOLVERS } from '@/lib/preview/resolvers';

export const prerender = false;
const locale = toLocale(Astro.params.lang);
Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
Astro.response.headers.set('referrer-policy', 'no-referrer');

const r = await runAppResult(loadDraftPreview(Astro.params.token ?? '', DRAFT_PREVIEW_RESOLVERS));
if (!r.ok) {
  const tag = (r.error as { _tag?: string })._tag;
  const status = tag === 'UnauthorizedError' ? 403 : tag === 'NotFoundError' ? 404 : 500;
  return new Response(status === 403 ? 'Lien de prévisualisation invalide ou expiré.' : status === 404 ? 'Introuvable.' : 'Erreur.', {
    status,
    headers: { 'content-type': 'text/plain; charset=utf-8', 'cache-control': 'no-store', 'x-robots-tag': 'noindex' },
  });
}
const { data, expiresAt } = r.value;
const page = data.page;
const isLegal = page.page.template === 'legal';
---
<BaseLayout title={`Aperçu — ${page.page.title}`} description={page.page.metaDescription ?? page.page.title}>
  <SEOHead slot="head" locale={locale} noindex={true} />
  <div class="mx-auto mt-4 max-w-3xl px-4">
    <p class="rounded-md border border-warning bg-warning/10 p-3 text-sm" aria-live="polite" data-preview-banner>
      Prévisualisation — état courant ({page.page.isPublished ? 'publiée' : 'brouillon'}) · lien valable jusqu’au {expiresAt.toLocaleString(locale)}
    </p>
  </div>
  {isLegal ? <LegalPage data={page} locale={locale} /> : <CmsPage data={page} locale={locale} />}
</BaseLayout>
