---
/** Réassort : règles et suggestions, calcul à la demande. */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { Button } from "@atoms/button";
import { Effect } from "effect";
import { requirePermission } from "@lib/auth-guards";
import PurchasingAdminNav from "@/components/purchasing/admin/PurchasingAdminNav.astro";
import { getPurchasingTranslations } from "@/modules/purchasing/i18n";
import { listReorderBoard } from "@/modules/purchasing/loaders";
import { hasPurchasingPermission } from "@/modules/purchasing/permissions";

export const prerender = false;
const result = await requirePermission(Astro, { purchasing: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getPurchasingTranslations(locale);
const board = await Effect.runPromise(listReorderBoard(null));
const canUpdate = await hasPurchasingPermission(Astro, ["update"]);
---
<BaseLayout title={t.admin.reorder} description={t.meta.description}>
  <AuthLayout title={t.admin.reorder}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="purchasing" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <h1 class="text-2xl font-semibold">{t.admin.reorder}</h1>
      <PurchasingAdminNav locale={locale} active="reorder" />
      {canUpdate && (
        <form data-purchasing-form="runReorder" data-organization-id="" data-done={t.admin.saved}>
          <p class="text-sm text-destructive" role="alert" tabindex="-1" data-form-error hidden></p>
          <Button type="submit">{t.admin.runReorder}</Button>
        </form>
      )}
      <h2 class="text-lg font-semibold">{t.admin.emptyReorder && board.suggestions.length === 0 ? t.admin.emptyReorder : t.admin.reorder}</h2>
      {board.suggestions.length === 0 ? <p>{t.admin.emptyReorder}</p> : (
        <ul class="flex flex-col gap-2">
          {board.suggestions.map((s) => <li class="min-h-11">SKU {s.itemId} — qty {s.suggestedQty} (on hand {s.onHand})</li>)}
        </ul>
      )}
    </main>
  </AuthLayout>
</BaseLayout>

<script>
  import { initPurchasing } from "@/modules/purchasing/client/init";

  initPurchasing();
  document.addEventListener("astro:after-swap", initPurchasing);
</script>
