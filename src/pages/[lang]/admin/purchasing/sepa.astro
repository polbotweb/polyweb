---
/** Lots de virement SEPA pain.001. */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { Button } from "@atoms/button";
import { Effect } from "effect";
import { requirePermission } from "@lib/auth-guards";
import PurchasingAdminNav from "@/components/purchasing/admin/PurchasingAdminNav.astro";
import { getPurchasingTranslations } from "@/modules/purchasing/i18n";
import { listSepaExports, listSupplierInvoices } from "@/modules/purchasing/loaders";
import { hasPurchasingPermission } from "@/modules/purchasing/permissions";
import { purchasingToday } from "@/modules/purchasing/services/purchasing.service";

export const prerender = false;
const result = await requirePermission(Astro, { purchasing: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getPurchasingTranslations(locale);
const [exports, invoices] = await Promise.all([Effect.runPromise(listSepaExports(null)), Effect.runPromise(listSupplierInvoices(null))]);
const payable = invoices.filter((row) => ["ISSUED", "PARTIALLY_PAID"].includes(row.invoice.status) && row.invoice.currency === "EUR");
const canPay = await hasPurchasingPermission(Astro, ["payment"]);
---
<BaseLayout title={t.admin.sepa} description={t.meta.description}>
  <AuthLayout title={t.admin.sepa}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="purchasing" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <h1 class="text-2xl font-semibold">{t.admin.sepa}</h1>
      <PurchasingAdminNav locale={locale} active="sepa" />
      {canPay && payable.length > 0 && (
        <form class="flex max-w-3xl flex-col gap-3" data-purchasing-form="exportSepa" data-organization-id="" data-done={t.admin.created}>
          <label class="flex min-h-11 flex-col gap-1"><span>{t.fields.expectedDate}</span><input class="min-h-11 rounded-md border px-3" type="date" name="requestedExecutionDate" value={purchasingToday()} required /></label>
          <ul class="flex flex-col gap-2">
            {payable.map((row) => (
              <li>
                <label class="flex min-h-11 items-center gap-2">
                  <input type="checkbox" name="invoiceId" value={row.invoice.id} />
                  <span>{row.invoice.number ?? t.statuses.DRAFT} — {row.supplierName} — {((row.invoice.grossMinor - row.invoice.paidMinor - row.invoice.creditedMinor) / 100).toFixed(2)} {row.invoice.currency}</span>
                </label>
              </li>
            ))}
          </ul>
          <p class="text-sm text-destructive" role="alert" tabindex="-1" data-form-error hidden></p>
          <Button type="submit">{t.admin.exportSepa}</Button>
        </form>
      )}
      {exports.length === 0 ? <p>{t.admin.emptySepa}</p> : (
        <ul class="flex flex-col gap-2">
          {exports.map((row) => <li class="min-h-11">{row.number} — {row.paymentCount} — {(row.totalMinor / 100).toFixed(2)} {row.currency}</li>)}
        </ul>
      )}
    </main>
  </AuthLayout>
</BaseLayout>

<script>
  import { initPurchasing } from "@/modules/purchasing/client/init";

  initPurchasing();
  document.addEventListener("astro:after-swap", initPurchasing);
</script>
