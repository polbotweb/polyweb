---
/** Back-office plateforme : édition d'un brouillon de devis / facture (document émis → fiche). */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { requirePermission } from "@lib/auth-guards";
import SalesDocumentForm from "@/components/sales/admin/SalesDocumentForm.astro";
import { isLocked } from "@/modules/sales/domain/workflow";
import { getSalesTranslations } from "@/modules/sales/i18n";
import { loadSalesDocument } from "@/modules/sales/loaders";

export const prerender = false;
const result = await requirePermission(Astro, { sales: ["update"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getSalesTranslations(locale);
const baseAdminUrl = `/${locale}/admin/sales`;
const doc = await loadSalesDocument(Astro.params.id ?? "", null);
if (!doc) return new Response(null, { status: 404 });
if (doc.kind === "credit_note" || isLocked(doc.kind, doc.status)) return Astro.redirect(`${baseAdminUrl}/${doc.id}`);
const kind = doc.kind;
---
<BaseLayout title={t.admin.edit} description={t.meta.description}>
  <AuthLayout title={t.admin.edit}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="sales" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <h1 class="text-2xl font-semibold">{t.admin.edit} — {doc.title}</h1>
      <SalesDocumentForm locale={locale} kind={kind} viewBaseUrl={baseAdminUrl} listUrl={baseAdminUrl} document={doc} />
    </main>
  </AuthLayout>
</BaseLayout>
