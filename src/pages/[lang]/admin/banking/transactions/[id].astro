---
/** Ligne de relevé : détail, écran de rapprochement (propositions, recherche, écarts), ignorer, historique. */
import { Effect, Result } from "effect";
import { requirePermission } from "@lib/auth-guards";
import BankingPage from "@/components/banking/admin/BankingPage.astro";
import StatusBadge from "@/components/banking/admin/StatusBadge.astro";
import { ADJUSTMENT_KINDS } from "@/modules/banking/domain/constants";
import { getBankingTranslations } from "@/modules/banking/i18n";
import { hasBankingPermission } from "@/modules/banking/permissions";
import { bankingQueries } from "@/modules/banking/services/queries.service";
import { exponentOf, formatDate, formatMinor } from "@/modules/banking/ui/format";
import { statusTone } from "@/modules/banking/ui/tones";

export const prerender = false;
const result = await requirePermission(Astro, { banking: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getBankingTranslations(locale);
const base = `/${locale}/admin/banking`;
const id = Astro.params.id ?? "";
const found = await Effect.runPromise(Effect.result(bankingQueries.transaction(null, id)));
if (Result.isFailure(found)) return Astro.redirect(base);
const line = found.success;
const [history, canReconcile] = await Promise.all([
  Effect.runPromise(bankingQueries.reconciliationsOfTransaction(null, id)),
  hasBankingPermission(Astro, { banking: ["reconcile"] }),
]);
const open = line.status === "unmatched" || line.status === "suggested" || line.status === "partial";
const remainingMinor = line.amountMinor - Math.sign(line.amountMinor) * line.matchedMinor;
const details: readonly [string, string][] = [
  [t.fields.date, formatDate(line.bookingDate, locale)], [t.fields.valueDate, formatDate(line.valueDate, locale)],
  [t.fields.amount, formatMinor(line.amountMinor, line.currency, locale)], [t.fields.counterparty, line.counterpartyName ?? t.common.none],
  [t.fields.iban, line.counterpartyIban ?? t.common.none], [t.fields.reference, [line.endToEndId, line.bankReference, ...line.references].filter(Boolean).join(" · ") || t.common.none],
];
const labels = {
  balanceOk: t.reconcile.balanceOk, balanceGap: t.reconcile.balanceGap, allocate: t.reconcile.allocate, remove: t.reconcile.removeAdjustment, use: t.reconcile.use,
  noProposal: t.reconcile.noProposal, empty: t.common.empty, applied: t.reconcile.applied, pending: t.reconcile.pending,
};
const input = "min-h-11 rounded-md border px-3";
---
<BankingPage locale={locale} authT={authT} title={t.reconcile.title} active={null} back={{ href: base, label: t.nav.dashboard }}>
  <section class="flex flex-col gap-3 rounded-md border p-4" aria-labelledby="line-title">
    <div class="flex flex-wrap items-center gap-3">
      <h2 id="line-title" class="text-lg font-semibold">{line.label}</h2>
      <StatusBadge label={t.statuses[line.status]} tone={statusTone(line.status)} />
      {line.provisional && <StatusBadge label={t.statuses.provisional} tone="info" />}
    </div>
    <dl class="grid gap-2 text-sm sm:grid-cols-3">
      {details.map(([label, value]) => <div><dt class="text-muted-foreground">{label}</dt><dd dir="auto">{value}</dd></div>)}
    </dl>
    {line.note && <p class="text-sm">{t.fields.note} : {line.note}</p>}
    {line.status === "partial" && <p class="text-sm">{t.reconcile.remaining} : {formatMinor(remainingMinor, line.currency, locale)}</p>}
  </section>

  {canReconcile && open && (
    <section
      class="flex flex-col gap-4"
      aria-labelledby="reconcile-title"
      data-reconcile
      data-transaction-id={line.id}
      data-amount={remainingMinor}
      data-currency={line.currency}
      data-exponent={exponentOf(line.currency)}
      data-locale={locale}
      data-labels={JSON.stringify(labels)}
      data-sources={JSON.stringify(t.reconcile.sources)}
      data-reasons={JSON.stringify(t.reconcile.reasons)}
    >
      <h2 id="reconcile-title" class="text-xl font-semibold">{t.reconcile.line}</h2>
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="flex flex-col gap-3">
          <h3 class="font-medium">{t.reconcile.proposals}</h3>
          <ul class="flex flex-col gap-2" data-proposals aria-live="polite"><li>…</li></ul>
          <h3 class="font-medium">{t.reconcile.candidates}</h3>
          <form class="flex flex-wrap items-end gap-2" data-candidate-search role="search">
            <label class="flex flex-1 flex-col gap-1"><span class="sr-only">{t.common.search}</span><input class={input} type="search" maxlength="100" placeholder={t.reconcile.searchPlaceholder} aria-label={t.common.search} /></label>
            <button class="min-h-11 rounded-md border px-4" type="submit">{t.common.search}</button>
          </form>
          <ul class="flex flex-col gap-2" data-candidates aria-live="polite"></ul>
        </div>
        <div class="flex flex-col gap-3">
          <h3 class="font-medium">{t.reconcile.allocate}</h3>
          <ul class="flex flex-col gap-2" data-allocations></ul>
          <h3 class="font-medium">{t.reconcile.adjustments}</h3>
          <ul class="flex flex-col gap-2" data-adjustments></ul>
          <template data-adjustment-template>
            <li class="flex flex-wrap items-center gap-2" data-adjustment>
              <select class={input} aria-label={t.fields.kind}>{ADJUSTMENT_KINDS.map((kind) => <option value={kind}>{t.reconcile.adjustmentKinds[kind]}</option>)}</select>
              <input class={`${input} w-32 text-end`} type="text" inputmode="decimal" aria-label={t.fields.amount} />
              <button class="min-h-11 rounded-md border px-3" type="button" data-remove>{t.reconcile.removeAdjustment}</button>
            </li>
          </template>
          <button class="min-h-11 w-fit rounded-md border px-4" type="button" data-add-adjustment>{t.reconcile.addAdjustment}</button>
          <p class="font-medium" data-remaining aria-live="polite"></p>
          <p class="text-sm text-muted-foreground">{t.reconcile.partialHint} {t.reconcile.approvalNeeded}</p>
          <label class="flex flex-col gap-1"><span>{t.fields.note} <span class="text-muted-foreground">({t.common.optional})</span></span><textarea class="rounded-md border p-3" name="note" maxlength="500" rows="2"></textarea></label>
          <p class="text-sm text-destructive" role="alert" tabindex="-1" data-form-error hidden></p>
          <button class="min-h-11 w-fit rounded-md bg-primary px-4 text-primary-foreground disabled:opacity-50" type="button" data-reconcile-submit disabled>{t.reconcile.validate}</button>
        </div>
      </div>
    </section>
  )}

  {canReconcile && (line.status === "unmatched" || line.status === "suggested") && line.matchedMinor === 0 && (
    <div><button class="min-h-11 rounded-md border px-4" type="button" data-banking-action="setIgnored" data-payload={JSON.stringify({ transactionIds: [line.id], ignored: true })} data-prompt={t.reconcile.ignoreNote} data-prompt-field="note" data-done={t.common.done}>{t.reconcile.ignore}</button></div>
  )}
  {canReconcile && line.status === "ignored" && (
    <div><button class="min-h-11 rounded-md border px-4" type="button" data-banking-action="setIgnored" data-payload={JSON.stringify({ transactionIds: [line.id], ignored: false })} data-done={t.common.done}>{t.reconcile.unignore}</button></div>
  )}

  <section class="flex flex-col gap-3" aria-labelledby="line-history">
    <h2 id="line-history" class="text-xl font-semibold">{t.reconciliations.history}</h2>
    {history.length === 0 ? <p>{t.common.empty}</p> : (
      <ul class="flex flex-col gap-2">
        {history.map(({ reconciliation, amountMinor }) => (
          <li class="flex flex-wrap items-center gap-3 rounded-md border p-3">
            <a class="underline" href={`${base}/reconciliations/${reconciliation.id}`}>{formatDate(reconciliation.date, locale)} — {formatMinor(amountMinor, reconciliation.currency, locale)}</a>
            <span>{t.reconModes[reconciliation.mode]}</span>
            {reconciliation.letteringCode && <span>{t.fields.lettering} {reconciliation.letteringCode}</span>}
            <StatusBadge label={t.reconStatuses[reconciliation.status]} tone={statusTone(reconciliation.status)} />
          </li>
        ))}
      </ul>
    )}
  </section>
</BankingPage>
