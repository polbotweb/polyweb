---
/** Back-office plateforme : entrepôts (liste + création). */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { requirePermission } from "@lib/auth-guards";
import WarehouseForm from "@/components/logistics/admin/WarehouseForm.astro";
import { getLogisticsTranslations } from "@/modules/logistics/i18n";
import { loadWarehouses } from "@/modules/logistics/loaders";
import { hasLogisticsPermission } from "@/modules/logistics/permissions";

export const prerender = false;
const result = await requirePermission(Astro, { logistics: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getLogisticsTranslations(locale);
const baseAdminUrl = `/${locale}/admin/logistics`;
const [warehouses, canCreate] = await Promise.all([loadWarehouses(null), hasLogisticsPermission(Astro, ["create"])]);
---
<BaseLayout title={t.admin.warehouses} description={t.meta.description}>
  <AuthLayout title={t.admin.warehouses}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="logistics" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-semibold">{t.admin.warehouses}</h1>
        <a class="inline-flex min-h-11 items-center px-3 underline" href={baseAdminUrl}>{t.admin.back}</a>
      </div>
      {warehouses.length === 0 ? <p class="text-sm text-muted-foreground">{t.admin.noWarehouses}</p> : (
        <ul class="flex flex-col gap-2" aria-label={t.admin.warehouses} data-testid="logistics-warehouse-list">
          {warehouses.map((w) => (
            <li class="flex flex-wrap items-center justify-between gap-3 border px-4 py-3">
              <span><span class="font-mono font-medium">{w.code}</span> — {w.name}{w.country ? ` (${w.country})` : ""}{!w.active && <span class="text-muted-foreground"> · {t.fields.active} : {t.admin.none}</span>}</span>
              <a class="inline-flex min-h-11 items-center px-3 underline" href={`${baseAdminUrl}/warehouses/${w.id}`} aria-label={`${t.admin.edit} — ${w.code}`}>{t.admin.edit}</a>
            </li>
          ))}
        </ul>
      )}
      {canCreate && (
        <section class="flex flex-col gap-3" aria-labelledby="lg-new-wh"><h2 id="lg-new-wh" class="text-lg font-semibold">{t.admin.newWarehouse}</h2><WarehouseForm locale={locale} /></section>
      )}
    </main>
  </AuthLayout>
</BaseLayout>
