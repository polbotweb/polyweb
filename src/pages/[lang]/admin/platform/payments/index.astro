---
/** Paiements (module optionnel, PAYMENTS_ENABLED=true) : liste en lecture seule des 100 derniers paiements. */
import { requirePermission } from '@/lib/auth-guards';
import PlatformAdminShell from '@organisms/PlatformAdmin/PlatformAdminShell.astro';
import { getPlatformLabel } from '@/core/localization/platform-labels';
import { formatDate } from '@/lib/platform/admin';
import { isPaymentsEnabled, listPayments } from '@/modules/payments/domain/payment-service';

export const prerender = false;
const result = await requirePermission(Astro, { payment: ['read'] });
if ('redirect' in result) return result.redirect;
const { locale, authT } = result;
if (!isPaymentsEnabled()) return new Response('Not Found', { status: 404 });
const payments = await listPayments(100);
const money = (amount: number, currency: string) => new Intl.NumberFormat(locale, { style: 'currency', currency }).format(amount / 100);
---
<PlatformAdminShell t={authT} locale={locale} section="payments" title={getPlatformLabel('payments', locale)}>
  {payments.length === 0 ? <p class="text-sm">Aucun paiement.</p> : (
    <table class="w-full text-sm">
      <thead><tr class="border-b"><th class="py-2 text-start">Date</th><th class="text-start">Référence</th><th class="text-start">Montant</th><th class="text-start">Fournisseur</th><th class="text-start">Statut</th><th class="text-start">Client</th></tr></thead>
      <tbody>
        {payments.map((p) => (
          <tr class="border-b">
            <td class="py-2 whitespace-nowrap">{formatDate(p.createdAt, locale)}</td>
            <td class="font-mono">{p.reference}</td>
            <td>{money(p.amount, p.currency)}</td>
            <td>{p.provider}</td>
            <td>{p.status}</td>
            <td>{p.customerEmail ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</PlatformAdminShell>
