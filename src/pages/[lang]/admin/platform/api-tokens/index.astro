---
/**
 * Jetons d'API (brique c). Logique en Effect (`@/modules/api/domain/tokens`),
 * exécutée via le runtime partagé (`runAppResult`).
 */
import { Effect } from 'effect';
import { requirePermission } from '@/lib/auth-guards';
import PlatformAdminShell from '@organisms/PlatformAdmin/PlatformAdminShell.astro';
import { getPlatformLabel, getPlatformAdminUrl } from '@/core/localization/platform-labels';
import { getAdminSite, userCan, formatDate } from '@/lib/platform/admin';
import { logAuditEvent, extractIp } from '@/lib/audit';
import { runAppResult } from '@/lib/effect/http';
import { ForbiddenError } from '@/lib/effect/errors';
import { createToken, listTokens, revokeToken, API_RATE_LIMITS } from '@/modules/api/domain/tokens';
import { listApiResources, listApiScopes } from '@/core/api/registry';
import { getApiTokensLabels, describeScope } from '@/core/localization/api-tokens-labels';

export const prerender = false;
const result = await requirePermission(Astro, { apiToken: ['read'] });
if ('redirect' in result) return result.redirect;
const { locale, authT, user } = result;
const L = getApiTokensLabels(locale);
const site = await getAdminSite(Astro);
const [canCreate, canRevoke] = await Promise.all([userCan(user.id, { apiToken: ['create'] }), userCan(user.id, { apiToken: ['revoke'] })]);

let error: string | null = null;
let createdToken: string | null = null;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const intent = String(fd.get('intent') ?? '');
  const meta = { ipAddress: extractIp(Astro.request.headers, Astro.clientAddress), userAgent: Astro.request.headers.get('user-agent') };
  if (intent === 'create') {
    const expires = String(fd.get('expiresInDays') ?? '').trim();
    const rate = String(fd.get('rateLimitPerMinute') ?? '').trim();
    const r = await runAppResult(
      Effect.gen(function* () {
        if (!canCreate) return yield* new ForbiddenError({ reason: L.denied });
        return yield* createToken(site.id, { name: String(fd.get('name') ?? ''), scopes: fd.getAll('scopes').map(String), ...(expires ? { expiresInDays: Number(expires) } : {}), ...(rate ? { rateLimitPerMinute: Number(rate) } : {}) }, user.id);
      }),
    );
    if (r.ok) {
      createdToken = r.value.token;
      void logAuditEvent({ userId: user.id, action: 'API_TOKEN_CREATE', resource: 'api_token', resourceId: r.value.record.id, metadata: { name: r.value.record.name, scopes: r.value.record.scopes, rateLimitPerMinute: r.value.record.rateLimitPerMinute, expiresAt: r.value.record.expiresAt }, ...meta });
    } else error = r.error.message;
  } else if (intent === 'revoke') {
    const id = String(fd.get('id') ?? '');
    const r = await runAppResult(
      Effect.gen(function* () {
        if (!canRevoke) return yield* new ForbiddenError({ reason: L.denied });
        return yield* revokeToken(site.id, id);
      }),
    );
    if (r.ok) {
      void logAuditEvent({ userId: user.id, action: 'API_TOKEN_REVOKE', resource: 'api_token', resourceId: id, ...meta });
      return Astro.redirect(`${getPlatformAdminUrl(locale, 'api-tokens')}?saved=revoked`, 303);
    }
    error = r.error.message;
  }
}

const listed = await runAppResult(listTokens(site.id));
const tokens = listed.ok ? listed.value : [];
const saved = Astro.url.searchParams.get('saved');
const resources = listApiResources();
const defaultRate = API_RATE_LIMITS.token.max;
const now = new Date();
---
<PlatformAdminShell t={authT} locale={locale} section="api-tokens" title={getPlatformLabel('api-tokens', locale)}>
  <a slot="actions" class="inline-flex min-h-11 items-center rounded-md border px-3 py-2 text-sm" href="/api/v1/openapi.json">{L.openapi}</a>
  {saved === 'revoked' && <output class="block rounded-md border border-success bg-success/10 p-3 text-sm">{L.revoked}</output>}
  {error && <p class="rounded-md border border-error bg-error/10 p-3 text-sm" role="alert">{error}</p>}
  {createdToken && (
    <div class="rounded-md border border-warning bg-warning/10 p-4 text-sm" aria-live="polite" data-testid="new-token">
      <p class="font-medium">{L.createdTitle}</p>
      <code class="mt-2 block break-all rounded bg-background p-2 font-mono" data-token>{createdToken}</code>
      <p class="mt-2 text-foreground">{L.usage}</p>
    </div>
  )}
  <p class="text-foreground text-sm">{L.siteNote(site.name)}</p>

  {canCreate && (
    <form method="post" class="grid gap-3 rounded-md border p-4" aria-labelledby="api-token-new">
      <input type="hidden" name="intent" value="create" />
      <h2 id="api-token-new" class="font-semibold">{L.newToken}</h2>
      <label class="grid gap-1 text-sm">{L.name}<input name="name" required maxlength="120" autocomplete="off" class="min-h-11 rounded-md border bg-background px-3 py-2" /></label>
      <fieldset class="grid gap-1 text-sm">
        <legend class="mb-1">{L.scopes}</legend>
        {listApiScopes().map((s) => (
          <label class="flex min-h-11 items-center gap-2"><input type="checkbox" name="scopes" value={s} checked={s === 'content:read'} class="size-5" /> <code>{s}</code> <span class="text-foreground">— {describeScope(L, s, resources)}</span></label>
        ))}
      </fieldset>
      <div class="grid gap-1 text-sm">
        <label for="api-token-expires">{L.expires}</label>
        <input id="api-token-expires" name="expiresInDays" type="number" inputmode="numeric" min="1" max="3650" step="1" aria-describedby="api-token-expires-hint" class="min-h-11 w-40 rounded-md border bg-background px-3 py-2" />
        <p id="api-token-expires-hint" class="text-foreground">{L.expiresHint}</p>
      </div>
      <div class="grid gap-1 text-sm">
        <label for="api-token-rate">{L.rateLimit}</label>
        <input id="api-token-rate" name="rateLimitPerMinute" type="number" inputmode="numeric" min="1" max="100000" step="1" aria-describedby="api-token-rate-hint" class="min-h-11 w-40 rounded-md border bg-background px-3 py-2" />
        <p id="api-token-rate-hint" class="text-foreground">{L.rateLimitHint(defaultRate)}</p>
      </div>
      <div><button class="min-h-11 rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-foreground">{L.create}</button></div>
    </form>
  )}

  {tokens.length === 0 ? <p>{L.none}</p> : (
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <caption class="sr-only">{L.caption}</caption>
        <thead><tr class="border-b"><th scope="col" class="py-2 text-start">{L.name}</th><th scope="col" class="text-start">{L.prefix}</th><th scope="col" class="text-start">{L.scopes}</th><th scope="col" class="text-start">{L.lastUsed}</th><th scope="col" class="text-start">{L.expiresCol}</th><th scope="col" class="text-start">{L.rateCol}</th><th scope="col" class="text-start">{L.state}</th><th scope="col"><span class="sr-only">{L.actions}</span></th></tr></thead>
        <tbody>
          {tokens.map((t) => (
            <tr class="border-b">
              <th scope="row" class="py-2 text-start font-medium">{t.name}</th>
              <td><code>pw_{t.prefix}_…</code></td>
              <td>{t.scopes.join(', ')}</td>
              <td>{t.lastUsedAt ? formatDate(t.lastUsedAt, locale) : '—'}</td>
              <td>{t.expiresAt ? formatDate(t.expiresAt, locale) : '—'}</td>
              <td>{t.rateLimitPerMinute ? L.perMinute(t.rateLimitPerMinute) : L.defaultRate(defaultRate)}</td>
              <td>{t.revokedAt ? L.stateRevoked : t.expiresAt && t.expiresAt < now ? L.stateExpired : L.stateActive}</td>
              <td class="text-end">
                {canRevoke && !t.revokedAt && (
                  <form method="post"><input type="hidden" name="intent" value="revoke" /><input type="hidden" name="id" value={t.id} /><button class="min-h-11 px-2 text-error underline" aria-label={L.revokeFor(t.name)}>{L.revoke}</button></form>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</PlatformAdminShell>
