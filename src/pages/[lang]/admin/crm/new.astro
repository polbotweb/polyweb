---
/** Back-office plateforme : nouvelle opportunité. */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { requirePermission } from "@lib/auth-guards";
import OpportunityForm from "@/components/crm/admin/OpportunityForm.astro";
import { getCrmTranslations } from "@/modules/crm/i18n";
import { loadCompanies, loadContacts } from "@/modules/crm/loaders";

export const prerender = false;
const result = await requirePermission(Astro, { crm: ["create"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getCrmTranslations(locale);
const baseAdminUrl = `/${locale}/admin/crm`;
const [companies, contacts] = await Promise.all([loadCompanies(null), loadContacts(null)]);
---
<BaseLayout title={t.admin.newOpportunity} description={t.meta.description}>
  <AuthLayout title={t.admin.newOpportunity}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="crm" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <h1 class="text-2xl font-semibold">{t.admin.newOpportunity}</h1>
      <OpportunityForm locale={locale} viewBaseUrl={baseAdminUrl} listUrl={baseAdminUrl} companies={companies} contacts={contacts} />
    </main>
  </AuthLayout>
</BaseLayout>
