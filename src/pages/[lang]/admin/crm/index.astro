---
/** Back-office plateforme : CRM — synthèse du pipeline, liste des opportunités (facettes, vues, actions groupées). */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import AdminPagination from "@molecules/AdminPagination/AdminPagination.astro";
import { Effect } from "effect";
import { requirePermission } from "@lib/auth-guards";
import { loadSavedViews } from "@/lib/admin/saved-views";
import { bulkBarOperations } from "@/core/bulk/ui";
import CrmAdminList from "@/components/crm/admin/CrmAdminList.astro";
import CrmPipelineSummary from "@/components/crm/admin/CrmPipelineSummary.astro";
import { opportunityAdminResource } from "@/modules/crm/admin/resource";
import { getCrmTranslations } from "@/modules/crm/i18n";
import { crmAdminFiltersFromUrl, crmAdminList, loadCrmAdminFacets, loadCrmPipelineSummary } from "@/modules/crm/loaders";
import { hasCrmPermission } from "@/modules/crm/permissions";

export const prerender = false;
const result = await requirePermission(Astro, { crm: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getCrmTranslations(locale);
const baseAdminUrl = `/${locale}/admin/crm`;
const [list, facets, summaries, savedViews, canCreate, canUpdate] = await Promise.all([
  Effect.runPromise(crmAdminList(null, Astro.url.searchParams)),
  loadCrmAdminFacets(null, crmAdminFiltersFromUrl(Astro.url.searchParams)).catch(() => ({})),
  loadCrmPipelineSummary(null),
  Astro.locals.user ? loadSavedViews(Astro.locals.user.id, "crm-opportunity", null) : Promise.resolve([]),
  hasCrmPermission(Astro, ["create"]),
  hasCrmPermission(Astro, ["update"]),
]);
const bulkOperations = bulkBarOperations(opportunityAdminResource.list?.bulkActions, t.admin.bulk, { qualify: canUpdate, lose: canUpdate });
---
<BaseLayout title={t.admin.title} description={t.meta.description}>
  <AuthLayout title={t.admin.title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="crm" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-semibold">{t.admin.title}</h1>
        <nav class="flex flex-wrap gap-2" aria-label={t.admin.title}>
          <a class="inline-flex min-h-11 items-center rounded-md border px-4" href={`${baseAdminUrl}/companies`}>{t.admin.companies}</a>
          <a class="inline-flex min-h-11 items-center rounded-md border px-4" href={`${baseAdminUrl}/contacts`}>{t.admin.contacts}</a>
          {canCreate && <a class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-primary-foreground" href={`${baseAdminUrl}/new`} data-testid="crm-new-opportunity">{t.admin.newOpportunity}</a>}
        </nav>
      </div>
      <CrmPipelineSummary summaries={summaries} locale={locale} listUrl={baseAdminUrl} />
      <h2 class="text-lg font-semibold">{t.admin.list}</h2>
      <CrmAdminList items={list.items} locale={locale} viewBaseUrl={baseAdminUrl} bulkOperations={bulkOperations} baseUrl={Astro.url} facets={facets} savedViews={savedViews} />
      {list.totalPages > 1 && <AdminPagination currentPage={list.page} totalPages={list.totalPages} baseUrl={Astro.url} />}
    </main>
  </AuthLayout>
</BaseLayout>
