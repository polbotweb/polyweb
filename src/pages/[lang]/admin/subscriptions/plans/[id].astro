---
/** Back-office plateforme : édition d'une formule et de ses tarifs récurrents. */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { Button } from "@atoms/button";
import { ScrollRegion } from "@molecules/ScrollRegion";
import { requirePermission } from "@lib/auth-guards";
import PlanForm from "@/components/subscriptions/admin/PlanForm.astro";
import PriceForm from "@/components/subscriptions/admin/PriceForm.astro";
import { getSubscriptionsTranslations } from "@/modules/subscriptions/i18n";
import { loadPlan, loadPrices } from "@/modules/subscriptions/loaders";
import { priceLabel } from "@/modules/subscriptions/format";

export const prerender = false;
const result = await requirePermission(Astro, { subscriptions: ["update"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getSubscriptionsTranslations(locale);
const baseAdminUrl = `/${locale}/admin/subscriptions`;
const plan = await loadPlan(Astro.params.id ?? "");
if (!plan || plan.organizationId !== null) return new Response(null, { status: 404 });
const prices = await loadPrices(plan.id);
---
<BaseLayout title={plan.name} description={t.meta.description}>
  <AuthLayout title={plan.name}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="subscriptions" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8" data-subscriptions-record>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-semibold">{t.admin.editPlan} — {plan.name}</h1>
        <a class="inline-flex min-h-11 items-center px-3 underline" href={baseAdminUrl}>{t.admin.back}</a>
      </div>
      <PlanForm locale={locale} plan={plan} />
      <section class="flex flex-col gap-4" aria-labelledby="sub-prices-heading">
        <h2 id="sub-prices-heading" class="text-lg font-semibold">{t.admin.prices}</h2>
        <p class="text-sm text-destructive" role="alert" tabindex="-1" data-subscriptions-error hidden></p>
        {prices.length === 0 ? <p class="text-sm text-muted-foreground">{t.admin.noPrices}</p> : (
          <ScrollRegion label={t.admin.prices}>
            <table class="w-full text-sm" data-testid="subscriptions-price-list">
              <thead><tr class="border-b"><th scope="col" class="py-2 text-start">{t.fields.price}</th><th scope="col" class="py-2 text-start">{t.fields.trialDays}</th><th scope="col" class="py-2 text-start">{t.fields.active}</th><th scope="col" class="py-2 text-start"><span class="sr-only">{t.fields.status}</span></th></tr></thead>
              <tbody>{prices.map((pr) => <tr class="border-b"><td class="py-2">{priceLabel(pr, locale)}</td><td class="py-2">{pr.trialDays}</td><td class="py-2">{pr.active ? "✓" : "—"}</td><td class="py-2"><Button type="button" variant="outline" data-subscriptions-op={pr.active ? "price-off" : "price-on"} data-id={pr.id}>{pr.active ? t.admin.deactivate : t.admin.activate}</Button></td></tr>)}</tbody>
            </table>
          </ScrollRegion>
        )}
        <PriceForm locale={locale} planId={plan.id} />
      </section>
    </main>
  </AuthLayout>
</BaseLayout>

<script>
  import { initSubscriptions } from "@/modules/subscriptions/client/init";

  initSubscriptions();
  document.addEventListener("astro:after-swap", initSubscriptions);
</script>
