---
/**
 * Administration des forums du site administré (cookie `pw_admin_site`) : forums (visibilité,
 * statut), catégories (noms et descriptions en 4 langues, ordre, suppression avec déplacement
 * des sujets) et étiquettes. Permissions forums évaluées dans la portée organisation + site.
 */
import { Effect } from "effect";
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import AdminResourceShell from "@organisms/AdminResourceShell.astro";
import Badge from "@atoms/badge/Badge.astro";
import Button from "@atoms/button/Button.astro";
import { Input } from "@atoms/input";
import { Label } from "@atoms/label";
import { NativeSelect, NativeSelectOption } from "@atoms/native-select";
import ForumLocaleFields from "@/components/forums/ForumLocaleFields.astro";
import ForumNotice from "@/components/forums/ForumNotice.astro";
import { requireAuth } from "@/lib/auth-guards";
import { getAdminSite } from "@/lib/platform/admin";
import { runApp } from "@/lib/effect/http";
import { forumsCan } from "@/modules/forums/services/access";
import { ensureSiteForum, listForumCategories, listSiteForums, listSiteTags } from "@/modules/forums/services/forum.service";
import { categoryLabel } from "@/modules/forums/domain/defaults";
import { FORUM_VISIBILITIES } from "@/modules/forums/schema";
import { handleAdminForumsForm } from "@/modules/forums/web/admin-forms";
import { getForumsTranslations } from "@/modules/forums/i18n";
import { moderationQueueUrl } from "@/modules/forums/web/moderation-link";

export const prerender = false;
const auth = await requireAuth(Astro);
if ("redirect" in auth) return auth.redirect;
const { user, locale, authT } = auth;
const site = await getAdminSite(Astro);
const scope = { organizationId: site.organizationId ?? null, siteId: site.id };
const [canConfigure, canCreate, canModerate] = await Promise.all([
  Effect.runPromise(forumsCan(user, scope, ["configure"])),
  Effect.runPromise(forumsCan(user, scope, ["create"])),
  Effect.runPromise(forumsCan(user, scope, ["moderate"])),
]);
if (!canConfigure && !canModerate) return Astro.redirect(`/${locale}/auth/${authT.routes["dashboard"]}`);
const self = `/${locale}/admin/forums`;

if (Astro.request.method === "POST") {
  const result = await handleAdminForumsForm(await Astro.request.formData(), { viewer: user, sessionId: Astro.locals.session?.id ?? null, site: { id: site.id, organizationId: scope.organizationId } });
  return Astro.redirect(result.ok ? `${self}?notice=${result.notice}` : `${self}?error=${result.error}`, 303);
}

if (canConfigure) await runApp(ensureSiteForum(scope));
const forums = await runApp(listSiteForums(site.id));
const categories = await runApp(listForumCategories(forums.map((f) => f.id)));
const tags = await runApp(listSiteTags(site.id));
const queueUrl = canModerate ? await runApp(moderationQueueUrl(locale, scope.organizationId)) : null;
const t = getForumsTranslations(locale);
const a = t.admin;
---
<BaseLayout title={`${a.title} — ${site.name}`} description={a.intro}>
  <AuthLayout title={a.title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="forums" />
    <AdminResourceShell title={a.title} description={`${a.intro} (${site.name})`}>
      <Fragment slot="actions">
        <Button href={`/${locale}/admin/forums/sanctions`} variant="outline" size="sm">{a.sanctionsPage}</Button>
        {queueUrl && <Button href={queueUrl} variant="outline" size="sm">{a.openQueue}</Button>}
        <Button href={`/${locale}/forums`} variant="outline" size="sm">{t.title}</Button>
      </Fragment>
      <div class="grid gap-8 p-4 sm:p-6" data-testid="admin-forums">
        <ForumNotice t={t} url={Astro.url} />

        <section aria-labelledby="forums-title" class="grid gap-4">
          <h2 id="forums-title" class="font-heading text-xl font-semibold">{a.forums}</h2>
          {forums.map((forum) => {
            const own = categories.filter((c) => c.forumId === forum.id);
            return (
              <article class="grid gap-4 rounded-xl border p-4" data-forum={forum.slug} aria-labelledby={`f-${forum.id}`}>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 id={`f-${forum.id}`} class="font-medium">{forum.title}</h3>
                  <Badge variant="outline" size="sm">{a.statuses[forum.status] ?? forum.status}</Badge>
                  <Badge variant="secondary" size="sm">{a.visibilities[forum.visibility]}</Badge>
                </div>
                {canConfigure && (
                  <>
                    <form method="post" class="grid gap-3 sm:grid-cols-2">
                      <input type="hidden" name="intent" value="forumUpdate" /><input type="hidden" name="forumId" value={forum.id} />
                      <div class="grid gap-1">
                        <Label for={`forum-title-${forum.id}`}>{a.forumTitle}</Label>
                        <Input id={`forum-title-${forum.id}`} name="title" value={forum.title} required minlength="2" maxlength="160" />
                      </div>
                      <div class="grid gap-1">
                        <Label for={`forum-slug-${forum.id}`}>{a.forumSlug}</Label>
                        <Input id={`forum-slug-${forum.id}`} name="slug" value={forum.slug} maxlength="80" />
                      </div>
                      <div class="grid gap-1 sm:col-span-2">
                        <Label for={`forum-description-${forum.id}`}>{a.forumDescription}</Label>
                        <Input id={`forum-description-${forum.id}`} name="description" value={forum.description ?? ""} maxlength="500" />
                      </div>
                      <div class="grid gap-1">
                        <Label for={`forum-visibility-${forum.id}`}>{a.visibility}</Label>
                        <NativeSelect id={`forum-visibility-${forum.id}`} name="visibility" class="w-full">
                          {FORUM_VISIBILITIES.map((v) => <NativeSelectOption value={v} selected={v === forum.visibility}>{a.visibilities[v]}</NativeSelectOption>)}
                        </NativeSelect>
                      </div>
                      <Button type="submit" variant="outline" size="sm" class="w-fit self-end">{a.save}</Button>
                    </form>
                    <div class="flex flex-wrap gap-2">
                      {forum.status !== "PUBLISHED" && <form method="post"><input type="hidden" name="intent" value="forumTransition" /><input type="hidden" name="forumId" value={forum.id} /><input type="hidden" name="to" value="PUBLISHED" /><Button type="submit" variant="primary" size="sm">{a.publish}</Button></form>}
                      {forum.status === "PUBLISHED" && <form method="post"><input type="hidden" name="intent" value="forumTransition" /><input type="hidden" name="forumId" value={forum.id} /><input type="hidden" name="to" value="DRAFT" /><Button type="submit" variant="outline" size="sm">{a.unpublish}</Button></form>}
                      {forum.status !== "ARCHIVED" && <form method="post"><input type="hidden" name="intent" value="forumTransition" /><input type="hidden" name="forumId" value={forum.id} /><input type="hidden" name="to" value="ARCHIVED" /><Button type="submit" variant="outline" size="sm">{a.archive}</Button></form>}
                    </div>

                    <h4 class="font-medium">{a.categoriesTitle}</h4>
                    <ol class="grid gap-3" data-testid={`categories-${forum.slug}`}>
                      {own.map((c, i) => (
                        <li class="grid gap-3 rounded-md border p-3" data-category={c.slug}>
                          <p class="font-medium">{categoryLabel(c.translations, locale, c.slug).name} <span class="text-sm text-muted-foreground">({c.slug})</span></p>
                          <details>
                            <summary class="inline-flex h-9 cursor-pointer items-center text-sm underline underline-offset-4">{a.editCategory}</summary>
                            <form method="post" class="mt-3 grid gap-3">
                              <input type="hidden" name="intent" value="categoryUpdate" /><input type="hidden" name="categoryId" value={c.id} />
                              <ForumLocaleFields t={t} uiLocale={locale} idPrefix={`cat-${c.id}`} translations={c.translations} />
                              <Button type="submit" variant="outline" size="sm" class="w-fit">{a.save}</Button>
                            </form>
                          </details>
                          <div class="flex flex-wrap items-end gap-2">
                            {i > 0 && <form method="post"><input type="hidden" name="intent" value="categoryMove" /><input type="hidden" name="categoryId" value={c.id} /><input type="hidden" name="direction" value="up" /><Button type="submit" variant="outline" size="sm" aria-label={`${a.moveUp} : ${categoryLabel(c.translations, locale, c.slug).name}`}>↑ {a.moveUp}</Button></form>}
                            {i < own.length - 1 && <form method="post"><input type="hidden" name="intent" value="categoryMove" /><input type="hidden" name="categoryId" value={c.id} /><input type="hidden" name="direction" value="down" /><Button type="submit" variant="outline" size="sm" aria-label={`${a.moveDown} : ${categoryLabel(c.translations, locale, c.slug).name}`}>↓ {a.moveDown}</Button></form>}
                            {own.length > 1 && (
                              <form method="post" class="flex flex-wrap items-end gap-2">
                                <input type="hidden" name="intent" value="categoryDelete" /><input type="hidden" name="categoryId" value={c.id} />
                                <div class="grid gap-1">
                                  <Label for={`move-to-${c.id}`}>{a.moveTopicsTo}</Label>
                                  <NativeSelect id={`move-to-${c.id}`} name="moveTo" class="w-full">
                                    {own.filter((o) => o.id !== c.id).map((o) => <NativeSelectOption value={o.id}>{categoryLabel(o.translations, locale, o.slug).name}</NativeSelectOption>)}
                                  </NativeSelect>
                                </div>
                                <Button type="submit" variant="error" size="sm" aria-label={`${a.delete} : ${categoryLabel(c.translations, locale, c.slug).name}`}>{a.delete}</Button>
                              </form>
                            )}
                          </div>
                        </li>
                      ))}
                    </ol>
                    <details>
                      <summary class="inline-flex h-9 cursor-pointer items-center text-sm underline underline-offset-4">{a.addCategory}</summary>
                      <form method="post" class="mt-3 grid gap-3" data-testid={`add-category-${forum.slug}`}>
                        <input type="hidden" name="intent" value="categoryCreate" /><input type="hidden" name="forumId" value={forum.id} />
                        <div class="grid gap-1">
                          <Label for={`new-cat-slug-${forum.id}`}>{a.categorySlug}</Label>
                          <Input id={`new-cat-slug-${forum.id}`} name="slug" maxlength="80" />
                        </div>
                        <ForumLocaleFields t={t} uiLocale={locale} idPrefix={`new-cat-${forum.id}`} requiredLocale="fr" />
                        <Button type="submit" variant="primary" size="sm" class="w-fit">{a.addCategory}</Button>
                      </form>
                    </details>
                  </>
                )}
              </article>
            );
          })}
          {canCreate && (
            <details class="rounded-xl border p-4">
              <summary class="inline-flex h-11 cursor-pointer items-center font-medium">{a.createForum}</summary>
              <form method="post" class="mt-3 grid gap-3 sm:grid-cols-2" data-testid="create-forum">
                <input type="hidden" name="intent" value="forumCreate" />
                <div class="grid gap-1">
                  <Label for="create-forum-title">{a.forumTitle}</Label>
                  <Input id="create-forum-title" name="title" required minlength="2" maxlength="160" />
                </div>
                <div class="grid gap-1">
                  <Label for="create-forum-slug">{a.forumSlug}</Label>
                  <Input id="create-forum-slug" name="slug" maxlength="80" />
                </div>
                <div class="grid gap-1 sm:col-span-2">
                  <Label for="create-forum-description">{a.forumDescription}</Label>
                  <Input id="create-forum-description" name="description" maxlength="500" />
                </div>
                <div class="grid gap-1">
                  <Label for="create-forum-visibility">{a.visibility}</Label>
                  <NativeSelect id="create-forum-visibility" name="visibility" class="w-full">
                    {FORUM_VISIBILITIES.map((v) => <NativeSelectOption value={v}>{a.visibilities[v]}</NativeSelectOption>)}
                  </NativeSelect>
                </div>
                <Button type="submit" variant="primary" size="sm" class="w-fit self-end">{a.create}</Button>
              </form>
            </details>
          )}
        </section>

        {canConfigure && (
          <section aria-labelledby="tags-title" class="grid gap-3">
            <h2 id="tags-title" class="font-heading text-xl font-semibold">{a.tagsTitle}</h2>
            {tags.length === 0 ? <p>{a.noTags}</p> : (
              <ul class="flex flex-wrap gap-2" data-testid="tags">
                {tags.map((tag) => (
                  <li class="flex items-center gap-2 rounded-md border px-3 py-1">
                    <span>#{tag.label}</span>
                    <form method="post"><input type="hidden" name="intent" value="tagDelete" /><input type="hidden" name="tagId" value={tag.id} /><Button type="submit" variant="ghost" size="sm" aria-label={`${a.delete} : ${tag.label}`}>{a.delete}</Button></form>
                  </li>
                ))}
              </ul>
            )}
            <form method="post" class="flex flex-wrap items-end gap-2">
              <input type="hidden" name="intent" value="tagCreate" />
              <div class="grid gap-1">
                <Label for="new-tag-label">{a.tagLabel}</Label>
                <Input id="new-tag-label" name="label" required minlength="2" maxlength="40" />
              </div>
              <Button type="submit" variant="outline" size="sm">{a.addTag}</Button>
            </form>
          </section>
        )}
      </div>
    </AdminResourceShell>
  </AuthLayout>
</BaseLayout>
