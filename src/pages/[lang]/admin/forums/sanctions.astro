---
/**
 * Sanctions automatiques des forums du site administré : politique (seuils, fenêtre, durées —
 * `configure`) et liste des sanctions avec levée motivée (`moderate`). Aucune information sur
 * les signalements ni les signaleurs n'est affichée : seul le nombre de contenus masqués.
 */
import { Effect } from "effect";
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import AdminResourceShell from "@organisms/AdminResourceShell.astro";
import Badge from "@atoms/badge/Badge.astro";
import Button from "@atoms/button/Button.astro";
import { Checkbox } from "@atoms/checkbox";
import { Input } from "@atoms/input";
import { Label } from "@atoms/label";
import { Table, TableBody, TableCaption, TableCell, TableHead, TableHeader, TableRow } from "@atoms/table";
import ForumNotice from "@/components/forums/ForumNotice.astro";
import { requireAuth } from "@/lib/auth-guards";
import { getAdminSite } from "@/lib/platform/admin";
import { runApp } from "@/lib/effect/http";
import { getDrizzle } from "@database/drizzle";
import { forumsCan } from "@/modules/forums/services/access";
import { listSanctions, sanctionPolicy } from "@/modules/forums/services/sanctions";
import { NOTE_MAX, NOTE_MIN } from "@/modules/forums/domain/rules";
import { moderationQueueUrl } from "@/modules/forums/web/moderation-link";
import { handleAdminForumsForm } from "@/modules/forums/web/admin-forms";
import { getForumsTranslations } from "@/modules/forums/i18n";

export const prerender = false;
const auth = await requireAuth(Astro);
if ("redirect" in auth) return auth.redirect;
const { user, locale, authT } = auth;
const site = await getAdminSite(Astro);
const scope = { organizationId: site.organizationId ?? null, siteId: site.id };
const [canConfigure, canModerate] = await Promise.all([
  Effect.runPromise(forumsCan(user, scope, ["configure"])),
  Effect.runPromise(forumsCan(user, scope, ["moderate"])),
]);
if (!canConfigure && !canModerate) return Astro.redirect(`/${locale}/auth/${authT.routes["dashboard"]}`);
const self = `/${locale}/admin/forums/sanctions`;

if (Astro.request.method === "POST") {
  const result = await handleAdminForumsForm(await Astro.request.formData(), { viewer: user, sessionId: Astro.locals.session?.id ?? null, site: { id: site.id, organizationId: scope.organizationId } });
  return Astro.redirect(result.ok ? `${self}?notice=${result.notice}` : `${self}?error=${result.error}`, 303);
}

const policy = await runApp(sanctionPolicy(getDrizzle(), site.id));
const sanctions = canModerate ? await runApp(listSanctions(site.id)) : [];
const queueUrl = canModerate ? await runApp(moderationQueueUrl(locale, scope.organizationId)) : null;
const t = getForumsTranslations(locale);
const a = t.admin;
const fmt = new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeStyle: "short" });
---
<BaseLayout title={`${a.sanctionsTitle} — ${site.name}`} description={a.sanctionsIntro}>
  <AuthLayout title={a.sanctionsTitle}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="forums" />
    <AdminResourceShell title={a.sanctionsTitle} description={a.sanctionsIntro}>
      <Fragment slot="actions">
        <Button href={`/${locale}/admin/forums`} variant="outline" size="sm">{a.forums}</Button>
        {queueUrl && <Button href={queueUrl} variant="outline" size="sm">{a.openQueue}</Button>}
      </Fragment>
      <div class="grid gap-8 p-4 sm:p-6" data-testid="admin-forum-sanctions">
        <ForumNotice t={t} url={Astro.url} />

        <section aria-labelledby="policy-title" class="grid gap-3">
          <h2 id="policy-title" class="font-heading text-xl font-semibold">{a.sanctionsTitle}</h2>
          <form method="post" class="grid gap-3 sm:grid-cols-3" data-testid="policy-form">
            <input type="hidden" name="intent" value="policySet" />
            <div class="sm:col-span-3">
              <Checkbox id="policy-enabled" name="enabled" label={a.policyEnabled} checked={policy.enabled} disabled={!canConfigure} />
            </div>
            <div class="grid gap-1">
              <Label for="window-days">{a.windowDays}</Label>
              <Input type="number" id="window-days" name="windowDays" min="1" max="365" value={policy.windowDays} required disabled={!canConfigure} />
            </div>
            <div class="grid gap-1">
              <Label for="mute-threshold">{a.muteThreshold}</Label>
              <Input type="number" id="mute-threshold" name="muteThreshold" min="1" max="100" value={policy.muteThreshold} required disabled={!canConfigure} />
            </div>
            <div class="grid gap-1">
              <Label for="mute-hours">{a.muteHours}</Label>
              <Input type="number" id="mute-hours" name="muteHours" min="1" max="720" value={policy.muteHours} required disabled={!canConfigure} />
            </div>
            <div class="grid gap-1">
              <Label for="suspend-threshold">{a.suspendThreshold}</Label>
              <Input type="number" id="suspend-threshold" name="suspendThreshold" min="2" max="200" value={policy.suspendThreshold} required disabled={!canConfigure} />
            </div>
            <div class="grid gap-1">
              <Label for="suspend-days">{a.suspendDays}</Label>
              <Input type="number" id="suspend-days" name="suspendDays" min="1" max="365" value={policy.suspendDays} required disabled={!canConfigure} />
            </div>
            {canConfigure && <Button type="submit" variant="primary" size="sm" class="w-fit self-end">{a.save}</Button>}
          </form>
        </section>

        {canModerate && (
          <section aria-labelledby="sanctions-title" class="grid gap-3">
            <h2 id="sanctions-title" class="font-heading text-xl font-semibold">{a.sanctionsList}</h2>
            {sanctions.length === 0 ? <p data-testid="no-sanctions">{a.noSanctions}</p> : (
              <div class="overflow-x-auto">
                <Table data-testid="sanctions">
                  <TableCaption class="sr-only">{a.sanctionsList}</TableCaption>
                  <TableHeader>
                    <TableRow>
                      <TableHead>{a.user}</TableHead>
                      <TableHead>{a.kinds.mute} / {a.kinds.suspension}</TableHead>
                      <TableHead>{a.triggerCount}</TableHead>
                      <TableHead>{a.until}</TableHead>
                      <TableHead>{a.status}</TableHead>
                      <TableHead>{a.revoke}</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {sanctions.map((s) => (
                      <TableRow data-sanction={s.id}>
                        <TableCell>{s.userName ?? s.userId}</TableCell>
                        <TableCell>
                          <span class="inline-flex flex-wrap items-center gap-1">
                            <Badge variant="outline" size="sm">{a.kinds[s.kind]}</Badge>
                            <Badge variant={s.automatic ? "secondary" : "outline"} size="sm">{s.automatic ? a.automatic : a.manual}</Badge>
                          </span>
                        </TableCell>
                        <TableCell>{s.triggerCount}</TableCell>
                        <TableCell><time datetime={s.endsAt.toISOString()}>{fmt.format(s.endsAt)}</time></TableCell>
                        <TableCell>
                          <Badge variant={s.active ? "warning" : "secondary"} size="sm">{s.active ? a.active : a.inactive}</Badge>
                          {s.revokeNote ? <p class="mt-1 text-muted-foreground">{s.revokeNote}</p> : null}
                        </TableCell>
                        <TableCell>
                          {s.active && (
                            <form method="post" class="flex flex-wrap items-end gap-2">
                              <input type="hidden" name="intent" value="sanctionRevoke" /><input type="hidden" name="sanctionId" value={s.id} />
                              <div class="grid gap-1">
                                <Label for={`revoke-note-${s.id}`}>{a.revokeNote}</Label>
                                <Input id={`revoke-note-${s.id}`} name="note" required minlength={NOTE_MIN} maxlength={NOTE_MAX} />
                              </div>
                              <Button type="submit" variant="outline" size="sm" data-testid="revoke">{a.revoke}</Button>
                            </form>
                          )}
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </div>
            )}
          </section>
        )}
      </div>
    </AdminResourceShell>
  </AuthLayout>
</BaseLayout>
