---
/** Back-office plateforme : fiche d'une commande du Shop (transitions, liens facture / expédition). */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { requirePermission } from "@lib/auth-guards";
import OrderAdminDetail from "@/components/shop/admin/orders/OrderAdminDetail.astro";
import { orderAdminDetail } from "@/modules/shop/admin/orders";
import { getOrdersAdminTranslations } from "@/modules/shop/i18n/orders-admin";

export const prerender = false;
const result = await requirePermission(Astro, { shop: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getOrdersAdminTranslations(locale);
const view = await orderAdminDetail(Astro);
if (view instanceof Response) return view;
if (!view) return new Response(null, { status: 404 });
Astro.response.headers.set("cache-control", "private, no-store");
const heading = `${t.title} — ${view.order.number}`;
---
<BaseLayout title={heading} description={t.title}>
  <AuthLayout title={heading}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="orders" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <h1 class="text-2xl font-semibold" data-testid="order-admin-heading">{heading}</h1>
      <OrderAdminDetail locale={locale} baseUrl={`/${locale}/admin/orders`} {...view} />
    </main>
  </AuthLayout>
</BaseLayout>
