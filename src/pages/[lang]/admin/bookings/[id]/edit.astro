---
/** Back-office plateforme : modification d'une réservation (Demandée / Confirmée uniquement ; créneau revérifié). */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { requirePermission } from "@lib/auth-guards";
import BookingForm from "@/components/bookings/admin/BookingForm.astro";
import { bookingLabel } from "@/modules/bookings/domain/booking";
import { isEditable } from "@/modules/bookings/domain/workflow";
import { getBookingsTranslations } from "@/modules/bookings/i18n";
import { loadBooking, loadBookingResources } from "@/modules/bookings/loaders";

export const prerender = false;
const result = await requirePermission(Astro, { bookings: ["update"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getBookingsTranslations(locale);
const baseAdminUrl = `/${locale}/admin/bookings`;
const booking = await loadBooking(Astro.params.id ?? "", null);
if (!booking) return new Response(null, { status: 404 });
if (!isEditable(booking.status)) return Astro.redirect(`${baseAdminUrl}/${booking.id}`);
const resources = await loadBookingResources(null);
---
<BaseLayout title={t.admin.edit} description={t.meta.description}>
  <AuthLayout title={t.admin.edit}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="bookings" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <h1 class="text-2xl font-semibold">{t.admin.edit} — {bookingLabel(booking)}</h1>
      <BookingForm locale={locale} viewBaseUrl={baseAdminUrl} resources={resources} booking={booking} />
    </main>
  </AuthLayout>
</BaseLayout>
