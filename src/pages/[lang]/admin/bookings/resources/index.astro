---
/** Back-office plateforme : ressources réservables (liste + création). */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { requirePermission } from "@lib/auth-guards";
import ResourceForm from "@/components/bookings/admin/ResourceForm.astro";
import { getBookingsTranslations } from "@/modules/bookings/i18n";
import { loadBookingResources } from "@/modules/bookings/loaders";
import { hasBookingsPermission } from "@/modules/bookings/permissions";

export const prerender = false;
const result = await requirePermission(Astro, { bookings: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getBookingsTranslations(locale);
const baseAdminUrl = `/${locale}/admin/bookings`;
const [resources, canCreate] = await Promise.all([loadBookingResources(null), hasBookingsPermission(Astro, ["create"])]);
---
<BaseLayout title={t.admin.resources} description={t.meta.description}>
  <AuthLayout title={t.admin.resources}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="bookings" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-semibold">{t.admin.resources}</h1>
        <a class="inline-flex min-h-11 items-center px-3 underline" href={baseAdminUrl}>{t.admin.back}</a>
      </div>
      {resources.length === 0 ? <p class="text-sm text-muted-foreground">{t.admin.noResources}</p> : (
        <ul class="flex flex-col gap-2" aria-label={t.admin.resources} data-testid="bookings-resource-list">
          {resources.map((r) => (
            <li class="flex flex-wrap items-center justify-between gap-3 border px-4 py-3">
              <span><span class="font-mono font-medium">{r.code}</span> — {r.name} · {t.kinds[r.kind]} · {t.fields.capacity} {r.capacity} · {r.timezone}{!r.active && <span class="text-muted-foreground"> · {t.fields.active} : {t.admin.none}</span>}</span>
              <a class="inline-flex min-h-11 items-center px-3 underline" href={`${baseAdminUrl}/resources/${r.id}`} aria-label={`${t.admin.edit} — ${r.code}`}>{t.admin.edit}</a>
            </li>
          ))}
        </ul>
      )}
      {canCreate && (
        <section class="flex flex-col gap-3" aria-labelledby="bk-new-res"><h2 id="bk-new-res" class="text-lg font-semibold">{t.admin.newResource}</h2><ResourceForm locale={locale} /></section>
      )}
    </main>
  </AuthLayout>
</BaseLayout>
