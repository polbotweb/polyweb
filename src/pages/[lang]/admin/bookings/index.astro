---
/** Back-office plateforme : réservations — liste (facettes, vues, actions groupées) et accès aux ressources. */
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import AdminPagination from "@molecules/AdminPagination/AdminPagination.astro";
import { Effect } from "effect";
import { requirePermission } from "@lib/auth-guards";
import { loadSavedViews } from "@/lib/admin/saved-views";
import { bulkBarOperations } from "@/core/bulk/ui";
import BookingAdminList from "@/components/bookings/admin/BookingAdminList.astro";
import { bookingAdminResource } from "@/modules/bookings/admin/resource";
import { getBookingsTranslations } from "@/modules/bookings/i18n";
import { bookingsAdminFiltersFromUrl, bookingsAdminList, loadBookingsAdminFacets } from "@/modules/bookings/loaders";
import { hasBookingsPermission } from "@/modules/bookings/permissions";

export const prerender = false;
const result = await requirePermission(Astro, { bookings: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getBookingsTranslations(locale);
const baseAdminUrl = `/${locale}/admin/bookings`;
const [list, facets, savedViews, canCreate, canUpdate] = await Promise.all([
  Effect.runPromise(bookingsAdminList(null, Astro.url.searchParams)),
  loadBookingsAdminFacets(null, bookingsAdminFiltersFromUrl(Astro.url.searchParams)).catch(() => ({})),
  Astro.locals.user ? loadSavedViews(Astro.locals.user.id, "bookings-booking", null) : Promise.resolve([]),
  hasBookingsPermission(Astro, ["create"]),
  hasBookingsPermission(Astro, ["update"]),
]);
const bulkOperations = bulkBarOperations(bookingAdminResource.list?.bulkActions, t.admin.bulk, { cancel: canUpdate, noShow: canUpdate, complete: canUpdate });
---
<BaseLayout title={t.admin.title} description={t.meta.description}>
  <AuthLayout title={t.admin.title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="bookings" />
    <main class="mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-2xl font-semibold">{t.admin.title}</h1>
        <nav class="flex flex-wrap gap-2" aria-label={t.admin.title}>
          <a class="inline-flex min-h-11 items-center rounded-md border px-4" href={`${baseAdminUrl}/resources`}>{t.admin.resources}</a>
          {canCreate && <a class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-primary-foreground" href={`${baseAdminUrl}/new`} data-testid="bookings-new">{t.admin.newBooking}</a>}
        </nav>
      </div>
      <h2 class="text-lg font-semibold">{t.admin.bookings}</h2>
      <BookingAdminList items={list.items} locale={locale} viewBaseUrl={baseAdminUrl} bulkOperations={bulkOperations} baseUrl={Astro.url} facets={facets} savedViews={savedViews} />
      {list.totalPages > 1 && <AdminPagination currentPage={list.page} totalPages={list.totalPages} baseUrl={Astro.url} />}
    </main>
  </AuthLayout>
</BaseLayout>
