---
import BaseLayout from "@layouts/BaseLayout.astro";
import CoursesCard from "@/components/courses/CoursesCard.astro";
import { loadPublishedCourses } from "@/modules/courses/loaders";
import { getCoursesTranslations } from "@/modules/courses/i18n";
import { toLocale } from "@i18n/utils";

export const prerender = false;
const locale = toLocale(Astro.params.lang);
const t = getCoursesTranslations(locale);
// Contenu global uniquement (organizationId null) : pas de repli tenant implicite.
const items = await loadPublishedCourses(locale, null);
const meta = (f: (typeof items)[number]) =>
  [f.level ? t.levels[f.level] : null, f.durationMinutes !== null ? `${f.durationMinutes} ${t.labels.minutes}` : null].filter(Boolean).join(" · ") || null;
---
<BaseLayout title={t.meta.title} description={t.meta.description}>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="mb-8 font-heading text-3xl font-bold">{t.labels.courses}</h1>
    {items.length === 0 ? (
      <p class="text-muted-foreground">{t.labels.noResults}</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((f) => (
          <CoursesCard id={f.id} title={f.title} href={`/${locale}/courses/${f.slug}`} excerpt={f.excerpt} meta={meta(f)} />
        ))}
      </div>
    )}
  </main>
</BaseLayout>
