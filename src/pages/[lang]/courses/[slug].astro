---
import BaseLayout from "@layouts/BaseLayout.astro";
import CoursesDetail from "@/components/courses/CoursesDetail.astro";
import { loadCourseLessons, loadPublishedCourseBySlug } from "@/modules/courses/loaders";
import { getCoursesTranslations } from "@/modules/courses/i18n";
import { toLocale } from "@i18n/utils";

export const prerender = false;
const locale = toLocale(Astro.params.lang);
const slug = Astro.params.slug;
if (!slug) return Astro.redirect(`/${locale}/courses`);

const item = await loadPublishedCourseBySlug(locale, slug, null);
if (!item) return Astro.redirect(`/${locale}/courses`);

const lessons = await loadCourseLessons(item.id, locale);
const t = getCoursesTranslations(locale);
const formatPrice = (minor: number, currency: string) => new Intl.NumberFormat(locale, { style: "currency", currency }).format(minor / 100);
const canonical = new URL(`/${locale}/courses/${item.slug}`, Astro.url.origin).href;
---
<BaseLayout title={`${item.metaTitle ?? item.title} — ${t.meta.title}`} description={item.metaDescription ?? item.excerpt ?? t.meta.description} canonical={canonical}>
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <CoursesDetail item={item} lessons={lessons} t={t} formatPrice={formatPrice} backHref={`/${locale}/courses`} />
  </main>
</BaseLayout>
