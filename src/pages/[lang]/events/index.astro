---
import BaseLayout from "@layouts/BaseLayout.astro";
import EventsCard from "@/components/events/EventsCard.astro";
import { loadPublishedEvents } from "@/modules/events/loaders";
import { getEventsTranslations } from "@/modules/events/i18n";
import { toLocale } from "@i18n/utils";

export const prerender = false;
const locale = toLocale(Astro.params.lang);
const t = getEventsTranslations(locale);
// Contenu global uniquement (organizationId null) : pas de repli tenant implicite.
const items = await loadPublishedEvents(locale, null);
const fmt = new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeStyle: "short" });
---
<BaseLayout title={t.meta.title} description={t.meta.description}>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="mb-8 font-heading text-3xl font-bold">{t.labels.events}</h1>
    {items.length === 0 ? (
      <p class="text-muted-foreground">{t.labels.noResults}</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((e) => (
          <EventsCard id={e.id} title={e.title} href={`/${locale}/events/${e.slug}`} excerpt={e.excerpt} when={e.startsAt ? fmt.format(e.startsAt) : null} venue={e.venueName} />
        ))}
      </div>
    )}
  </main>
</BaseLayout>
