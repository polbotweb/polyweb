---
import BaseLayout from "@layouts/BaseLayout.astro";
import ShopCard from "@/components/shop/ShopCard.astro";
import { loadPublishedProducts } from "@/modules/shop/loaders";
import { getShopTranslations } from "@/modules/shop/i18n";
import { toLocale } from "@i18n/utils";

export const prerender = false;
const locale = toLocale(Astro.params.lang);
const t = getShopTranslations(locale);
// Contenu global uniquement (organizationId null) : pas de repli tenant implicite.
const items = await loadPublishedProducts(locale, null);
---
<BaseLayout title={t.meta.title} description={t.meta.description}>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="mb-8 font-heading text-3xl font-bold">{t.labels.shop}</h1>
    {items.length === 0 ? (
      <p class="text-muted-foreground">{t.labels.noResults}</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((p) => (
          <ShopCard id={p.id} title={p.title} href={`/${locale}/shop/${p.slug}`} excerpt={p.excerpt} />
        ))}
      </div>
    )}
  </main>
</BaseLayout>
