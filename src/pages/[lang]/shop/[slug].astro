---
import BaseLayout from "@layouts/BaseLayout.astro";
import ShopDetail from "@/components/shop/ShopDetail.astro";
import { loadProductOptions, loadProductVariants, loadPublishedProductBySlug } from "@/modules/shop/loaders";
import { getShopTranslations } from "@/modules/shop/i18n";
import { toLocale } from "@i18n/utils";

export const prerender = false;
const locale = toLocale(Astro.params.lang);
const slug = Astro.params.slug;
if (!slug) return Astro.redirect(`/${locale}/shop`);

const item = await loadPublishedProductBySlug(locale, slug, null);
if (!item) return Astro.redirect(`/${locale}/shop`);

const [options, variants] = await Promise.all([loadProductOptions(item.id, locale), loadProductVariants(item.id)]);
const t = getShopTranslations(locale);
const formatPrice = (minor: number, currency: string) => new Intl.NumberFormat(locale, { style: "currency", currency }).format(minor / 100);
const canonical = new URL(`/${locale}/shop/${item.slug}`, Astro.url.origin).href;
---
<BaseLayout title={`${item.metaTitle ?? item.title} — ${t.meta.title}`} description={item.metaDescription ?? item.excerpt ?? t.meta.description} canonical={canonical}>
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <ShopDetail item={item} options={options} variants={variants} t={t} formatPrice={formatPrice} backHref={`/${locale}/shop`} />
  </main>
</BaseLayout>
