---
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import OrgSidebar from "@organisms/OrgSidebar/OrgSidebar.astro";
import { requireAuth } from "@lib/auth-guards";
import { fetchOrgData, getUserOrgRole } from "@/lib/auth-data";
import { hasServicePermission, resolveServiceTenant } from "@/modules/services/permissions";
import { getServiceAdminData, getServiceAdminStats, getServiceAdminTaxonomy, getServiceModerationQueue } from "@/modules/services/admin";
import { getServiceCategories, getServiceProviders, getServiceTags } from "@/modules/services/loaders";
import { getServiceTranslations } from "@/modules/services/i18n";
import ServicesAdminPage from "@/components/services/ServicesAdminPage.astro";
import { Effect } from "effect";
import { getServiceAdminFacets } from "@/modules/services/admin/loader";
import { loadSavedViews } from "@/lib/admin/saved-views";
import { LOCALES } from "@i18n/config";
export const prerender = false;
const result = await requireAuth(Astro);
if ("redirect" in result) return result.redirect;
const { user, locale, authT } = result;
const orgSlug = Astro.params.slug;
if (!orgSlug) return Astro.redirect(`/${locale}/auth/${authT.routes.dashboard}`);
const orgData = await fetchOrgData(Astro.request.headers, orgSlug);
if (!orgData) return Astro.redirect(`/${locale}/auth/${authT.routes.dashboard}`);
const { org, members } = orgData;
const orgRole = getUserOrgRole(members, user.id);
const tenant = resolveServiceTenant({ organizationId: org.id });
const canRead = await hasServicePermission(Astro, tenant, { service: ["read"] });
if (!canRead) return Astro.redirect(`/${locale}/organizations/${orgSlug}/members`);
const t = getServiceTranslations(locale);
const p = Astro.url.searchParams;
const page = Math.max(1, Number(p.get("page") ?? "1") || 1);
const featured = p.has("featured") ? p.get("featured") === "true" : undefined;
const mobile = p.has("mobile") ? p.get("mobile") === "true" : undefined;
const status: "DRAFT" | "PUBLISHED" | "ARCHIVED" | "DELETED" | undefined = (() => { const value = p.get("status"); return value === "DRAFT" || value === "PUBLISHED" || value === "ARCHIVED" || value === "DELETED" ? value : undefined; })();
const sortBy: "createdAt" | "updatedAt" | "publishedAt" | "title" | "priceMinor" | "ratingAverage100" | "viewCount" | undefined = (() => { const value = p.get("sortBy"); return value === "createdAt" || value === "updatedAt" || value === "publishedAt" || value === "title" || value === "priceMinor" || value === "ratingAverage100" || value === "viewCount" ? value : undefined; })();
const sortOrder: "asc" | "desc" | undefined = p.get("sortOrder") === "asc" ? "asc" : p.get("sortOrder") === "desc" ? "desc" : undefined;
const filterInput = { page, limit: 20, search: p.get("search") || undefined, status, categoryId: p.get("categoryId") || undefined, tagId: p.get("tagId") || undefined, providerId: p.get("providerId") || undefined, featured, mobile, locale: p.get("locale") || undefined, sortBy, sortOrder };
const [data, stats, categoryOptions, tagOptions, providerOptions, taxonomy, moderation] = await Promise.all([getServiceAdminData(org.id, locale, filterInput), getServiceAdminStats(org.id), getServiceCategories(locale, org.id), getServiceTags(locale, org.id), getServiceProviders(org.id), getServiceAdminTaxonomy(org.id, locale), getServiceModerationQueue(org.id)]);
// core/filters : facettes (chacune sans son propre filtre) + vues enregistrées de l'utilisateur.
const [facets, savedViews] = await Promise.all([Effect.runPromise(getServiceAdminFacets(org.id, locale, filterInput)).catch(() => ({})), Astro.locals.user ? loadSavedViews(Astro.locals.user.id, "service", org.id) : Promise.resolve([])]);
const [canCreate, canUpdate, canDelete, canPublish, canModerate, canCategoryCreate, canCategoryUpdate, canCategoryDelete, canTagCreate, canTagUpdate, canTagDelete] = await Promise.all([
  hasServicePermission(Astro, tenant, { service: ["create"] }), hasServicePermission(Astro, tenant, { service: ["update"] }), hasServicePermission(Astro, tenant, { service: ["delete"] }), hasServicePermission(Astro, tenant, { service: ["publish"] }), hasServicePermission(Astro, tenant, { service: ["moderate"] }), hasServicePermission(Astro, tenant, { serviceCategory: ["create"] }), hasServicePermission(Astro, tenant, { serviceCategory: ["update"] }), hasServicePermission(Astro, tenant, { serviceCategory: ["delete"] }), hasServicePermission(Astro, tenant, { serviceTag: ["create"] }), hasServicePermission(Astro, tenant, { serviceTag: ["update"] }), hasServicePermission(Astro, tenant, { serviceTag: ["delete"] }),
]);
const canManageTaxonomy = canCategoryCreate && canCategoryUpdate && canCategoryDelete && canTagCreate && canTagUpdate && canTagDelete;
---
<BaseLayout title={`${t.admin.title} — ${org.name}`} description={t.meta.description}>
  <AuthLayout title={org.name}>
    <OrgSidebar slot="sidebar" t={authT} locale={locale} org={org} orgRole={orgRole} activeItem="services" />
    <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <ServicesAdminPage facets={facets} savedViews={savedViews} locale={locale} title={`${t.admin.title} — ${org.name}`} items={data.items} meta={{ page: data.page, totalPages: data.totalPages }} stats={stats} filters={filterInput} baseAdminUrl={`/${locale}/${org.slug}/admin/services`} organizationId={org.id} canCreate={canCreate} canUpdate={canUpdate} canPublish={canPublish} canDelete={canDelete} canModerate={canModerate} canManageTaxonomy={canManageTaxonomy} categoryOptions={categoryOptions} tagOptions={tagOptions} providerOptions={providerOptions} localeOptions={LOCALES} taxonomy={taxonomy} moderation={moderation} />
    </main>
  </AuthLayout>
</BaseLayout>
