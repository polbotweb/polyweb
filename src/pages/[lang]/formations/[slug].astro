---
import BaseLayout from "@layouts/BaseLayout.astro";
import FormationsDetail from "@/components/formations/FormationsDetail.astro";
import { loadPublishedFormationBySlug } from "@/modules/formations/loaders";
import { getFormationsTranslations } from "@/modules/formations/i18n";
import { toLocale } from "@i18n/utils";

export const prerender = false;
const locale = toLocale(Astro.params.lang);
const slug = Astro.params.slug;
if (!slug) return Astro.redirect(`/${locale}/formations`);

const item = await loadPublishedFormationBySlug(locale, slug, null);
if (!item) return Astro.redirect(`/${locale}/formations`);

const t = getFormationsTranslations(locale);
const formatPrice = (minor: number, currency: string) => new Intl.NumberFormat(locale, { style: "currency", currency }).format(minor / 100);
const canonical = new URL(`/${locale}/formations/${item.slug}`, Astro.url.origin).href;
---
<BaseLayout title={`${item.metaTitle ?? item.title} — ${t.meta.title}`} description={item.metaDescription ?? item.excerpt ?? t.meta.description} canonical={canonical}>
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <FormationsDetail item={item} t={t} formatPrice={formatPrice} backHref={`/${locale}/formations`} />
  </main>
</BaseLayout>
